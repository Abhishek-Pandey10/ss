import LoggedInUserId from "@salesforce/user/Id";

export default class R4c_AG_ViewSummary extends NavigationMixin(LightningElement) {
  ECC_LINEITEM_STATUS_VALUE = ['Discrepant'];
  @api recordId;
  @api isPortal = false;
  @api isCreatePortal = false; //TWC4621-963 - Furqan - to define this is during create
  @api caseType; //Added By furqan to save case recordType
  @api caseRecord; //case record
  @api salesarea; // sales area record
  @api posearchlineitemdata; //for storing line items data
  @track stockallownacerecords; //for storing stock allowance records
  @api centrlblockcasestatus; //for storing central block status
  @track showToastBar = false; //boolean variable to display the soft block toast message

  @api isECCLineItemEdit = false;
  isPriceMasked = false;//boolean to represent if user is price masked
  showDetails = false;
  portalView;
  disableCaseSubmission = false; //added this varaiable to control the submit button
  disableCaseEdit = false;
  caseStatus; // for storing case status
  crrRecord; // customer return req record
  genericMessages; //generic messages fetched from custom settings
  isLoading = false;
  custompage = true;
  showviewsummary = false;
  errormessage;
  salesarearec;
  userpermsname = [];
  casestatusvalues;
  netCreditValue = 0; //Approval process for technical intake
  totalReturnQty = 0; //Approval process for technical intake
  ApprovalMatrixRecord; //Approval process for technical intake
  labels = r4c_CustomLabels.labels; //Assigning custom labels to variable
  showEdit;
  // showcancelbutton = false;
  totalCreditPriceValue = 0;
  isUserPriceMasked = false;
  @api isCustomerPriceMasked = false;
  portalUserDetails;
  URLlangParam;
  ILMApprovalRecords = [];//TWC4621-4740 -- Added as part of ILM Approver selection
  get totalCreditPriceValueDisplay() {
    if (this.isPriceMasked && (this.isPortal == "true" || this.isPortal == true)) {
      return r4c_CustomLabels.PRICE_MASK_STRING;
    }
    return parseFloat(this.totalCreditPriceValue)?.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  }
  //Exchange Remedy - Technical Intake
  get isTechnicalExchange() {
    return this?.caseType?.isTechnicalExchange() || this?.caseType?.remedy == 'Return Only';
  }

  // Start -- TWC4621-55 -- 29-08-2022 --- Manohar -- Wire Method to Get the custom settings
  @wire(getGenericMessages)
  async wiredGenericMessages({ data }) {
    if (data) {
      this.genericMessages = data;
      await this.prepareRecordDetailsForPortal();
      this.getCrrData();
      this.ECC_LINEITEM_STATUS_VALUE = data?.ECC_LineItemStatus_IntialValue?.split(',') || ['Discrepant'];
    }
  }
  // End -- TWC4621-55 -- 29-08-2022 --- Manohar -- Wire Method to Get the custom settings

  // Start  -- TWC4621-794 -- 18-12-2022 --- Karthik --- the fetch case details and display in the Portal.
  connectedCallback() {
    const URLparams = new URLSearchParams(window.location.search);
    this.URLlangParam = URLparams.get('language');
    this.prepareRecordDetailsForPortal();
  }
  async prepareLineItemDetailsForPortal() {
    await getLineItemData({ caseId: this.recordId })
      .then((result) => {

        if (result != undefined && result.length != 0) {
          this.posearchlineitemdata = result.map((item, index) => {
            if (item.MM && item.Data) {
              item = {
                ...item,
                ...{
                  selected: false,
                  productStatus: true,
                  returnPO: item.returnPO,
                  debitReferenceNumber: item.debitReferenceNumber,
                  boxCondition: item.boxCondition,
                  lineitemStatus: item.lineitemStatus,
                  shipmentstatus: item.lineitemStatus,
                  display: true,
                  index: index + 1
                }
              }; //TWC4621-899 -- Manohar -- added display & lineitemStatus fields as part of caseEdit -- 17th jan
            } else {
              item = {
                ...item,
                ...{
                  selected: false,
                  productStatus: false,
                  returnPO: item.returnPO,
                  debitReferenceNumber: item.debitReferenceNumber,
                  boxCondition: item.boxCondition,
                  lineitemStatus: item.lineitemStatus,
                  shipmentstatus: item.lineitemStatus,
                  display: true,
                  index: index + 1
                }
              }; //TWC4621-899 -- Manohar -- added display & lineitemStatus fields as part of caseEdit -- 17th jan
            }
            return item;
          });
        }
      });
  }
  async prepareRecordDetailsForPortal() {
    if (this.isPortal == "true" || this.isPortal == true) {
      if (!this.caseRecord?.Status) {
        let obj = {
          Id: this.recordId
        };
        this.caseRecord = obj;

        this.isLoading = true;
        //Furqan - Adding query to get logged in user details
        this.portalUserDetails = await getCurrentPortalUserContact();
        this.isUserPriceMasked = this.portalUserDetails.Contact.R4C_Customer_Price_Mask__c;

        await this.prepareLineItemDetailsForPortal();
        await getcase({ caseId: this.recordId, isPortal: this.isPortal })
          .then((result) => {
            this.caseRecord = result.caseRec;
          if (result?.errorMessage) {
            throw new Error(result.errorMessage);
          }

            //as part of bug fix - hiding edit button - Samuel - 7-4-23
            if (this.caseRecord?.Status === this.genericMessages?.Case_Status_Open_Unsubmitted) {
              //Syed- Edit for only user who is owner of it 
              if (LoggedInUserId == this.caseRecord.OwnerId &&
                (this.caseRecord.RecordType.DeveloperName == 'Technical_Intake' ||
                  this.caseRecord.RecordType.DeveloperName == 'Quality_Intake' ||
                  this.caseRecord.RecordType.DeveloperName == 'R4C_Stock_Rotation')
              ) {
                this.showEdit = true;
              }

            }
            this.requestdetails =
              this.caseRecord.Customer_Return_Requests__r[0];
            this.requestdetails?.Sales_Issue_Account_Name__r?.Name;
            this.requestdetails?.Sales_Issue_Contact_Name__r?.Name;
            this.caseRecord.nprCertDate = true;
            // TWC4621-1548 - Syed - adding cod field check
            this.caseRecord.nprCertAccepted = this.requestdetails?.Sales_Issue_Crt_Of_Destruction_Ind__c || false;
            this.caseRecord.accountName = this.requestdetails?.Sales_Issue_CaseNumber__r?.Account.Name
            this.caseRecord.contactName = this.requestdetails?.Sales_Issue_CaseNumber__r?.Contact.Name
            this.caseRecord.ownerName = this.caseRecord?.Owner?.Name;
            this.salesarea = result.selectedSalesArea;
            if (!this?.caseType?.remedy) {
              this.caseType = setCaseTypeDetails(this.requestdetails.Sales_Issue_Remedy_Type__r.Name, this.requestdetails.Sales_Issue_Service_Type__r?.Name, this.requestdetails?.Sales_Issue_Return_Reason__r?.Name);
            }

          })
          .catch((error) => {
            console.error(error)
          })
          .finally(() => {
            this.showDetails = true;
            this.portalView = true;
            this.isLoading = false;
          });
      }
    }
  }

  // End  -- TWC4621-794 -- 18-12-2022 --- Karthik --- the fetch case details and display in the Portal.

  // Start -- TWC4621-55 -- 29-08-2022 --- Manohar --- to get the CRR object record
  getCrrData() {
    getCrrDetails({ recId: this.caseRecord?.Id || this.recordId })
      .then((result) => {
        this.crrRecord = result.requestRec;

        if (this.isECCLineItemEdit) {
          let eccLineItems = result.requestRec?.Customer_Return_Request_Lines__r?.filter(i => +i.Name >= 5000 && this.ECC_LINEITEM_STATUS_VALUE.includes(i.Sales_Issue_Line_Item_Status__c)) || [];
          result.requestRec.Customer_Return_Request_Lines__r = eccLineItems;

          this.getApprovalMatrix();
        }

        this.totalCreditPriceValue = this.crrRecord?.Total_Credit_Value__c;
        // this.isPriceMasked = this.isUserPriceMasked || this.crrRecord?.Sales_Issue_SoldTo_Customer__r?.Customer_Sold_To_Price_Mask__c ||
        //   this.crrRecord?.Sales_Issue_ShipTo_Customer__r?.Customer_Ship_To_Price_Mask__c;
        if (this.isPortal == "true" || this.isPortal == true) {
          this.isPriceMasked = this.isUserPriceMasked || this.isCustomerPriceMasked;
        }

        if (this.crrRecord.Sales_Issue_Service_Type__c && this.crrRecord?.Sales_Issue_Service_Type__r?.Name === "Stock Rotation") {
          this.getStockAllowance();
        }
        else if (this.crrRecord.Sales_Issue_Service_Type__c && this.crrRecord.Sales_Issue_Remedy_Type__r?.Name === "Exchange" &&
          this.crrRecord?.Sales_Issue_Service_Type__r?.Name === "Technical") {
          this.handleExchangeViewSummary(); // TWC4621- -- 12-06-2023 --- Samuel --- Setting case status
        }
        else if (this.crrRecord.Sales_Issue_Service_Type__c && !(this.crrRecord.Sales_Issue_Remedy_Type__r?.Name === "Exchange") &&
          (this.crrRecord?.Sales_Issue_Service_Type__r?.Name === this.genericMessages?.Service_Type_Technical_Intake || this.crrRecord?.Sales_Issue_Service_Type__r?.Name === this.genericMessages?.Quality)) {
          this.getApprovalMatrix(); // TWC4621-901 -- 19-01-2023 --- Sandeep --- Fetching approval records and setting case status
        }
        else if (this.crrRecord.Sales_Issue_Service_Type__c && this.crrRecord?.Sales_Issue_Service_Type__r?.Name === this.genericMessages.Exception || this.crrRecord?.Sales_Issue_Service_Type__r?.Name === "Admin") {
          this.getApprovalMatrix(); // Exception Intake -------- Tushar Garg
        }
        else if (this.crrRecord.Sales_Issue_Service_Type__c && this.crrRecord?.Sales_Issue_Service_Type__r?.Name === this.genericMessages.Miscellaneous) { //Manohar -- TWC4621-2011 
          this.showviewsummary = true;
          this.caseStatus = this.genericMessages.Case_Status_RMA_Authorized;
          if (this.centrlblockcasestatus === this.genericMessages.Pending_Agent_Action) { //If there are any soft blocks in Header level , Disabling case Submit button in Agent UI
            this.disableCaseSubmission = true;
            this.caseStatus = this.genericMessages.Case_Status_Submitted_Pending_Action;
            this.showToastMessage("info", this.genericMessages?.View_Summary_Soft_Block);
            return;
          }
        }
        if (this.genericMessages.RMA_Authorization_Form_Status.includes(this.crrRecord.Sales_Issue_CaseNumber__r.Status)) {
          this.showAuthorizationFormDownload = true;
        }
        /*
        if (this.crrRecord.Sales_Issue_CaseNumber__r.Status == this.genericMessages.Case_Status_RMA_Authorized) {
          this.showAuthorizationFormDownload = true;
        }*/
      }
      )
      .catch(error => {
      })
  }
  // End -- TWC4621-55 -- 29-08-2022 --- Manohar --- to get the CRR object record

  // Start -- Start -- TWC4621-794 -- 18-12-2022 --- Karthik --- to get the sales Area --- to display in View  Page
  getSalesArea(cmfids, salesOrg, distiChannel) {
    getCaseRecord({
      cmfIds: cmfids,
      salesOrg: salesOrg,
      distiChanel: distiChannel
    }).then((result) => {
      if (result?.errorMessage) {
            throw new Error(result.errorMessage);
          }
      if (result.selectedSalesAreaList.length > 0 && this.requestdetails !== undefined) {
        result.selectedSalesAreaList.map((key) => {
          if (
            key.Customer_Disti_Channel__c ===
            this.requestdetails.Sales_Issue_Distribution_Channel__c &&
            key.Customer_Sales_Organization__c ==
            this.requestdetails.Sales_Issue_Sales_Organization__c
          ) {
            this.salesarea = key;
          }
        });
      }
    }) .catch((error) => {
                this.showToast(this.labels.Error_Title, this.labels.Something_went_wrong_please_contact_super_user, "error");
                return;
              });
  }
  // End -- Start -- TWC4621-794 -- 18-12-2022 --- Karthik --- to get the sales Area --- to display in View  Page

  // Start --- TWC4621-55 -- 29-08-2022 --- Manohar --- preparing stockallowance records which is used on submit button functinality
  getStockAllowance() {
    this.showviewsummary = true;
    let creditpriceblock = false;
    let stockallownaceids = [];
    let stockallownacemap = new Map();
    if (this.posearchlineitemdata !== undefined) {
      this.posearchlineitemdata.map((key) => {
        if (key.stockRotationId !== undefined && key.stockRotationId != null) {
          let lineItemCreditValue = 0.0;
          if (key?.creditPrice && parseFloat(key.creditPrice) !== 0) {
            lineItemCreditValue = parseFloat(key.creditPrice); //key.creditPrice;
          } else {
            creditpriceblock = true;
          }
          if (!stockallownaceids.includes(key.stockRotationId)) {
            let closedProductAllowance;
            let openProductAllowance;
            let closedProductAllowanceConsumed;
            let openProductAllowanceConsumed;
            stockallownaceids.push(key.stockRotationId);
            if (key.boxCondition === this.genericMessages.Box_Closed_Factory_Sealed) {
              closedProductAllowance = key.stockRotationAllowance - lineItemCreditValue;
              openProductAllowance = key.productAllowance;
              if (key.stockRotationRec.Sales_Issue_Consumed_SR_Allowance_Amt__c !== undefined) {
                closedProductAllowanceConsumed = parseFloat(key.stockRotationRec.Sales_Issue_Consumed_SR_Allowance_Amt__c) + parseFloat(lineItemCreditValue);
              } else {
                closedProductAllowanceConsumed = lineItemCreditValue;
              }
              if (key.stockRotationRec.Sales_Issue_Consumed_OP_Allowance_Amt__c !== undefined) {
                openProductAllowanceConsumed = key.stockRotationRec.Sales_Issue_Consumed_OP_Allowance_Amt__c;
              } else {
                openProductAllowanceConsumed = 0;
              }
            } else if (key.boxCondition === this.genericMessages.Outer_Box_Open_Product_Unsealed) {
              openProductAllowance = key.productAllowance - lineItemCreditValue;
              closedProductAllowance = key.stockRotationAllowance;
              if (key.stockRotationRec.Sales_Issue_Consumed_OP_Allowance_Amt__c !== undefined) {
                openProductAllowanceConsumed = parseFloat(key.stockRotationRec.Sales_Issue_Consumed_OP_Allowance_Amt__c) + parseFloat(lineItemCreditValue);
              } else {
                openProductAllowanceConsumed = lineItemCreditValue;
              }
              if (key.stockRotationRec.Sales_Issue_Consumed_SR_Allowance_Amt__c !== undefined) {
                closedProductAllowanceConsumed = key.stockRotationRec.Sales_Issue_Consumed_SR_Allowance_Amt__c;
              } else {
                closedProductAllowanceConsumed = 0;
              }
            }
            let stockallowancrecord = {
              Id: key.stockRotationId,
              Sales_Issue_Stock_Rotation_Allowance_Amt__c: closedProductAllowance,
              Sales_Issue_SR_Open_Prd_Allowance_Amt__c: openProductAllowance,
              Sales_Issue_Consumed_OP_Allowance_Amt__c: openProductAllowanceConsumed,
              Sales_Issue_Consumed_SR_Allowance_Amt__c: closedProductAllowanceConsumed
            };
            stockallownacemap.set(key.stockRotationId, stockallowancrecord);
          } else {
            let tempstockallowancrecord = stockallownacemap.get(key.stockRotationId);

            if (key.boxCondition === this.genericMessages.Box_Closed_Factory_Sealed) {
              tempstockallowancrecord.Sales_Issue_Stock_Rotation_Allowance_Amt__c = parseFloat(tempstockallowancrecord.Sales_Issue_Stock_Rotation_Allowance_Amt__c) - parseFloat(lineItemCreditValue);
              tempstockallowancrecord.Sales_Issue_Consumed_SR_Allowance_Amt__c = parseFloat(tempstockallowancrecord.Sales_Issue_Consumed_SR_Allowance_Amt__c) + parseFloat(lineItemCreditValue);
            } else if (key.boxCondition === this.genericMessages.Outer_Box_Open_Product_Unsealed) {
              tempstockallowancrecord.Sales_Issue_SR_Open_Prd_Allowance_Amt__c = parseFloat(tempstockallowancrecord.Sales_Issue_SR_Open_Prd_Allowance_Amt__c) - parseFloat(lineItemCreditValue);
              tempstockallowancrecord.Sales_Issue_Consumed_OP_Allowance_Amt__c = parseFloat(tempstockallowancrecord.Sales_Issue_Consumed_OP_Allowance_Amt__c) + parseFloat(lineItemCreditValue);
            }

            stockallownacemap.delete(key.stockRotationId);
            stockallownacemap.set(key.stockRotationId, tempstockallowancrecord);
          }
        }
        return key;
      });
      // TWC4621-975 - Furqan - 08-02-2023 - Soft block not for portal
      if ((creditpriceblock === true || this.centrlblockcasestatus === this.genericMessages.Pending_Agent_Action) && this.isPortal == false) {
        /*Start -- TWC4621-560---Manohar---22-11-2022--if there is any soft blocks disabling submit button on the Agent UI */
        this.disableCaseSubmission = true;
        this.showToastMessage("info", this.genericMessages?.View_Summary_Soft_Block);
        /*End -- TWC4621-560---Manohar---22-11-2022--if there is any soft blocks disabling submit button on the Agent UI */
        this.caseStatus = this.genericMessages.Case_Status_Submitted_Pending_Action;
      } else if ((creditpriceblock === true || this.centrlblockcasestatus === this.genericMessages.Pending_Agent_Action || this?.crrRecord?.Sales_Issue_Header_Error_Messages__c || !this.crrRecord?.Sales_Issue_Location_Plant__r?.Name)
        && (this.isPortal == true || this.isPortal == "true")) {
        this.caseStatus = this.genericMessages.Case_Status_Submitted_Pending_Action;
        let errorMessage = creditpriceblock ? this.genericMessages.CreditPriceZero_ErrorMsg : '';
        errorMessage += this?.crrRecord?.Sales_Issue_Location_Plant__c ? '' : this.genericMessages.NoReturnLocation_ErrorMsg;
        this.crrRecord.Sales_Issue_Header_Error_Messages__c = this?.crrRecord?.Sales_Issue_Header_Error_Messages__c ? this.crrRecord.Sales_Issue_Header_Error_Messages__c + errorMessage
          : errorMessage;
      } else if (creditpriceblock === false && this.centrlblockcasestatus !== this.genericMessages.Pending_Agent_Action) {
        this.caseStatus = this.genericMessages.Case_Status_RMA_Authorized;
      }
    } else {
      //--TWC4621-560---Manohar---22-11-2022--added else condition to disable the submit button on the Agent UI if there is No Line items
      this.disableCaseSubmission = true;
    }
    if (stockallownacemap.size > 0) {
      let stockAllownaceRecordList = [];
      stockallownacemap.forEach(function (value) {
        stockAllownaceRecordList.push(value);
      });
      this.stockallownacerecords = stockAllownaceRecordList;
    }
  }
  // End --- TWC4621-55 -- 29-08-2022 --- Manohar --- preparing stockallowance records which is used on submit button functinality

  // Start --- TWC4621-901 -- 19-01-2023 --- Sandeep --- Fetching approval records and setting case status
  getApprovalMatrix() {

    let creditpriceblock = false;
    this.showviewsummary = true;
    let isULTSoftStop = false;
    this.netCreditValue = 0;
    const price_Zero_RetrnResn = this.genericMessages?.Retrn_Resn_for_ZERO_Price?.split(';') || [];//TWC4621-4742,TWC4621-4789 -- Zero Dollar Return Reasons
    const price_Zero_OR_Orginal_RetrnResn = this.genericMessages?.Retrn_Resn_for_ZERO_OR_Original_Price?.split(';') || [];
    this.posearchlineitemdata?.forEach((key) => {
      if (key?.creditPrice && parseFloat(key.creditPrice) !== 0) {
        this.netCreditValue = this.netCreditValue + parseFloat(key.creditPrice); //key.creditPrice;
      }
      // Unexpected line failed lines- Bug Fix Samuel
      else if (key?.selected == true && (!this.genericMessages?.R4C_CaseEdit_LineItemStatusRestrict.includes(key?.lineitemStatus)) && key?.lineitemStatus !== this.genericMessages.Cancelled_Status_Value &&
        (!price_Zero_RetrnResn?.includes(this.crrRecord?.Sales_Issue_Return_Reason__r?.Name)) && (!price_Zero_OR_Orginal_RetrnResn?.includes(this.crrRecord?.Sales_Issue_Return_Reason__r?.Name))) { //TWC4621-4742,TWC4621-4789 -- added price_Zero_RetrnResn & price_Zero_OR_Orginal_RetrnResn condition to allow zero dollar
        creditpriceblock = true;
      }
      if (this.isQualityFAC && key?.isULTSoftStop) {
        isULTSoftStop = true;
      }
      if (key?.returnQuantity && parseFloat(key.returnQuantity) !== 0) {
        this.totalReturnQty = this.totalReturnQty + parseFloat(key.returnQuantity);
      }
    });
    if ((isULTSoftStop === true || creditpriceblock === true || this.centrlblockcasestatus === this.genericMessages.Pending_Agent_Action) && this.isPortal == false) {
      this.disableCaseSubmission = true;//Disabling case Submit button in Agent UI incase of blocks
      this.showToastMessage("info", isULTSoftStop ? this.genericMessages?.ULT_Soft_Block_Msg : this.genericMessages?.View_Summary_Soft_Block);
      return;
    }
    if ((this.isPortal == true || this.isPortal == "true") && (!this.caseType.isExceptionService() || !this.caseType.isAdminService())) {//Checking blocks and approval logic for portal :setting case status and approval record
      this.caseStatus = this.genericMessages.Case_Status_Submitted_Pending_Action; //Setting Pending action by default
      //For Credit - Failed_End_Customer, Failed_Customer_Factory_site
      if (this.crrRecord.Sales_Issue_Remedy_Type__r.Name === this.genericMessages.Credit && (this.crrRecord.Sales_Issue_Return_Reason__r.Name === this.genericMessages.Failed_Customer_Factory_site || this.crrRecord.Sales_Issue_Return_Reason__r.Name === this.genericMessages.Failed_End_Customer)) {
        this.caseStatus = this.netCreditValue < +this.genericMessages.EmailApproval_NetCreditValue ? this.genericMessages.Case_Status_RMA_Authorized : this.genericMessages.Pending_Approval;

      }
      if (this.crrRecord?.Sales_Issue_Service_Type__r?.Name === this.genericMessages?.Quality) {
        this.caseStatus = this.netCreditValue < +this.genericMessages.EmailApproval_NetCreditValue ? this.genericMessages.Case_Status_RMA_Authorized : this.genericMessages.Pending_Approval;

      }
      //Checking,setting status to pending action for Credit price = 0, Missing return location && SAP blocks for portal
      if (creditpriceblock === true || this.centrlblockcasestatus === this.genericMessages.Pending_Agent_Action || this?.crrRecord?.Sales_Issue_Header_Error_Messages__c || (!this.crrRecord?.Sales_Issue_Location_Plant__r?.Name && this.crrRecord?.Sales_Issue_Remedy_Type__r?.Name !== this.genericMessages.Credit_NPR)) {
        this.caseStatus = this.genericMessages.Case_Status_Submitted_Pending_Action;
        let errorMessage = creditpriceblock ? this.genericMessages.CreditPriceZero_ErrorMsg : '';
        errorMessage += (this?.crrRecord?.Sales_Issue_Location_Plant__c || this.crrRecord?.Sales_Issue_Remedy_Type__r?.Name === this.genericMessages.Credit_NPR) ? '' : this.genericMessages.NoReturnLocation_ErrorMsg; // Bug fix to not show return location error msg for portal NPR credit
        this.crrRecord.Sales_Issue_Header_Error_Messages__c = this?.crrRecord?.Sales_Issue_Header_Error_Messages__c ? this.crrRecord.Sales_Issue_Header_Error_Messages__c + errorMessage
          : errorMessage;
      } else if (this.caseStatus == this.genericMessages.Case_Status_Submitted_Pending_Action) {
        this.crrRecord.Sales_Issue_Header_Error_Messages__c = this?.crrRecord?.Sales_Issue_Header_Error_Messages__c ? this.crrRecord.Sales_Issue_Header_Error_Messages__c + this.genericMessages.R4C_Review_And_Submit
          : this.genericMessages.R4C_Review_And_Submit;
      }
    }
    else {//Approval logic for Agent UI :setting case status for approval record
      if (price_Zero_OR_Orginal_RetrnResn?.includes(this.crrRecord?.Sales_Issue_Return_Reason__r?.Name) && this.netCreditValue == 0) { //TWC4621-4742 TWC4621-4789 -- If Net Credit value is zero , set the status as RMA
        this.caseStatus = this.genericMessages.Case_Status_RMA_Authorized;
      }
      else if ((this.caseType.isExceptionService() || (this.caseType.isAdminService() && !price_Zero_RetrnResn?.includes(this.crrRecord?.Sales_Issue_Return_Reason__r?.Name))) && !(this.crrRecord?.Sales_Issue_CaseNumber__r?.Origin == 'ILM')) {
        this.caseStatus = this.genericMessages.Pending_Approval;
      } else if ((this.caseType.isAdminService() && price_Zero_RetrnResn?.includes(this.crrRecord?.Sales_Issue_Return_Reason__r?.Name)) || this.crrRecord?.Sales_Issue_CaseNumber__r?.Origin == 'ILM') {
        this.caseStatus = this.genericMessages.Case_Status_RMA_Authorized;
      } else {//Technical and Quality
        this.caseStatus = this.netCreditValue < +this.genericMessages.EmailApproval_NetCreditValue ? this.genericMessages.Case_Status_RMA_Authorized : this.genericMessages.Pending_Approval;

      }
    }

    if (this.caseStatus == this.genericMessages.Pending_Approval && this.crrRecord) {//Getting approval records if case status is pending approval for portal and Agent UI

      let isILM = false;
      let OPID;
      let approverLevel = '';
      if ((this.caseType.isExceptionService() && this.crrRecord?.Sales_Issue_Remedy_Type__r?.Name == 'Credit' && this.crrRecord?.Sales_Issue_Return_Reason__r?.Name == 'Exception Return') || this.caseType.isAdminService()) {
        // CAll ILM Matrix Once confirm using same getApprovalMatrix Code for Now
        isILM = true; // commented as of now bcoz we dont have the records of ILM based
        OPID = this.posearchlineitemdata.filter((item) => item.selected)
          .map((item) => item?.Data?.ICS_WR_Operation_Business_Unit_Code__c)
      }
      let approvalRequestWrapper = {
        requestDetail: this.crrRecord,
        netCreditPrice: Math.round((this.netCreditValue + Number.EPSILON) * 100) / 100,
        isILM: isILM,
        OPID: OPID?.length > 0 ? OPID[0] : '',
      }

      if (!this.caseType.isExceptionRepair()) {
        this.isLoading = true;
        getApprovalMatrixRecords({ approvalRequest: approvalRequestWrapper })
          .then(result => {
            // if(!isILM){ //Filter using BR SOQL Where conditions first for normal approval
            //   result = result.filter(record => 
            //     //AND conditions
