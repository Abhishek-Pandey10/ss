    * @return boolean 
    * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
    */
    @AuraEnabled 
    public static Boolean returnLoginUserInfo() {
        final Map<String, String> session = new Map<String,String>();
        if (!Test.isRunningTest()) {
          session.putAll(Auth.SessionManagement.getCurrentSession());
        }else{
            session.put('LoginHistoryId', null);
            session.put('LoginType', 'unknown');
            session.put('LoginType', null);
            session.put('SourceIp', '::');
        }
        Boolean isEmualtedUser = false;
        final Boolean emulatedUserFlag = R4C_Generic_Configurations__c.getValues('Block_Save_for_EmulatedUser').value__c == 'true' ? true : false; // for testing purpose(Log in to Experience user) added the flag
        isEmualtedUser = emulatedUserFlag && session.get('LoginHistoryId') == null && session.get('LoginType') == 'Unknown' && session.get('LogoutUrl') == null  && session.get('SourceIp') == '::';       
        return isEmualtedUser;
    }
    

