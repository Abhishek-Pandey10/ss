      else if (r4eCaseList === undefined || r4eCaseList?.length === 0) {
        this.collectionShippingDetails.Sales_Issue_Header_Error_Messages__c = this.genericMessages.Invalid_R4E_CaseNo_ErrMsg;
        this.showToast(this.genericMessages?.Error_Title, this.genericMessages?.Invalid_R4E_CaseNo_ErrMsg, 'error', 'dismissable');
