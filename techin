            // }
            if (result.length > 0) {
              //console.log('approval records-- ',result);
              //Group by priority number
              let groupByPriorityNumber = result.reduce(function (storage, item) {
                var group = item.Sales_Issue_Rule_Prioritization_Number__c;
                storage[group] = storage[group] || [];
                storage[group].push(item);
                return storage;
              }, {})

              let emailList = [];
              if (!isILM) { // Approval matrix table
                // console.log('group records-- ',groupByPriorityNumber);
                let records = Object.values(groupByPriorityNumber)[0]
                  .sort((a, b) => a.Sales_Issue_Exceeds_Quantity__c - b.Sales_Issue_Exceeds_Quantity__c);
                this.ApprovalMatrixRecord = records[0];
                records.forEach(matrix => {
                  if (matrix.Sales_Issue_Exceeds_Quantity__c <= this.totalReturnQty) {
                    this.ApprovalMatrixRecord = matrix;
                  }
                });
                emailList.push(this.ApprovalMatrixRecord?.Sales_Issue_Approver_Email__c);
