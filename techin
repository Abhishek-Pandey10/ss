  // Start --- User Story Number TWC4621-211 --- Tushar --- This method is used for handling Save for later ,Here we are calling Apex class and create the case record with draft status
  async saveForLaterHandler() {
    this.isLoading = true;
    let gtsResponse;
    if (!(this.caseType.isTechnicalExchange())) { //this.caseType.isTechnicalNPRCredit() || Samuel NPR CHanges
      gtsResponse = await doEmbargoCheck(this, false, this.collectionShippingDetails);//await this.EmbargoHandler(); //TWC4621-909 -- Manohar -- 12-01-2023 -- Embargo check
    }

    if ((gtsResponse && gtsResponse?.isEmbargo === false) || (this.caseType.isTechnicalNPRCredit() || this.caseType.isTechnicalExchange())) {
      // saving a case if there is no blocked countries
      this.isLoading = false;
      LightningConfirm.open({
        message: this.labels.Save_for_later_error_message,
        variant: this.labels.Success_Message,
        label: this.labels.Confirm_Message
        // setting theme would have no effect
      }).then((data) => {
        if (data) {
          let emptyList = []; // We are not saving the line items,So this variable store empty array
          this.headerDataHandler();
          // Deleting Sales area and Sold CMF from collection and shipping details array
          delete this.collectionShippingDetails["sales_Area__c"];
          delete this.collectionShippingDetails["Sold_CMF__C"];
          //delete this.collectionShippingDetails["contactDetails"];
          let recordTypeName = this.genericMessages.Case_Stock_Rotation;
          if (this.caseType.isTechnicalService()) {
            recordTypeName = this.genericMessages.Technical_Intake_label;
          } else if (this.caseType.isQualityService()) {
            recordTypeName = this.genericMessages.Quality_Intake; //Manohar---Quality Intake --TWC4621-1359
          } else if (this.caseType.isAdminService()) {
            recordTypeName = this.genericMessages.Admin_Intake;
          } else if (this.caseType.isExceptionService()) {
            recordTypeName = this.genericMessages.Exception_Intake;
          } else if (this.caseType.isMiscellaneousService()) {
            recordTypeName = this.genericMessages.Miscellaneous_Intake; //to be updated in generic messages
          }

          let returnReqDetailsWrapper = {
            customerReturnRequest: this.collectionShippingDetails, //collection and shipping details
            customerReturnRequestLineWrapperList: emptyList, //selected line item details
            caserec: this.caserec, //case record
            casemode: this.casemode, // case mode edit or create
            caserecTypeName: recordTypeName,
            isPortal: this.isPortal, // BUG Fix - Portal
            contactDetails: this.contactdetails,  //Accellor -- 20/03/2023 -- TWC4621-1123 && TWC4621-1124 added contact details to the wrapper and those values are used in case insertion -- as part of data model changes 
            remedyDetails: this.collectionShippingDetails?.remedyDetails,
             // Manohar
            comments: this.collectionShippingDetails?.comments
          };
          if (!this.contactdetails?.Id) {//added for Internal Customer flow
            delete returnReqDetailsWrapper["contactDetails"];
            delete returnReqDetailsWrapper.customerReturnRequest["contactDetails"];
          }
          this.isLoading = true;


          // Call saveForLater Apex class method
          console.log('253',JSON.stringify(returnReqDetailsWrapper))
          saveForLater({
            returnReqDetails: returnReqDetailsWrapper,
            caseStatus: this.genericMessages.Case_Status_Open_Unsubmitted
          })
            .then((result) => {
              this.isLoading = false;

              if (result.errorMessageOfDmlOperation) {
                    console.error('Apex Error:', result.errorMessageOfDmlOperation);
                    this.showToast(this.labels.Error_Title, this?.labels?.generic_error_msg, "error");
                    return;
                }

              if (this.isPortal == true || this.isPortal == "true") {
                this[NavigationMixin.Navigate]({
                  type: "standard__recordPage",
                  attributes: {
                    recordId: result.insertR4CCaseRes.Id,
                    objectApiName: "Case",
                    actionName: "view"
                  }
                });
                return;
              }
              let pagetab;
              let parenttab;
              this.invokeWorkspaceAPI("getFocusedTabInfo").then(
                (focusedTab) => {
                  if (focusedTab.isSubtab) {
                    pagetab = focusedTab.tabId;
                    parenttab = focusedTab.parentTabId;
                    this.invokeWorkspaceAPI("openSubtab", {
                      parentTabId: parenttab,
                      recordId: result.insertR4CCaseRes.Id,
                      focus: true
                    }).then((result) => {
                      this.invokeWorkspaceAPI("closeTab", {
                        tabId: pagetab
                      }).then((result) => {
                        this.invokeWorkspaceAPI("refreshTab", {
                          tabId: parenttab,
                          includeAllSubtabs: true
                        });
                      });
                    });
                  } else {
                    let tempFocustab = focusedTab.tabId;
                    this.invokeWorkspaceAPI("openTab", {
                      recordId: result.insertR4CCaseRes.Id,
                      focus: true
                    }).then((result) => {
                      this.invokeWorkspaceAPI("closeTab", {
                        tabId: tempFocustab
                      });
                    });
                  }
                }
              );
            })
            .catch((error) => {
              console.error("error", error);
              this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error"); //Added as part of Failure Handling - TWC4621-3040
              this.isLoading = false;
            });
        }
      });
    } else if (gtsResponse && gtsResponse?.isEmbargo === true) {
      // if there is any blocked countries showing toast event
      let embargoErrorMessage =
        gtsResponse?.embargoBlockedCountriesCount > 1
          ? StringFormatter.format(this?.labels?.Countries_are_in_Block, gtsResponse?.embargoBlockCountry.join(", "))
          : StringFormatter.format(this?.labels?.Country_is_in_Block, gtsResponse?.embargoBlockCountry[0]);
      this.showToast(this.labels.Error_Title, embargoErrorMessage, "error");
    }
    this.isLoading = false;
  }
