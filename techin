  getReasonForPending(pendingMatrixRecords) {
    let priceOverridenItems = this.crrRecord?.Customer_Return_Request_Lines__r.map(item => {
      let obj = {};
      obj.Id = item.Id;
      if (item.Reason_for_Price_Change__c && !this.genericMessages?.R4C_CaseEdit_LineItemStatusRestrict.includes(item?.Sales_Issue_Line_Item_Status__c)) {
        obj.Line_item_error_messages__c = 'Pending Reason: Price Overrriden';
      }

      let matrixRecord = pendingMatrixRecords.find(matrix => {
        return (
          ((!item?.Sales_Issue_Cst_Return_Receipt_Cnd__c && !matrix.Sales_Issue_Received_Condition__c) || (item?.Sales_Issue_Cst_Return_Receipt_Cnd__c == matrix?.Sales_Issue_Received_Condition__c) || !matrix?.Sales_Issue_Received_Condition__c) &&
          ((!item?.Sales_Issue_Item__r.Item_Product_Code__c && !matrix.Item_Product_Code__c) || (item?.Sales_Issue_Item__r.Item_Product_Code__c == matrix?.Item_Product_Code__c) || !matrix?.Item_Product_Code__c) &&
          ((!item?.Sales_Issue_Item__r.ICS_WR_Operation_Business_Unit_Code__c && !matrix.Sales_Issue_Operation_Business_Unit_Code__c) || (item?.Sales_Issue_Item__r.ICS_WR_Operation_Business_Unit_Code__c == matrix?.Sales_Issue_Operation_Business_Unit_Code__c) || !matrix?.Sales_Issue_Operation_Business_Unit_Code__c)
        )
      })
      if (matrixRecord) {
        let matchingCritera = [];
        if (matrixRecord.Sales_Issue_Customer_Sales_Organization__c) {
          matchingCritera.push('Sales Org');
        }
        if (matrixRecord.Sales_Issue_Service_Type__c) {
          matchingCritera.push('Service Type');
        }
        if (matrixRecord.Sales_Issue_Remedy_Type__c) {
          matchingCritera.push('Remedy Type');
        }
        if (matrixRecord.Sales_Issue_Customer_Return_Reason__c) {
          matchingCritera.push('Retrun Reason');
        }
        if (matrixRecord.Sales_Issue_Customer_CMF__c) {
          matchingCritera.push('CMF');
        }
        if (matrixRecord.Sales_Issue_Operation_Business_Unit_Code__c) {
          matchingCritera.push('Busines Unit Code');
        }
        if (matrixRecord.Customer_Disti_Channel__c) {
          matchingCritera.push('Disti Channel');
        }
        if (matrixRecord.Item_Product_Code__c) {
          matchingCritera.push('Prod Code');
        }
        if (matrixRecord.Sales_Issue_Return_Location_Plant__c) {
          matchingCritera.push('Plant');
        }
        if (matrixRecord.Sales_Issue_Received_Condition__c) {
          matchingCritera.push('Receipt Condition');
        }
        obj.Line_item_error_messages__c = 'Pending Reason: Pending Matrix Rule Number ' + matrixRecord.Sales_Issue_Rule_Prioritization_Number__c + ', Matching with following criteria ' + matchingCritera.join(',');

      }


      return obj;
    }).filter(i => i.Line_item_error_messages__c);

    return priceOverridenItems;
  }

  isPriceoverrideApproavlRequired() {
    //for admin intake we dont have 25k price override check for approval
    if (this.caseType.isAdminService()) return false;
    //for portal user apporval secltion is not needed
    if (this.isPortal == true || this.isPortal == 'true') return false;
    let status = false;
    if (this.crrRecord?.Customer_Return_Request_Lines__r?.length > 0) {
      let totalOveriddenPrice = this.crrRecord?.Customer_Return_Request_Lines__r.reduce((total, currentValue) => {
        if (currentValue?.Reason_for_Price_Change__c && !this.genericMessages?.R4C_CaseEdit_LineItemStatusRestrict.includes(currentValue?.Sales_Issue_Line_Item_Status__c) && currentValue?.Sales_Issue_Line_Item_Status__c != this.genericMessages.Cancelled_Status_Value) {
          total += currentValue?.Sales_Issue_Net_Credit_Value__c;
        }
        return total;
      }, 0)

      if (totalOveriddenPrice > 25000) {
        status = true;
      }
    }

    return status;
  }
