    /*───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
     * Date             Created By                          User-Story
     * 01-09-2022       Chaitanya
     * @description     fetch the non blocked CMF
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
     *@param AccounId
     *@return
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
     */
    
    public static List<Customer_CMF__c> getnonBlockedCMFs(List<String> accIds, List<String> conIds) {
        final List<String> bagIds = new List<String>();
        final List<Customer_CMF__c> cmfList = new List<Customer_CMF__c>();
        List<String> cmfIds = new List<String>();
        Map<Id,Customer_CMF__c> cmfmap = new Map<Id,Customer_CMF__c>();
        //Start - TWC777-2320 - 22/05/2024 - sunil hatangde - added toggle switch to get bagdata based on contactId or accountId based on custom metadata type value.
        List<Customer_Business_Account_Group__c> bagData = new List<Customer_Business_Account_Group__c>();
        if(ucdConfigMap.Size() > 0 && ucdConfigMap.get('ICS_UCD_R4C_Toggle_Switch').Value__c.equals('0')){
            bagData = R4C_ShippingDetailsUtil.getBagDataByAccId(accIds);
        }else{
            bagData = R4C_ShippingDetailsUtil.getBagDataByContactId(conIds);
        }
        //End - TWC777-2320 - 22/05/2024 - sunil hatangde - added toggle switch to get bagdata based on contactId or accountId based on custom metadata type value.
        for(Customer_Business_Account_Group__c bag: bagData) {
            bagIds.add(bag.Id);
        }
        bagCMFIds = bagIds;
        cmfIds =  R4C_ShippingDetailsUtil.getCMFIDs(bagIds);
        cmfmap = R4C_ShippingDetailsUtil.getPartnerCmfMap(cmfids,SOLDTO_CODE,null);//TWC4621-1123 -- fetching soldTo records from customer partner object -- as part of data model changes
        if(cmfMap.isEmpty()) {
            // fetching cmf's through account cmf associations (Non Bag CMF's)
            cmfids =  R4C_ShippingDetailsUtil.getAccountCMFIDs(accIds);
            cmfMap =  R4C_ShippingDetailsUtil.getPartnerCmfMap(cmfids,SOLDTO_CODE,null);//TWC4621-1123 -- fetching soldTo records from customer partner object -- as part of data model changes
        }
        if(!cmfMap.isEmpty()) {
            for(Customer_CMF__c cmf : cmfMap.values()) {
                final String valid = soldToCheck(cmf);
                if(valid != 'Orderblock' && valid != 'Billingblock' && valid != 'Deliveryblock') {
                    //SYED - TWC4621-1653 - BAG CMF Association
                    cmfList.add(cmf);//TWC4621-1123 && TWC4621-1124 -- Accellor -- 17/03/2023 -- replaced Customer_CMF_Id__c --> Name as part of data model changes
                }
            }
        }
        return cmfList;
    }
    
    
    /*───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
     * Date             Created By                          User-Story
     * 01-09-2022       Chaitanya
     * @description     check the blocks at request level
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
     *@param Customer_Sales_Issue_Request__c
     *@return error
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
     */
    public static List<String>  requestBlockCheck(Customer_Sales_Issue_Request__c req,String cmfid, String shipCmfID) { //added shipCmfID - Pravallika
        final List<String> blockers = new List<String>();
        if(req!=null) {
            try {
                blockers.addAll(complianceCheck(req));
                if(req.Sales_Issue_SoldTo_Customer__r != null) {
                    blockers.addAll(checkCMFBlocks(req.Sales_Issue_SoldTo_Customer__r,'Sold To'));
                }
                blockers.addAll(inactiveCheck(req));
                if(req.Sales_Issue_SoldTo_Customer__r != null && req.Sales_Issue_SoldTo_Customer__r.Customer_Active_Indicator__c == true) {
                    blockers.addAll(salesAreaBlockCheck(R4C_AG_EditCaseUtil.getsalesAreaByCMF(new List<String>{req.Sales_Issue_SoldTo_Customer__c}, req.Sales_Issue_Sales_Organization__c, req.Sales_Issue_Distribution_Channel__c),'Sold To',cmfid));
                }
                /*Pravallika - added shipTo CMF and ShipTo sales area delivery blick 99 hard stop*/
                if(req.Sales_Issue_ShipTo_Customer__r != null) {
                    blockers.addAll(checkCMFBlocks(req.Sales_Issue_ShipTo_Customer__r, 'Ship To'));
                }
                
                if(req.Sales_Issue_ShipTo_Customer__r != null && req.Sales_Issue_ShipTo_Customer__r.Customer_Active_Indicator__c == true) {
                    blockers.addAll(salesAreaBlockCheck(R4C_AG_EditCaseUtil.getsalesAreaByCMF(new List<String>{req.Sales_Issue_ShipTo_Customer__c}, req.Sales_Issue_Sales_Organization__c, req.Sales_Issue_Distribution_Channel__c),'Ship To',shipCmfID));
                }
                /*Pravallika - added payer CMF to send payer cmf to EditCaseUtil*/
                List<Customer_Sales_Area__c> soldToSalesAreas = new List<Customer_Sales_Area__c>();
                List<String> payerCmfIds = new List<String>();
                
                if (req.Sales_Issue_SoldTo_Customer__r != null &&
                req.Sales_Issue_SoldTo_Customer__r.Customer_Active_Indicator__c == true) {
                    
                    soldToSalesAreas = R4C_AG_EditCaseUtil.getsalesAreaByCMF(
                    new List<String>{req.Sales_Issue_SoldTo_Customer__c},
                    req.Sales_Issue_Sales_Organization__c,
                    req.Sales_Issue_Distribution_Channel__c
                        );
                    
                    if (!soldToSalesAreas.isEmpty()) {
                        payerCmfIds = getPayerData(cmfid, soldToSalesAreas[0]);
                    }
                    system.debug('@@@@@@@@ payerCmfIds'+payerCmfIds);
                    List<Customer_Sales_Area__c> payerSalesAreas = R4C_AG_EditCaseUtil.getsalesAreaByCMF(
                        payerCmfIds,
                    req.Sales_Issue_Sales_Organization__c,
                    req.Sales_Issue_Distribution_Channel__c
                        );
                    
                    system.debug('@@@@@@@@ payerSalesAreas'+payerSalesAreas);
                    
                    if(req.Sales_Issue_SoldTo_Customer__r != null && req.Sales_Issue_SoldTo_Customer__r.Customer_Active_Indicator__c == true) {
                        blockers.addAll(salesAreaBlockCheck(payerSalesAreas,'Payer',cmfid));
                    }
                    
                }
                
                /*Pravallika - added payer CMF to send payer cmf to EditCaseUtil*/
                
                
            }
            catch(Exception e) { //marking as false positive has already handling null check
                R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_AG_EditCaseController.requestBlockCheck',e.getMessage(),e,True);
            }
        }
        return blockers;
    }
    
    /*───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
     * Date             Created By                          User-Story
     * 19-09-2022       Chaitanya
     * @description     Order and Billing Block Check
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
     *@param  Customer_Sales_Issue_Request__c
     *@return throw an error
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
     */
    public static List<String> salesAreaBlockCheck(List<Customer_Sales_Area__c> csrList, String type,String cmfid) {
        final List<String> blockers = new List<String>();
        if(!csrList.isEmpty()) {
            final Customer_Sales_Area__c salesarea =  csrList[0];
            if(type == 'Sold To' && String.isNotBlank(salesarea.Customer_Order_Block__c) && GENERIC_MESSAGES.get(salesAreaOrderHardBlock).contains(salesarea?.Customer_Order_Block__c)) {
                blockers.add(GENERIC_MESSAGES.get('Order_Blocked_Hard_Stop'));
            }
            if(type == 'Sold To' && (String.isNotBlank(salesarea.Customer_Billling_Block__c) && GENERIC_MESSAGES.get(salesAreaBillingHardBlock).contains(salesarea.Customer_Billling_Block__c))) {
                blockers.add(GENERIC_MESSAGES.get('Billing_Blocked_Hard_Stop'));
            }
            if(type == 'Sold To' && (String.isNotBlank(salesarea.Customer_Delivery_Block__c) && GENERIC_MESSAGES.get(salesAreaDeliveryHardBlock).contains(salesarea.Customer_Delivery_Block__c))) {
                system.debug('### inside sold to delivery block'+salesAreaDeliveryHardBlock);
                blockers.add(GENERIC_MESSAGES.get('Sold_To_Delivery_Block'));
            }
            /*Pravallika - added ship to sales area delivery blick 99 hard stop*/
            if(type == 'Ship To' && String.isNotBlank(salesarea.Customer_Order_Block__c) && GENERIC_MESSAGES.get(shipTosalesAreaOrderHardBlock).contains(salesarea.Customer_Order_Block__c)) {
                system.debug('### inside ship to order block'+shipTosalesAreaOrderHardBlock);
                blockers.add(GENERIC_MESSAGES.get('ShipTo_SalesArea_Order_Block'));
            }
            if(type == 'Ship To' && String.isNotBlank(salesarea.Customer_Delivery_Block__c) && GENERIC_MESSAGES.get(shipTosalesAreaDeliveryHardBlock).contains(salesarea.Customer_Delivery_Block__c)) {
                system.debug('### inside ship to delivery block'+shipTosalesAreaDeliveryHardBlock);
                blockers.add(GENERIC_MESSAGES.get('ShipTo_SalesArea_Delivery_hardStop'));
            }
            /*Pravallika - added ship to sales area delivery blick 99 hard stop*/
            if(type == 'Sold To') {
                getPayerData(cmfid,salesarea);
