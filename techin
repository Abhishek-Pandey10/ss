                this.isLoading = false;
              } else { // ILM matrix table
                //console.log('523', Object.values(groupByPriorityNumber)[0]);
                this.ILMApprovalRecords = [];
                let ILMrecords = Object.values(groupByPriorityNumber)[0].filter((rec) => rec.Sales_Issue_Exceeds_Price__c != -1);
                const uniquePrices = new Set();
                for (const rec of ILMrecords) {
                  if (rec?.Sales_Issue_Exceeds_Price__c >= this.netCreditValue) {
                    uniquePrices.add(rec?.Sales_Issue_Exceeds_Price__c);
                  }
                }
                if (uniquePrices.size > 0) {
                  let minExceedsPrice = Infinity;
                  uniquePrices.forEach(price => {
                    if (price < minExceedsPrice) minExceedsPrice = price;
                  });
                  this.ILMApprovalRecords = ILMrecords.filter(rec => rec.Sales_Issue_Exceeds_Price__c === minExceedsPrice);
                } else {
                  // fallback to -1
                  this.ILMApprovalRecords = Object.values(groupByPriorityNumber)[0].filter(rec => rec?.Sales_Issue_Exceeds_Price__c === -1);

                }
                this.isLoading = false;
                console.log('566', JSON.stringify(this.ILMApprovalRecords))
                if (this.ILMApprovalRecords?.length == 0 && this.isPortal == false) {
                  this.disableCaseSubmission = true;
                  this.showToastMessage("info", this.genericMessages?.No_approval_records_found_ErrorMsg);
