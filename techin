  //E2C Edit Fix TWC4621-1122 - End
  /*To save the case */
  async saveCase(recordTypeName) {
    let updatedLineItems = [];
    this.headerDataHandler();
    let caseStatus = (this.caseData?.Status == 'Draft' && this?.caseData?.Origin === 'ILM') ? 'RMA Authorized' : this.caserec.Status;
    if (this?.caseType?.isTechnicalExchange() && this.isSubmitted && this.collectionShippingDetails?.External_Case_ID__c && this.isPortal == false) {
      caseStatus = this.genericMessages.Case_Status_Closed;
    }

    if (this.refs.headerLineItems) {
      let changedLineItems = await this.refs?.headerLineItems?.retriveChangedLineItems();
      if (changedLineItems?.some(item => item?.disableSave == true)) { // TWC4621-4742,TWC4621-4789 -- if there are any validtion errors at line level, throwing an error
        this.showToast('Validation Errors', 'Please fix errors before submitting', 'error');
        return;
      }
      // Start -- Price change validation & processing
      const priceChangedItems = changedLineItems?.filter(item => item?.isCreditPriceInput && (item?.creditpricevalue === 0 || item?.creditpricevalue === '0'));
      if (priceChangedItems?.length > 0) {
        const missingReason = priceChangedItems?.some(item => !item?.reasonForChange?.trim());
        if (missingReason) {
          this.showToast(this.labels.Error_Title, 'Please update reason for change on all items', 'error');
          return;
        }
        // price change records
        const distiChannel = this.returnshippingdetails?.sales_Area__c?.Customer_Disti_Channel__r?.Customer_Distribution_Channel_Code__c || '';
        const priceChangeRecords = priceChangedItems?.map(item => {
          return {
            lineItemRecId: item?.Id,
            creditPrice: item?.creditpricevalue,
            RFPriceChange: item?.reasonForChange,
            YMS2Price: item?.creditpricevalue
          };
        });
        if (priceChangeRecords?.length > 0) {
          updatedLineItems = priceChangeRecords;
          caseStatus = this.caserec.Status;
        }
      }
      //End -- Price change validation & processing
      //Start -- Manohar -- TWC4621-3197 -- check if atleast one line item status changed to Cancel --  Manual Line Closure - Cancelled line items validation & processing After RMA Case Edit
      const cancelledItems = changedLineItems?.filter(item => item?.isLineStatusInput && item?.linestatus === 'Cancelled');
      if (cancelledItems?.length > 0) {
        const missingCancelInfo = cancelledItems?.some(item => !item?.linecancelreason?.trim() || !item?.linecanceljustification?.trim());
        if (missingCancelInfo) {
          this.showToast(this.labels.Error_Title, 'Please update reason for change on all items', 'error');
          return;
        }

        const hasUpdatedLineItems = Array.isArray(updatedLineItems) && updatedLineItems?.length > 0;
        const updatedItemsMap = hasUpdatedLineItems
          ? new Map(updatedLineItems?.map(item => [item?.lineItemRecId, item]))
          : null;

        const cancelLineItemRecords = changedLineItems?.map(item => {
          const baseRecord = {
            lineItemRecId: item?.Id,
            lineitemStatus: item?.linestatus,
            lineCancelReason: item?.linecancelreason,
            lineCancelJustification: item?.linecanceljustification
          };

          if (item?.SRallowanceId) {
            baseRecord.SRallowanceMatrixId = item.SRallowanceId;
          }
          if (hasUpdatedLineItems) {
            const updatedItem = updatedItemsMap?.get(item?.Id);
            if (updatedItem) {
              return { ...baseRecord, ...updatedItem };
            }
          }

          return baseRecord;
        });
        if (cancelLineItemRecords?.length > 0) {
          this.isManualLineClosure = true;
          updatedLineItems = cancelLineItemRecords;
          caseStatus = this.caserec.Status;
        }
      }
      //End -- Manohar -- TWC4621-3197 -- check if atleast one line item status changed to Cancel --  Manual Line Closure - Cancelled line items validation & processing After RMA Case Edit
      // Handling ILM-specific cases and merging changed items
      if (this.refs.headerLineItems && this.caseData?.Status === 'Draft' &&
        this.caseData?.Origin === 'ILM' && this.collectionShippingDetails?.Sales_Issue_SoldTo_Customer__r?.Customer_CPN_Support__c) {
        const changedILMLineItems = await this.refs?.headerLineItems?.retriveChangedILMLineItems();
        if (!updatedLineItems || updatedLineItems?.length < 1) {
          updatedLineItems = changedILMLineItems;
        } else {
          updatedLineItems = changedILMLineItems?.map(originalItem => {
            const existingItem = updatedLineItems?.find(item => item?.lineItemRecId === originalItem?.lineItemRecId);
            return existingItem ? { ...originalItem, ...existingItem } : originalItem;
          });
        }
        // Check if any CPN is missing
        const isCPNMissing = updatedLineItems?.some(item => item?.customerItemNbr === '');
        caseStatus = isCPNMissing ? 'Draft' : 'RMA Authorized';
      } else if (this.refs?.headerLineItems && this.caseData?.Status === 'Draft' && this.caseData?.Origin === 'ILM') {
        const allLineItems = await this.refs.headerLineItems?.retriveAllLineItems();
        if (!updatedLineItems || updatedLineItems?.length < 1) {
          updatedLineItems = allLineItems?.map(item => ({ lineItemRecId: item?.Id }));
        } else {
          updatedLineItems = allLineItems?.map(originalItem => {
            const existingItem = updatedLineItems.find(item => item?.lineItemRecId === originalItem.Id);
            originalItem.unitprice = originalItem.unitprice?.replace('$', '').trim() || originalItem.unitprice;
            return existingItem ? { ...originalItem, ...existingItem } : { lineItemRecId: originalItem.Id };
          });
          caseStatus = 'RMA Authorized';
        }
      }
    }
    let returnReqDetailsWrapper = {
      customerReturnRequest: this.collectionShippingDetails, //collection and shipping details
      customerReturnRequestLineWrapperList: updatedLineItems, //selected line item details
      caserec: this.caserec, //case record
      casemode: this.casemode, // case mode edit or create
      caserecTypeName: recordTypeName,// case recordtype developer name
      isPortal: this.isPortal, // BUG Fix - Portal
      remedyDetails: this.collectionShippingDetails?.remedyDetails,
      externalCaseId: this.collectionShippingDetails?.External_Case_ID__c,
      r4eCaseNumber: this.collectionShippingDetails?.r4eCaseNumber,
      comments: this.collectionShippingDetails?.comments,
      isManualLineClosure: this.isManualLineClosure//TWC4621-3197 -- Manual Line item closure After RMA Case Edit
    };
    /*if (this.casemode == 'Edit') {
      returnReqDetailsWrapper.lineIds = [];
    }*/
    this.isLoading = true;
    console.log('940returnReqDetailsWrapper', JSON.stringify(returnReqDetailsWrapper))
    saveForLater({
      returnReqDetails: returnReqDetailsWrapper,
      caseStatus: caseStatus
    })
      .then((result) => {
        this.isLoading = false;
        if (this.isSubmitted) {
          this.showToast(this.labels.Success_Message, this.labels.Case_Submitted_Successfully, this.genericMessages.Success_Message);
        }

        //start
        if (this.isPortal == true || this.isPortal == "true") {

          this[NavigationMixin.Navigate]({
            type: "standard__recordPage",
            attributes: {
              recordId: result.insertR4CCaseRes.Id,
              objectApiName: "Case",
              actionName: "view"
            }
          });
          return;
        }
        let pagetab;
        let parenttab;
        this.invokeWorkspaceAPI("getFocusedTabInfo").then(
          (focusedTab) => {
            if (focusedTab.isSubtab) {
              pagetab = focusedTab.tabId;
              parenttab = focusedTab.parentTabId;
              this.invokeWorkspaceAPI("openSubtab", {
                parentTabId: parenttab,
                recordId: result.insertR4CCaseRes?.Id,
                focus: true
              }).then((result) => {
                this.invokeWorkspaceAPI("closeTab", {
                  tabId: pagetab
                }).then((result) => {
                  this.invokeWorkspaceAPI("refreshTab", {
                    tabId: parenttab,
                    includeAllSubtabs: true
                  });
                });
              });
            } else {
              let tempFocustab = focusedTab.tabId;
              this.invokeWorkspaceAPI("openTab", {
                recordId: result.insertR4CCaseRes.Id,
                focus: true
              }).then((result) => {
                this.invokeWorkspaceAPI("closeTab", {
                  tabId: tempFocustab
                });
              });
            }
          }
        );
        if (result?.errorMessageOfDmlOperation) {
            throw new Error(result.errorMessageOfDmlOperation);
        }
        //End
      })
      .catch((error) => {
        console.error(error);
        this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error"); //Added as part of Failure Handling - TWC4621-3040
        this.isLoading = false;
      });
  }
