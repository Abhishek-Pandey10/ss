    public static String soldToCheck(Customer_CMF__c cmf) {
        Boolean isPortalView=(isPortal==null)?false:isPortal;
        String blockCheck = '';
        String centerlOrderBlock = (cmf.Customer_Central_Order_Block__c==null)?'':cmf.Customer_Central_Order_Block__c;
        String centerlBillingBlock = (cmf.Customer_Central_Billling_Block__c==null)?'':cmf.Customer_Central_Billling_Block__c;
        String centerlDeliveryBlock = (cmf.Customer_Central_Delivery_Block__c==null)?'':cmf.Customer_Central_Delivery_Block__c;
        String orderHardBlock=GENERIC_MESSAGES.containsKey(cmfOrderHardBlock)?GENERIC_MESSAGES.get(cmfOrderHardBlock):'';
        String orderBillingBlock=GENERIC_MESSAGES.containsKey(cmfBillingHardBlock)?GENERIC_MESSAGES.get(cmfBillingHardBlock):'';
        String orderDeliveryBlock=GENERIC_MESSAGES.containsKey(cmfDeliveryHardBlock)?GENERIC_MESSAGES.get(cmfDeliveryHardBlock):'';
        
        if((String.isNotEmpty(centerlOrderBlock) && orderHardBlock.contains(centerlOrderBlock)) ||
        (centerlOrderBlock == '01' && !isPortalView)) {
            blockCheck = 'Orderblock';
        }
        else if(String.isNotEmpty(centerlBillingBlock)  && orderBillingBlock.contains(centerlBillingBlock)) {
            blockCheck = 'Billingblock';
        }
        else if(String.isNotEmpty(centerlDeliveryBlock)  && orderDeliveryBlock.contains(centerlDeliveryBlock)) {
            blockCheck = 'Deliveryblock';
        }
        return blockCheck;
        
    }
    
