              this.crrRecord.Sales_Issue_Header_Error_Messages__c = this.crrRecord.Sales_Issue_Header_Error_Messages__c ? this.crrRecord.Sales_Issue_Header_Error_Messages__c + this.genericMessages?.No_approval_records_found_ErrorMsg : this.genericMessages?.No_approval_records_found_ErrorMsg;
            }
          });
      } else {
        this.ApprovalMatrixRecord = {
          Sales_Issue_Approver_Email__c: this?.crrRecord?.Sales_Issue_Approval_Email_Address__c
        }
      }
    }
