     * @description     To get the case record
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
     *@param String caseId.
     *@return Case Record
     * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
     */
    @AuraEnabled
    public static caseWrapper editCase(String caseId, Boolean isPortalCheck) {
        isPortal = (isPortalCheck==null)?false:isPortalCheck;
        final caseWrapper caseWrap = new caseWrapper();
        try {
            
            if(String.isNotBlank(caseId)) {
                Case caseNew = new Case();
                caseNew = R4C_AG_EditCaseUtil.getCaseRecordById(caseId);
                if(caseNew.Customer_Return_Requests__r!=null) {
                    List<String> blockers = new List<String>();
                    blockers = requestBlockCheck(caseNew.Customer_Return_Requests__r[0],caseNew.Customer_Return_Requests__r[0].Sales_Issue_SoldTo_Customer__c,caseNew.Customer_Return_Requests__r[0].Sales_Issue_ShipTo_Customer__c);
                    caseWrap.payer = payercmf;//payercmf map is prepared in requestBlockCheck
                    caseWrap.payersalesarea = salesAreamap;//salesAreamap  is prepared in requestBlockCheck
                    caseWrap.caseStatus = casestats;//if we have any soft blocks sendind case status as pending agent
                    caseWrap.genericMessages = GENERIC_MESSAGES;
                    caseWrap.caseRec = caseNew;
                    if(!blockers.isEmpty()) {
                        caseWrap.errorMessages = blockers;
                    }
                    caseWrap.nonBlockedCMFs =  getnonBlockedCMFs(new List<String> {caseNew.AccountId}, new List<String> {caseNew.ContactId});//TWC4621-1123 added accountId from case as part of data model changes
                    caseWrap.bagIds = bagCMFIds;
                    final List<Customer_Sales_Area__c> salesAreaList = R4C_AG_EditCaseUtil.getsalesAreaByCMF(new List<String>{caseNew.Customer_Return_Requests__r[0].Sales_Issue_SoldTo_Customer__c}, caseNew.Customer_Return_Requests__r[0].Sales_Issue_Sales_Organization__c, caseNew.Customer_Return_Requests__r[0].Sales_Issue_Distribution_Channel__c);
                    if(!salesAreaList?.isEmpty()) {
                        caseWrap.selectedSalesArea = salesAreaList[0];
                    }
                    //caseWrap.payerCMFAccount = payercmfAccounts;// TWC4621-936 -- 30-01-2023 --- Manohar --- Export Compliance Block for payer CMF
                    //caseWrap.shipToCMFAccount = R4C_ShippingDetailsUtil.getCMFAccount(new List<String>{caseNew.Customer_Return_Requests__r[0].Sales_Issue_ShipTo_Customer__c},SHIPTO_CODE);// TWC4621-936 -- 30-01-2023 --- Manohar --- Export Compliance Block for shipTo CMF
                    if(isPortal) {
                        caseWrap.isEmualtedUser = R4C_AG_CaseHeader_Controller.returnLoginUserInfo();//TWC4621-2010 -- Manohar -- check logged in user is Emulated user or not.
                    }
                }
            }
            if (Test.isRunningTest()) {
                throw new AuraHandledException('Forced exception for test coverage');
            }
            
        }
        catch(Exception ahe) {
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_AG_EditCaseController.editCase',ahe.getMessage(),ahe,True);
            caseWrap.errorMessage = 'R4C_AG_EditCaseController.editCase'+ahe.getMessage();
            //throw new AuraHandledException(ahe.getMessage());
        }
