             } else if (payercmfAccountRecord && payercmfAccountRecord?.Customer_Account_Name__c && payercmfAccountRecord?.Customer_Account_Name__r?.Core_Export_Compliance_Block__c === true) {//added by manohar -- TWC4621-936 -- 30/01/2023 -- Export Compliance Block for payer
               payercmfblocks = this.labels.Payer_Account_ECB;
