        this.disableEmail = false; //TWC4621-1013 Disabling email field when editing a contact
        this.displayConsent = false;
        const privacyCheckbox = this.template.querySelector('lightning-input[data-id="privacyId"]');
        const countryCheckbox = this.template.querySelector('lightning-input[data-id="countryId"]');

        if (privacyCheckbox) {
            privacyCheckbox.checked = false;
        }
        if (countryCheckbox) {
            countryCheckbox.checked = false;
        }

        this.isPrivacyAgreed = false;
        this.isCountryAgreed = false;

    }

    //This method is for displaying all the required toast messages.
    // Shows success, error, or warning messages to user during R4C contact management
    // Displays notifications for contact save, delete, validation errors using title, message, variant
    showToast(title, message, variant) {
        const event = new ShowToastEvent({
            title: title,
            message: message,
            variant: variant
        });
        this.dispatchEvent(event);
    }

    // Manages keyboard navigation between contact form buttons for accessibility
    // Handles Tab key movement between focustoclose and savetocancel elements
    focustoclose(event) {

        if (event.key === 'Tab') {
            event.preventDefault();
            setTimeout(() => { this.template.querySelector('.focustoclose').focus(), 10 });

        }
        if (event.key === 'Tab' && event.shiftKey) {
            event.preventDefault();
            setTimeout(() => { this.template.querySelector('.savetocancel').focus(), 10 });

        }
    }

    // Handles reverse keyboard navigation to save button for accessibility
    // Moves focus to closetosave button when user presses Shift+Tab
    focustosave(event) {
        if (event.key === 'Tab' && event.shiftKey) {
            setTimeout(() => { this.template.querySelector('.closetosave').focus(), 10 });

        }
    }

    // Sets initial focus when contact management modal opens for accessibility
    // Automatically focuses on focustoclose button when modal becomes visible
    focusOnOpen() {
        setTimeout(() => { this.template.querySelector('.focustoclose').focus(), 1000 });
    }

    get isAnyConsentRequired() {
    return this.isShipConsentRequired || this.isSoldConsentRequired;
}
}

