     //   andConditionList.add( ' ( Sales_Issue_Collection_Site_Id__r.Sales_Issue_Collection_Site_Id__c IN: CollectionSiteIdList  OR Sales_Issue_Collection_Site_Id__c=null ) ' );
        
        
        if(plantTypeList.isEmpty() == false) {
