      return this.isExceptionService() && this?.remedy == 'Repair'
    },
    isExceptionDRR() {
      return this.isExceptionService() && this?.returnReason == 'Direct Return Repair'
    },
    isExceptionIRR() {
      return this.isExceptionService() && this?.returnReason == 'Indirect Return Repair'
    },
    isAdminService() {
      return this?.serviceType == 'Admin'
    },
    isQualityService() {
      return this?.serviceType == "Quality";
    },
    isMiscellaneousService() {
      return this?.serviceType == "Miscellaneous";
    },
    isMiscellaneousCredit() {
      return this.isMiscellaneousService() && this?.remedy == 'Credit';
    },
    isCredit() {
      return this?.remedy == 'Credit';
    },
    isNPRCredit() {
      return this?.remedy == 'NPR-Credit';
    }
  };
}

