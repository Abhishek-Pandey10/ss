    /**
    * ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
    * Helper Method for Submit Case logic method - submitCase
    * User-Story : TWC4621- Added helper method for cyclomatic complexity
    * ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    * @author   Accellor
    * @param    String caseStatus,R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper
    * @return   void
    * ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
    */
    public static void submitCaseHelper(String caseStatus,R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper) {
        if(caseStatus == R4C_Generic_Configurations__c.getValues('Case_Status_RMA_Authorized').value__c && submitCaseWrapper.returnreqdetails != null) {
            List<Customer_Sales_Issue_Request__c> crrlist = new List<Customer_Sales_Issue_Request__c>();
            Customer_Sales_Issue_Request__c crr = new Customer_Sales_Issue_Request__c();
            updateAuthCustomerSalesIssueRequest(crr,submitCaseWrapper);
            crrlist.add(crr);
            R4C_ViewSummaryUtil.insertCustomerReturnRequest(crrlist);    
        }
        if(checkGenericConfigurationApprovalEmail(caseStatus, submitCaseWrapper)) {
            Final List<Customer_Sales_Issue_Request__c> crrlist = new List<Customer_Sales_Issue_Request__c>();
            Customer_Sales_Issue_Request__c crr = new Customer_Sales_Issue_Request__c();
            crr = updatePendActCustomerSalesIssueRequest(crr,submitCaseWrapper);
            crrlist.add(crr);
            R4C_ViewSummaryUtil.insertCustomerReturnRequest(crrlist);
            R4C_EmailApproval_Handler.invokeApprovalEmail(submitCaseWrapper.caseRec.Id);

        }
        if(caseStatus == R4C_Generic_Configurations__c.getValues('Pending_Agent_Action').value__c && String.isBlank(submitCaseWrapper.ApprovalmatrixRec.Sales_Issue_Approver_Email__c)) { //Method for making case status to Submitted Pending Action if no Approval Matrix records
            List<Customer_Sales_Issue_Request__c> crrlist = new List<Customer_Sales_Issue_Request__c>();
            Customer_Sales_Issue_Request__c crr = new Customer_Sales_Issue_Request__c();
            crr = updatePendActCustomerSalesIssueRequest(crr,submitCaseWrapper);
            crrlist.add(crr);
            R4C_ViewSummaryUtil.insertCustomerReturnRequest(crrlist); 
        }
    }

    /**
    * ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
