* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Tecnical intake update npr cert date
* User-Story : TWC4621-963
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* @author   Furqan

*/
    public static void updateCaseHeaderForPortalValue(String caseId, String errorReason) {
        List<Customer_Sales_Issue_Request__c> caseHeaderDetails = new List<Customer_Sales_Issue_Request__c>();
            //TWC4621-1548 - Syed - Adding new fields to query and updating them
            caseHeaderDetails = Database.query('SELECT id,Sales_Issue_COD_Agreed_By__c,Sales_Issue_Crt_Of_Destruction_Ind__c,Sales_Issue_Header_Error_Messages__c,Sales_Issue_Crt_Of_Destruction_Date__c,Sales_Issue_SoldTo_Customer__c,Sales_Issue_Location_Plant__c,Sales_Issue_Remedy_Type__c,Sales_Issue_Remedy_Type__r.Name,Sales_Issue_Return_Reason__c,Sales_Issue_Return_Reason__r.Name,Sales_Issue_Sales_Organization__c FROM Customer_Sales_Issue_Request__c WHERE Sales_Issue_CaseNumber__c=:caseId WITH USER_MODE');
        
        caseHeaderDetails = helper(caseHeaderDetails); // splittind due to cyclomatic complexity
        if (errorReason != null) {
            caseHeaderDetails.get(0).Sales_Issue_Header_Error_Messages__c = errorReason;
        }
        R4C_DML_UtilClass.updateasUser(caseHeaderDetails);
    }

    /** Description: Helper method to redue cyclomatic complexity */
    public static List<Customer_Sales_Issue_Request__c>  helper(List<Customer_Sales_Issue_Request__c> caseHeaderDetails) {
        if (caseHeaderDetails.isEmpty() == false && caseHeaderDetails.get(0).Sales_Issue_Crt_Of_Destruction_Date__c == null && caseHeaderDetails.get(0).Sales_Issue_Remedy_Type__r.Name == 'NPR-Credit') {
           
                caseHeaderDetails.get(0).Sales_Issue_Crt_Of_Destruction_Date__c = Date.today();
            
                caseHeaderDetails.get(0).Sales_Issue_COD_Agreed_By__c=Userinfo.getUserId();
            
                caseHeaderDetails.get(0).Sales_Issue_Crt_Of_Destruction_Ind__c=true;
            
        }
        return caseHeaderDetails;
    }
   
     /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Description :  SR Allowance amount Deduction for the cancelled Lines -- Manual Line item closure After RMA
* User-Story : TWC4621-3197
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* @author   Manohar

*/
     public static void  updateAllowanceRecordsAfterRMA(List<Customer_Sales_Issue_Request_Line__c> lineItemsLSt) {
        Set<String> newSRAllowanceRecordIds = new Set<String>();
        Set<String> newLineItemIds = new Set<String>();
        List<Customer_Sales_Issue_Request_Line__c> newlineItemsList = new List<Customer_Sales_Issue_Request_Line__c>();
        if (lineItemsLSt.isEmpty() == false) {
            for(Customer_Sales_Issue_Request_Line__c line : lineItemsLSt) {
                if(String.isNotBlank(line.Sales_Issue_Allowance_Matrix_Id__c)) { 
                    newLineItemIds.add(line.Id);
                    newSRAllowanceRecordIds.add(line?.Sales_Issue_Allowance_Matrix_Id__c);
                }
            }
        }
        if (newSRAllowanceRecordIds.isEmpty() == false && newLineItemIds.isEmpty() == false) {
            newlineItemsList = [Select Id,Sales_Issue_Allowance_Matrix_Id__c,Sales_Issue_Cst_Return_Receipt_Cnd__c,Sales_Issue_Cst_Return_Receipt_Cnd__r.Name,Sales_Issue_Net_Credit_Value__c from Customer_Sales_Issue_Request_Line__c where ID IN: newLineItemIds WITH USER_MODE];
        }
        if(newlineItemsList.isEmpty() == false) {
            R4C_EmailApproval_Handler.UpdateDiscrepantSRAllowanceRecords(newlineItemsList,newSRAllowanceRecordIds);
        }
        
    }
        /*
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* User-Story : TWC4621-4739
* Date : 10-07-2025
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* @author   Manohar
* @param    Customer_Sales_Issue_Request__c record
*@Description : Helper method to detetmine approver level for ILM matrix
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/
    static String getILMApproverLevel(approvalMatrixWrapper approvalRequest) {
        String whereClause  = '';
        string serviceTypeName = approvalRequest?.requestDetail?.Sales_Issue_Service_Type__r?.Name;
        Decimal netCreditPriceDec= Decimal.valueOf(approvalRequest.netCreditPrice);
        if(serviceTypeName == 'Exception') {
            if(netCreditPriceDec <= 300000){
                whereClause  = whereClause + ' AND Sales_Issue_Exceeds_Price__c > 0 AND Sales_Issue_Exceeds_Price__c <= 300000 ';
            }
            if(netCreditPriceDec > 300000 && netCreditPriceDec <= 5000000){
            whereClause  = whereClause + ' AND Sales_Issue_Exceeds_Price__c > 300000 AND Sales_Issue_Exceeds_Price__c <= 5000000 ';
            }
            if(netCreditPriceDec > 5000000){
            whereClause  = whereClause + ' AND ( Sales_Issue_Exceeds_Price__c > 5000000 OR Sales_Issue_Exceeds_Price__c = -1 ) ';
            }
        } else if(serviceTypeName == 'Admin') {
            if(netCreditPriceDec <= 100000){
                whereClause  = whereClause + ' AND Sales_Issue_Exceeds_Price__c > 0 AND Sales_Issue_Exceeds_Price__c <= 100000 ';
            }
            if(netCreditPriceDec > 100000 && netCreditPriceDec <= 300000){
            whereClause  = whereClause + ' AND Sales_Issue_Exceeds_Price__c > 100000 AND Sales_Issue_Exceeds_Price__c <= 300000 ';
            }
            if(netCreditPriceDec > 300000){
            whereClause  = whereClause + ' AND ( Sales_Issue_Exceeds_Price__c > 300000 OR Sales_Issue_Exceeds_Price__c = -1 ) ';
            }
        }
        return whereClause;
    }
