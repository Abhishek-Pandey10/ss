    @AuraEnabled
    public static R4C_ViewSummaryUtil.RecordInsertionWrapper updateECCLineItem(R4C_ViewSummaryUtil.returnReqDetailsWrapper returnReqDetails, String caseStatus) {
        R4C_ViewSummaryUtil.RecordInsertionWrapper recordsToBeInsertedInUI = new R4C_ViewSummaryUtil.RecordInsertionWrapper();
        try{
    
            R4C_ViewSummaryUtil.recordsToBeInsertedInUI=recordsToBeInsertedInUI;
            R4C_ViewSummaryUtil.isPreserveLineStatus=true;
            //Case
            List<Case> insertedcaseList=  R4C_ViewSummaryUtil.getCaseList(returnReqDetails,caseStatus);
            R4C_ViewSummaryUtil.insertedcaseList=insertedcaseList;
            if (insertedcaseList.isEmpty() == false) {
                recordsToBeInsertedInUI.insertR4CCaseRes = insertedcaseList[0];
            }

            if(returnReqDetails?.caserecTypeName == R4C_ViewSummaryUtil.genericmsgs.get('Quality_Intake') && returnReqDetails?.caseRec?.Origin == 'ILM') {
                R4C_ViewSummaryUtil.isQualityFAC = true;    
            } 
            //Header
            List<Customer_Sales_Issue_Request__c> customerReturnRequestList=R4C_ViewSummaryUtil.getCustomerReturnRequest(returnReqDetails.CustomerReturnRequest,returnReqDetails.remedyDetails.Name == R4C_ViewSummaryUtil.genericmsgs.get('Credit_NPR'));
            customerReturnRequestList = R4C_ViewSummaryUtil.insertCustomerReturnRequest(customerReturnRequestList);
            R4C_ViewSummaryUtil.insertedcustomerReturnRequestList=customerReturnRequestList;
            if (customerReturnRequestList.isEmpty() == false) {
                recordsToBeInsertedInUI.customeraSalesIssueRequestInsertRecord = customerReturnRequestList[0];
            }
            //Line
            List<Customer_Sales_Issue_Request_Line__c> customerReturnRequestLineList  = R4C_ViewSummaryUtil.getcustomerReturnRequestLine(returnReqDetails.customerReturnRequestLineWrapperList);
        
            List<Customer_Sales_Issue_Request_Line__c> updateCustomerReturnRequestLineList= R4C_ViewSummaryUtil.insertCustomerReturnRequestLine(customerReturnRequestLineList);
            if (updateCustomerReturnRequestLineList.isEmpty() == false) {
                recordsToBeInsertedInUI.customeraSalesIssueRequestLineInsertRecord = updateCustomerReturnRequestLineList[0];
            }
          
        }
        catch (Exception e) { //TWC4621-3159
            
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_AG_ViewSummaryController.updateECCLineItem',e.getMessage(),e,True);
            recordsToBeInsertedInUI.errorMessageOfDmlOperation = 'R4C_AG_ViewSummaryController.updateECCLineItem'+e.getMessage();
            //throw new AuraHandledException('R4C_AG_ViewSummaryController : ' + e.getMessage());
        }  
    return recordsToBeInsertedInUI;     
    } 

