    public static R4C_API_MatricesGenericWrapper.APIResponse loadNCNRMatrixData(List<R4C_API_MatricesGenericWrapper.NCNRMatrixWrap> matrixRequestList, String recordTypeId) {
        R4C_API_MatricesGenericWrapper.APIResponse response= new R4C_API_MatricesGenericWrapper.APIResponse();
        List<Sales_Issue_Matrix__c> ncnrRecordsListToInsert = new List<Sales_Issue_Matrix__c>();
        List<Sales_Issue_Matrix__c> existingNcnrRecordsList = new List<Sales_Issue_Matrix__c>();
        Integer deletedRecordsCount = 0;
        try {

            for (R4C_API_MatricesGenericWrapper.NCNRMatrixWrap request : matrixRequestList) {
                Sales_Issue_Matrix__c ncnrRec = new Sales_Issue_Matrix__c();
                ncnrRec.Product_Status_Code__c = request.ProductStatus;
                ncnrRec.Item_Custom_Indicator__c = request.CustomIndicator;
                ncnrRec.NCNR_Flag__c = request.NCNRFlag;
                ncnrRec.Order_Confirmation_Flag__c = request.OrderConfirmationFlag; // Added order confirmation flag as part of TWC4621-5475
                ncnrRec.RecordTypeId = recordTypeId;
                ncnrRecordsListToInsert.add(ncnrRec);
            }

            If(!ncnrRecordsListToInsert.isEmpty()) {
                existingNcnrRecordsList = [select Id from Sales_Issue_Matrix__c where RecordTypeId =: recordTypeId];
                deletedRecordsCount = existingNcnrRecordsList.size();
                INSERT as user ncnrRecordsListToInsert;
            }

            If(deletedRecordsCount > 0) {
                DELETE as user existingNcnrRecordsList;
            }

            response.isSuccess=true;
            response.insertedRecordCount = ncnrRecordsListToInsert.size();
            response.deletedRecordCount = deletedRecordsCount;
            response.devInfo='CPU TIME=> '+LIMITS.getCpuTime()+',  HEAP SIZE=> '+ LIMITS.getHeapSize();
            return response;
        } catch (Exception excep) {
            response.isSuccess=false;
            response.devInfo='CPU TIME=> '+LIMITS.getCpuTime()+',  HEAP SIZE=> '+ LIMITS.getHeapSize();
            return response;
        }
    }
