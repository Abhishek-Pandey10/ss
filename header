    /**────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    * Method       : getEmbargoCountryDetails
    * @Description : Returns Embargo Country details from custom settings (Core_Country_Reference__c)
    * @param       : List<String>
    * @return      : List<Core_Country_Reference__c>
    * User Story   : TWC4621-4685 - SaiRam - To use custom setting for Embargo (IAO)
    * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    */

    @AuraEnabled
    public static List<Core_Country_Reference__c> getEmbargoCountryDetails(List<String> countryCodelist){
        try {
            List<Core_Country_Reference__c> embargoCountryList = new List<Core_Country_Reference__c>();
            embargoCountryList = [SELECT ICS_WR_Is_Embargoed__c, ICS_WR_ISO_Code_Two__c,ICS_WR_Embargoed_States__c, Name, Core_ISO_Code__c, Core_Has_States__c FROM Core_Country_Reference__c WHERE ICS_WR_ISO_Code_Two__c IN:countryCodelist AND ICS_WR_Is_Embargoed__c = true WITH SECURITY_ENFORCED];
            return embargoCountryList;
        } catch (Exception e) {
            throw new AuraHandledException(e.getMessage());
        }
    }
    
    /* ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* Method       : getTheCountryEmbargoDetails
* @Description : Returns API Response of Country Embargo Details
* @param       : (Wrapper) RequestWrapper
* @return      : (Wrapper) ResponseWrapper
* ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
*/
    public static Object getTheCountryEmbargoDetails(RequestWrapper reqWrapper){
        ResponseWrapper resWrapper = new ResponseWrapper();
        try{
            String body = JSON.serialize(reqWrapper);
            R4C_APIGEE_Settings__mdt integrationSetting = R4C_APIGEE_Settings__mdt.getInstance('Embargo');
            // START Metadata to Named Credentials changes - US - TWC4517-3385
            String endPointUrl = integrationSetting?.Consuming_Class_Name__c;  
            HttpRequest req = new HttpRequest();
            HttpResponse res = new HttpResponse();
            req.setEndpoint(endPointUrl);
            req.setMethod('POST');
            req.setHeader('content-type', 'application/json'); 
            req.setBody(body);
            req.setTimeout(120000);
            Http sendReqHttp = new Http();
            res = sendReqHttp.send(req);
           
            // END Metadata to Named Credentials changes - US - TWC4517-3385
            resWrapper = (ResponseWrapper)JSON.deserialize(res.getBody(), ResponseWrapper.class);
            //code added for storing API request and response details - start
            R4C_API_MessageLogAndAttachment.MessageLogWrapper msgLogWrpr = new R4C_API_MessageLogAndAttachment.MessageLogWrapper();
            msgLogWrpr.SourceAPIName = 'EmbargoCountryCheck';
            msgLogWrpr.StatusCode = String.valueOf(res.getStatusCode());
            msgLogWrpr.requestBody = String.valueOf(body);
            msgLogWrpr.responseBody = String.valueOf(res.getBody());
            R4C_API_MessageLogAndAttachment.CreateMessageLogRecord(msgLogWrpr);
            //code added for storing API request and response details - end

            if(res.getStatusCode()>=500){
                throw new AuraHandledException(res.getBody());
            }
            
            return new R4C_API_Callout_ResponseHandler().success(resWrapper);
        }
        catch(Exception ex){
        
            return new R4C_API_Callout_ResponseHandler().failure('R4C_API_EmbargoCountryCheckHelper.getTheCountryEmbargoDetails',ex,'Integration/API error');
        }    
    }
    
}


