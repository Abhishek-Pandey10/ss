    /*Start--TWC4621-60,TWC4621-61--Tulika--Functionality for Save button */
    // Validates address fields and saves address via saveAddressApex with addressDetailsJSON
    // Modifies showSpinner and calls validateAddressWithTzone, validateZip, saveAddressApex
    async save(event) {
        try{
            this.showSpinner = true;

            if(!this.genericmessages.isIaoFlag == 'true') await this.validateAddressWithTzone();
            if ((this.country === '' || this.street1 === '' || this.city === '' || this.coname === '' || this.state === '') && !this.genericmessages.isIaoFlag == 'true') { // || this.zip === '' <!-- Made Zipcode Optional as an additional task under TWC4621-1133 Changes to View Line Item Status-->
                this.showToast(this.labels.Error_Title, this.labels.Enter_req_details, 'error');

                const valid = [...this.template.querySelectorAll('.validate'),].reduce((validAlready, comp) => {
                    comp.reportValidity();
                    return validAlready && comp.checkValidity();
                }, true);
            }
            else if (!this.validateZip()){
                this.showToast('Error', this.labels.R4C_US_ZIP_Code_format, 'error');
                return;
            }
            else{
                let addressDetails;
                let addressDetailsJSON = {
                    coName: this.coname,
                    street1: this.street1,
                    street2: this.street2,
                    city: this.city,
                    postalCode: this.zip,
                    state: this.state,
                    countryId: this.selectedCountryId,
                    customerAddressId: this.recordId,
                    cmfId: this.cmfid,
                    addressType: this.saveaddType,
                    tzoneCode: this.tzoneCode
                };
                addressDetails = JSON.stringify(addressDetailsJSON);
                console.log('APEX Address JSON ',addressDetails);
                
                if (this.genericmessages.isIaoFlag == 'true') {
                    this.saveAddressApex(addressDetails);
                }else {
                    if (this.currentAddress.status != "Invalid") {
                        this.showToast("Tzone Validation", "Successfully Validated.", 'success');
                        this.saveAddressApex(addressDetails);
                    } else {
                        this.showToast("Tzone Address Validation", this.currentAddress.errorMsg, 'error');
                    }
                }
            }
        }
       catch(error) {
            console.error('error', error);
            this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error"); //Added as part of Failure Handling - TWC4621-3040
        }
        finally {
            this.showSpinner = false;
        }
    }
    /*End--TWC4621-60,TWC4621-61--Tulika--Functionality for Save button */

    // Calls saveAddress apex method with addressDetails and updates addressList with result
    // Modifies newAddress, addressList, isModalOpen, stateList, editAddress and dispatches mycustomevent
    saveAddressApex(addressDetails) {
        saveAddress({ addressDetails: addressDetails })
            .then((result) => {
              
                        this.newAddress = result.phyAddRecord;
                         if (result?.errorMessage) {
                            throw new Error(result.errorMessage);
                        }
            
                this.newAddress.Customer_Country__r = this.countryMap?.get(this.selectedCountryId);
                let stateCode = this.statesCodeMap && this.statesCodeMap?.get(this.newAddress?.Customer_Physical_Address_State__c);
                //let stateName = this.statesCodeMap && this.statesCodeMap?.get(this.newAddress?.Customer_Physical_Address_State__c);
                if (stateCode) {
                    //this.newAddress.Customer_Physical_Address_State__r = { Id: this.newAddress.Customer_Physical_Address_State__c, Name: stateName, Location_Two_Digit_State_Code__c: stateCode };
                    this.newAddress.Customer_Physical_Address_State__r = this.statesMap?.get(this.newAddress?.Customer_Physical_Address_State__c);
                }
                let action = 'new';
                for (let i = 0; i < this.addressList.length; i++) {
                    if (this.addressList[i].Id === this.newAddress.Id) {
                        action = 'edit';
                        this.addressList[i] = this.newAddress;
                    }
                }
                if (action === 'new') {
                    this.addressList.push(this.newAddress);
                }
                if (this?.rtcGeoValue) {//Geo filtering toast logic
                    let selectedGeo = this.countryMap.get(this.selectedCountryId)?.Location_Geography__r?.Name;
                    if (selectedGeo !== this.rtcGeoValue) {
                        this.newAddress = null;
                        this.showToast(this.labels.Error_Title, `${this.labels.Collection_Address_Geo_Err_Msg} ${this.rtcGeoValue} GEO`, 'error');
                    }
                }
                const selectEvent = new CustomEvent('mycustomevent', {
                    detail: {
                        mode: 'save',
                        addType: this.addType,
                        updatedAddressCollection: this.addressList,
                        newAddress: this.newAddress,
                        selectedCountryName: this.selectedCountryName
                    }
                });
                this.dispatchEvent(selectEvent);
                (this.newAddress === null) ? '' : this.showToast(this.labels.Success_Message, this.labels.Address_saved, 'success');
                this.isModalOpen = false;
                this.stateList = [];
                this.editAddress = false;
            })
            .catch((error) => {
                console.error('error', error);
                this.showToast("Error", error?.body?.pageErrors[0]?.message, 'error');
            });
    }

    // Validates address with TzoneAPI using countryCodeMap, selectedCountryId, zip, statesCodeMap, state, city
    // Modifies currentAddress with validation result and sets tzoneCode from response
    async validateAddressWithTzone() {
        let addressDetails = {};
        if (this.countryCodeMap.get(this.selectedCountryId)) {
            addressDetails.country = this.countryCodeMap.get(this.selectedCountryId);
            addressDetails.country = addressDetails.country.trim();
        }else {
            addressDetails.country = '';
        }

        if (this.zip) {
            addressDetails.pinCode = this.zip.replace(/^\s+|\s+$/g, '');
            addressDetails.pinCode = addressDetails.pinCode.trim();
            }else {
            addressDetails.pinCode = '';
        }

        if (this.statesCodeMap && this.statesCodeMap?.get(this.state)) {
            addressDetails.region = this.statesCodeMap.get(this.state);
            addressDetails.region = addressDetails.region.trim();
         }else {
            addressDetails.region = '';
        }
        if (this.city) {
            addressDetails.city = this.city.replace(/\s+/g, '');
            addressDetails.city = addressDetails.city.trim();
        }else {
            addressDetails.city = '';
        }
         await TzoneAPI(this?.countryCodeMap,this?.selectedCountryId,this?.zip,this?.statesCodeMap,this?.state,this?.city)
          .then((tempresult) => {
                this.currentAddress = {};
                let Add = tempresult.d;
                this.currentAddress.country = Add?.ICollCnt;
                this.currentAddress.pinCode = Add?.ICollPost;
                this.currentAddress.region = Add?.ICollReg;
                this.currentAddress.city = Add?.ICollCity;
                this.currentAddress.tzoneCode = Add?.ETzone;
                this.currentAddress.status = Add?.status;
                this.currentAddress.errorMsg = Add?.errorMsg;
                this.tzoneCode = this.currentAddress?.tzoneCode;
            });
    }
