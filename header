    /* ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    * @Description : To Check sales issue service type 
    * @param       : (Wrapper) submitCaseWrapper
    * @return      : Boolean
    * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    */

    private static Boolean checkForSalesServiceTypeAndPortal(R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper) {
    return (submitCaseWrapper.returnreqdetails.Sales_Issue_Service_Type__r.Name=='Technical' || submitCaseWrapper.returnreqdetails.Sales_Issue_Service_Type__r.Name=='Quality') &&
                submitCaseWrapper.isPortal==true;
    }

    /* ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    * @Description : To Check the case Satatus 
    * @param       : String caseStatus, Map<String,String> r4cCustomSettingsMap, R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper
    * @return      : Boolean
    * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    */

    private static Boolean checkForCaseStatus(String caseStatus, Map<String,String> r4cCustomSettingsMap, R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper) {
        return (caseStatus == r4cCustomSettingsMap.get('Pending_Approval') || caseStatus == r4cCustomSettingsMap.get('Pending_Agent_Action') || 
                caseStatus == r4cCustomSettingsMap.get('Case_Status_RMA_Authorized')) && submitCaseWrapper.returnreqdetails != null && submitCaseWrapper.isPortal == true;
    }
    private static void updateAuthCustomerSalesIssueRequest(Customer_Sales_Issue_Request__c crr, R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper) {
        crr.Id = submitCaseWrapper.returnreqdetails.Id;
            crr.Sales_Issue_Submitted_Date__c = System.now();
        //Need to confirm with business on approved user for SR
    }
