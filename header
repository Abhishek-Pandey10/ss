    @HttpPost
    global static void postRequest(){
        RestRequest req = RestContext.request;
        RestResponse res = RestContext.response;
        String jsonString = req.requestbody.tostring();
        List<R4C_API_MatricesGenericWrapper.APIResponse> response=new List<R4C_API_MatricesGenericWrapper.APIResponse>();
        try{
            Map<String, Object> baseResponse = (Map<String, Object>) JSON.deserializeUntyped(jsonString);
            
            String matrixType=R4C_API_MatricUpdateHandler.getSalesforceMatrixTypeName(baseResponse,false);
            String matrixRecordName=R4C_API_MatricUpdateHandler.getSalesforceMatrixTypeName(baseResponse,true);
            String matrixRecordTypeId='';
            if(String.isNotEmpty(matrixRecordName)){
                matrixRecordTypeId=Schema.SObjectType.Sales_Issue_Matrix__c.getRecordTypeInfosByName().get(matrixRecordName).getRecordTypeId();
            }

            //TWC4621-5422 if the matrix is NCNR handle saperately and return
            if(matrixRecordName == 'NCNR Matrix') {
                List<R4C_API_MatricesGenericWrapper.NCNRMatrixWrap> NCNRrequestList =(List<R4C_API_MatricesGenericWrapper.NCNRMatrixWrap>) JSON.deserialize(JSON.serialize(baseResponse.get('Output')), List<R4C_API_MatricesGenericWrapper.NCNRMatrixWrap>.class);
                R4C_API_MatricesGenericWrapper.APIResponse responseNCNR = R4C_API_MatricUpdateHandler.loadNCNRMatrixData(NCNRrequestList,matrixRecordTypeId);
                String responseString=JSON.serializePretty(responseNCNR);
                res.statusCode=200;
                createMessageLog(res.statusCode,jsonString,responseString,matrixType);
                res.responseBody = Blob.valueOf(responseString);
                return ;
            }

            //convert request
            List<R4C_API_MatricesGenericWrapper.RequestMatrixItem> requestList= R4C_API_MatricUpdateHandler.getRequestParsedWrapper(baseResponse);

            //get salesforce ids
            requestList=R4C_API_MatricUpdateHandler.getSalesforceLookupIds(requestList,matrixRecordName,matrixRecordTypeId);
            System.debug('requestList '+requestList);
            
            List<R4C_API_MatricesGenericWrapper.RequestMatrixItem> toProcessRequestRecords=new List<R4C_API_MatricesGenericWrapper.RequestMatrixItem>();
            List<R4C_BusinessRules_Message__c> transactionRecordList=new List<R4C_BusinessRules_Message__c>();
            
            for(R4C_API_MatricesGenericWrapper.RequestMatrixItem request:requestList){
                //check if record is to be delayed or process inst
                
                R4C_BusinessRules_Message__c transactionRecord=validateProcessingType(request,jsonString);
                if (transactionRecord == null) {
                    toProcessRequestRecords.add(request);
                    continue; // stop execution in current cycne
                }
                transactionRecordList.add(transactionRecord);
                
            }
            
            //process low value record
            for(R4C_API_MatricesGenericWrapper.RequestMatrixItem matrixRecord:toProcessRequestRecords){
                R4C_API_MatricesGenericWrapper.CombinationsProcessIntermentResponse combinationProcessedResult = R4C_API_MatricUpdateHandler.processSingleRequestObject(matrixRecord,0,matrixRecord.ExpectedSerialCount);
                R4C_API_MatricesGenericWrapper.APIResponse singleRequest=new R4C_API_MatricesGenericWrapper.APIResponse();
                singleRequest.isSuccess=true;
                singleRequest.expectedConvertCount=matrixRecord.ExpectedSerialCount;
                singleRequest.rulePriorityNumber=Integer.valueOf(matrixRecord.RulePriorityNumber);
                singleRequest.insertedRecordCount=matrixRecord.ExpectedSerialCount;
                singleRequest.deletedRecordCount=R4C_API_MatricUpdateHandler.startPublisingEvents(combinationProcessedResult.combinations,matrixRecord,DateTime.now());
                singleRequest.devInfo='CPU TIME=> '+LIMITS.getCpuTime()+',  HEAP SIZE=> '+ LIMITS.getHeapSize();
                response.add(singleRequest);
            }
            
            //insert request into transaction record for further process
            if(!transactionRecordList.isEmpty()){
                List<Database.SaveResult> result=Database.insert(transactionRecordList,AccessLevel.USER_MODE);
                for(integer i=0;i<result.size();i++){
                    Database.SaveResult sr=result.get(i);
                    R4C_BusinessRules_Message__c tempRecord=transactionRecordList.get(i);
                    R4C_API_MatricesGenericWrapper.APIResponse singleRequest=new R4C_API_MatricesGenericWrapper.APIResponse();
                    
                    singleRequest.RulePriorityNumber=(Integer)tempRecord.Priority_Number__c;
                    if (sr.isSuccess()) {
                        singleRequest.expectedConvertCount=(Integer)tempRecord.Total_Records__c;
                        singleRequest.recordId=sr.getId();
                        singleRequest.isPartial=tempRecord.Error_Message__c==null;
                        singleRequest.isError=tempRecord.Error_Message__c!=null;
                        singleRequest.errorMessage=tempRecord?.Error_Message__c ?? '';
                    }
                    singleRequest.devInfo='CPU TIME=> '+LIMITS.getCpuTime()+',  HEAP SIZE=> '+ LIMITS.getHeapSize();
                    response.add(singleRequest);
                }
            }
            String responseString=JSON.serializePretty(response);
            res.statusCode=200;
            createMessageLog(res.statusCode,jsonString,responseString,matrixType);
            res.responseBody = Blob.valueOf(responseString);
            
        }catch(Exception e){
            R4C_API_MatricesGenericWrapper.APIResponse singleRequest=new R4C_API_MatricesGenericWrapper.APIResponse();
            singleRequest.isError=true;
            singleRequest.errorMessage=e.getMessage();
            response.add(singleRequest);
            String responseString=JSON.serializePretty(response);
            res.responseBody = Blob.valueOf(responseString);
            res.statusCode=500;
            createMessageLog(res.statusCode,jsonString,responseString,'');
            createErrorLog(e,jsonString);
        }
        
    }
    
