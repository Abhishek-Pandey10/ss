    /*Start--TWC4621-60,TWC4621-61--Tulika--to get a list of countries from the countryList*/
    // Fetches country list from getCountryList apex and populates countryList, countriesMap, countryCodeMap
    // Modifies countryMap, countryList, countriesMap, countryCodeMap with filtered country data
    getCountries() {
        getCountryList({}).then(result => {
            result.map(rec => {
                this.countryMap.set(rec.Id, rec);
            }) // geo filter logic
            const recievedValues = Object.values(result)
            let storeCountries = []
            recievedValues.forEach(element => {
                let count = {}
                count.countryName = element.Name,
                    count.recordId = element.Id,
                    count.Location_Two_Digit_Country_Code__c = element.Location_Two_Digit_Country_Code__c
                storeCountries.push(count);
            })
            let mapCountries = storeCountries.map(item => ({ label: item.countryName, value: item.recordId }));
            this.countryList = Object.values(mapCountries);
            let countryListToRemove= (this.genericmessages.ECC_Excluded_Countries).split(';');
            //Exclude Countries which are not maintained by ECC from Main Country List.
            this.countryList=this.countryList.filter(countryName => !countryListToRemove.includes(countryName.label));
            this.countriesMap = new Map();
            for (let i = 0; i < this.countryList.length; i++) {
                this.countriesMap.set(this.countryList[i].value, this.countryList[i].label);
            }
            this.countryCodeMap = new Map();
            storeCountries.map(rec => {
                this.countryCodeMap.set(rec.recordId, rec.Location_Two_Digit_Country_Code__c);
            })            
        }) //Added as part of Failure Handling - TWC4621-3040
        .catch((error) => {
            console.error('error', error);
            this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error"); //Added as part of Failure Handling - TWC4621-3040
        });

    }
    /*End--TWC4621-60,TWC4621-61--Tulika--to get a list of countries from the countryList*/
    
    // Fetches all states from getStateList apex and stores in statesCache for filtering
    // Modifies statesCache with complete state list data from apex response
    async getStateFromApex() {
        await getStateList().then(result => {
            console.log('States List',result);
            
            this.statesCache = Object.values(result);
        })
        .catch((error) => {
            console.error('error', error);
            this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error"); //Added as part of Failure Handling - TWC4621-3040
        });
    }

    // Filters statesCache by countryId and populates stateList, statesMap, statesCodeMap
    // Modifies stateList, statesMap, statesCodeMap with filtered states for selected country
    async getStates(countryId) {
        const statesFromCache = this.statesCache.filter(ele =>
            ele.Country__c == countryId)
        let mapStates = statesFromCache.map(item => ({ label: item.Name, value: item.Id }));
        this.stateList = Object.values(mapStates);
        this.statesMap = new Map();
        // for (let i = 0; i < this.stateList.length; i++) {
        //     this.statesMap.set(this.stateList[i].value, this.stateList[i].label);
        // }
        this.statesCodeMap = new Map();
        statesFromCache.map(rec => {
            this.statesCodeMap.set(rec.Id, rec.State_Code__c);
            this.statesMap.set(rec.Id, rec);
        })
    }
    /*Start--TWC4621-60,TWC4621-61--Tulika--On change method of Country field*/
    // Handles country selection from event.detail.value and updates related country properties
    // Modifies selectedCountryId, country, selectedCountryName, selectedCountrycode and calls getStates, updateZipMaxLength
    handelCountryValue(event) {
        this.editAddress = false;
        this.editStateAddress = false ;
        this.selectedCountryId = event.detail.value;
        this.country = event.detail.value;
        if(!(event.detail.value)) {
            this.handelCountryremove();
        }
  
        this.selectedCountryName = this.countriesMap.get(this.selectedCountryId);
        this.selectedCountrycode = this.countryCodeMap.get(this.selectedCountryId);
        console.log('@@430 selected code',this.selectedCountrycode);
        
        
        this.updateZipMaxLength();  

        this.getStates(this.selectedCountryId);
        if(this.selectedCountryName === 'United States') {
            this.validateZip();
        } else {
            this.zipError='';
            this.zipClass='';
        }
    }
    /*End--TWC4621-60,TWC4621-61--Tulika--On change method of Country field*/

    // Updates zipMaxLength based on selectedCountryName for Canada vs other countries
    // Modifies zipMaxLength to 7 for Canada, 10 for all other countries
    updateZipMaxLength() {
        if(this.selectedCountryName === 'Canada') {
            this.zipMaxLength = 7;
        } else {
            this.zipMaxLength = 10;
        }
    }

    // Validates zip format for United States using regex pattern and sets error states
    // Modifies zipError, zipClass and returns boolean validation result for zip field
    validateZip() {
        this.zipError='';
        this.zipClass='';

        if(this.selectedCountryName === 'United States') {
            const zip = this.zip;
            const zipPattern = /^\d{5}$|^\d{5}-\d{4}$/;

            if(!zipPattern.test(zip)) {
                this.zipError=this.labels.R4C_US_ZIP_Code_format;
                this.zipClass = 'error'
                return false;
            } 
        }
        return true;
    }

    // Handles state selection from event.detail.value and updates state-related properties
    // Modifies editStateAddress, selectedStateId, state, selectedStateName from statesMap
    handelStateValue(event) {
        this.editStateAddress = false
        console.log('State',event.detail.value);
        this.selectedStateId = event.detail.value;
        this.state = event.detail.value;
        this.selectedStateName = this.statesMap.get(this.selectedStateId)?.Name;
    }

