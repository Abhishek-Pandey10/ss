    validateEmail(email) {
        // Create a regular expression that matches valid email addresses.
        const regex = /^[\w-\.]+@([\w-]+\.)+[\w-]{2,4}$/g;

        // Return `true` if the email address matches the regular expression, otherwise `false`.
        return regex.test(email);
    }

