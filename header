                ItemMarketList.add((String) itemMarketName);
            }
        }
        ItemMarketList.add(null);
        if(Sales_Issue_Profit_Center!=null){
            for (object profitCentre: Sales_Issue_Profit_Center) {
                profitCentreCodeList.add((String) profitCentre);
            }
        }
