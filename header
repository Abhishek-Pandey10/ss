    private static Boolean checkGenericConfigurationApprovalEmail(String caseStatus, R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper) {
        return caseStatus == R4C_Generic_Configurations__c.getValues('Pending_Approval').value__c && 
        String.isNotBlank(submitCaseWrapper.ApprovalmatrixRec.Sales_Issue_Approver_Email__c) && String.isNotBlank(submitCaseWrapper.caseRec.Id);
    }
    
