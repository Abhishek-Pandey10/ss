    @AuraEnabled
    public static String updateLineItemStatus(Case caseRec) {
        String updateMessage = '';
        try {
            if (String.isBlank(caseRec.Id)) {
            List<Customer_Sales_Issue_Request_Line__c> lineItemsToUpdate = [SELECT Id,Sales_Issue_Line_Item_Status__c FROM Customer_Sales_Issue_Request_Line__c where Sales_Issue_Cst_Return_Request_Number__r.Sales_Issue_CaseNumber__c =: caseRec.Id];
                if (!lineItemsToUpdate.isEmpty()) {
                    List<Case> caseLst = new List<Case>();
                    caseLst.add(caseRec);
                    R4C_ViewSummaryUtil.falseSubmitHelper(lineItemsToUpdate,caseLst);
                    updateMessage = 'Success';
                }
            }
        }
        catch (Exception e) { 
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_AG_ViewSummaryController.updateLineItemStatus',e.getMessage(),e,True);
            updateMessage = e.getMessage();
        }
        return updateMessage;
    }
       
