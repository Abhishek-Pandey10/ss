    @AuraEnabled
    public static R4C_API_MatricesGenericWrapper.APIResponse processGetRequest(String transactionRecordId){
        R4C_API_MatricesGenericWrapper.APIResponse response=new R4C_API_MatricesGenericWrapper.APIResponse();
        List<String> invalidStatusList=new List<String>{'Completed','Bad Request','Failed'};
            List<R4C_BusinessRules_Message__c> transactionRecordList=[SELECT id,Rule_Changed_On__c,Priority_Number__c,Request_Body_Mapped__c,Status__c,Start_Index__c,Total_Records__c FROM R4C_BusinessRules_Message__c WHERE id=:transactionRecordId AND Status__c NOT IN: invalidStatusList WITH USER_MODE];

        if(transactionRecordList.isEmpty()){
            throw new BusinessRulesProcessException('No transaction record');
        }
        
        R4C_BusinessRules_Message__c transactionRequest=transactionRecordList.get(0);
        
        R4C_API_MatricesGenericWrapper.RequestMatrixItem matrixRecord=(R4C_API_MatricesGenericWrapper.RequestMatrixItem) JSON.deserialize(transactionRequest.Request_Body_Mapped__c, R4C_API_MatricesGenericWrapper.RequestMatrixItem.class);
        //normalize wrapper to process records 
        assignHeaderLookupValues(matrixRecord);
        
        R4C_API_MatricesGenericWrapper.CombinationsProcessIntermentResponse combinationProcessedResult = R4C_API_MatricUpdateHandler.processSingleRequestObject(matrixRecord,(Integer)transactionRequest.Start_Index__c??0,(Integer)transactionRequest.Total_Records__c);

        if(combinationProcessedResult.stopedIndex<transactionRequest.Total_Records__c-1){
            response.deletedRecordCount= R4C_API_MatricUpdateHandler.startPublisingEvents(combinationProcessedResult.combinations,matrixRecord,null);
            transactionRequest.Status__c='On Hold';
            transactionRequest.Start_Index__c=combinationProcessedResult.stopedIndex;
            response.insertedRecordCount=combinationProcessedResult.combinations.size();
            response.recordId=transactionRecordId;
            response.isPartial=true;
        }
        else if(combinationProcessedResult.stopedIndex>=transactionRequest.Total_Records__c-1){
            response.deletedRecordCount=R4C_API_MatricUpdateHandler.startPublisingEvents(combinationProcessedResult.combinations,matrixRecord,transactionRequest.Rule_Changed_On__c);
            response.insertedRecordCount=combinationProcessedResult.combinations.size();
            transactionRequest.Start_Index__c=combinationProcessedResult.stopedIndex;
            response.isSuccess=true;
            transactionRequest.Status__c='Completed';
        }
        //update as USER transactionRequest;
        SObjectAccessDecision securityDecision = Security.stripInaccessible(AccessType.UPDATABLE, new List<R4C_BusinessRules_Message__c>{transactionRequest});
        if(securityDecision.getRemovedFields().size() > 0) {
            throw new ObjectAccessException('Fields inaccessible exception '+ securityDecision.getRemovedFields());
        }

        UPDATE securityDecision.getRecords();
        response.rulePriorityNumber=(Integer)transactionRequest.Priority_Number__c;
        
        response.devInfo='getCpuTime=> '+LIMITS.getCpuTime()+'  getHeapSize=> '+ LIMITS.getHeapSize()+' StopedIndex=>'+combinationProcessedResult.stopedIndex+', Total Converted=>'+combinationProcessedResult.combinations.size();
        return response;
    }
