     /** Description: Helper method to reduce cyclomatic complexity */
    public static void queryHelper(List<Case> caselist,List<Id> newcrrlineitemIds,Boolean isSubmit) {
      
        List<String> caseStatus = genericmsgs.get('R4C_CaseEdit_LineItemStatusRestrict')?.split(';');
        List<Customer_Sales_Issue_Request_Line__c> customerReturnRequestLineList = new List<Customer_Sales_Issue_Request_Line__c>();
        if (caselist.isEmpty() == false) {
            customerReturnRequestLineList = [
                SELECT id, Sales_Issue_Line_Item_Status__c, Sales_Issue_Cst_Return_Request_Number__c, Sales_Issue_Cst_Return_Request_Number__r.Sales_Issue_CaseNumber__c,Sales_Issue_Cst_Return_Request_Number__r.Name
                FROM Customer_Sales_Issue_Request_Line__c WHERE Sales_Issue_Cst_Return_Request_Number__r.Sales_Issue_CaseNumber__c = :caselist[0].Id
                AND Id NOT IN :newcrrlineitemIds AND Sales_Issue_Line_Item_Status__c != :genericmsgs.get('Cancelled_Status_Value') AND Sales_Issue_Line_Item_Status__c != :genericmsgs.get('CPU_POH_Rejection') AND (NOT Sales_Issue_Line_Item_Status__c IN: caseStatus) WITH USER_MODE];//TWC4621-1223- 24/04/23 - Accellor//TWC4621-2886
        }
         // Start TWC4621-899 --Manohar -- updating line item status if it is cancelled or unselected in the case edit -- 19-Jan-2023
         if(isSubmit == true && customerReturnRequestLineList.isEmpty() == false) {
            trueSubmitHelper(customerReturnRequestLineList,caselist);
        }
        else if (isSubmit == false && customerReturnRequestLineList.isEmpty() == false) {
            falseSubmitHelper(customerReturnRequestLineList,caselist);
        }
        // End TWC4621-899 --Manohar -- updating line item status if it is cancelled or unselected in the case edit -- 19-Jan-2023
    }
     
    /** Description: Helper method to reduce cyclomatic complexity */
    public static void trueSubmitHelper(List<Customer_Sales_Issue_Request_Line__c> customerReturnRequestLineList,List<Case> caselist) {
        for (Customer_Sales_Issue_Request_Line__c lineitem : customerReturnRequestLineList) {
