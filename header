        //update customerReturnRequestLineList;
        ICS_TriggerHandler.clearBypass('R4C_LineTriggerHandler');

    }
     /** Description: Helper method to reduce cyclomatic complexity */
    public static void falseSubmitHelper(List<Customer_Sales_Issue_Request_Line__c> customerReturnRequestLineList,List<Case> caselist) {
        for (Customer_Sales_Issue_Request_Line__c lineitem : customerReturnRequestLineList) {
            if(genericmsgs.get('CheckCaseStatusToDetermineLineStatus').contains(caselist[0].status) == false) {
