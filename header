    /*Start--TWC4621-60,TWC4621-61--Tulika--Onchange method of input fields*/
    // Updates address field properties based on event.target.name and event.detail.value
    // Modifies coname, city, street1, state, street2, zip, country and validates zip
    setAddress(event) {
        if (event.target.name === this.genericmessages.CO_Name) {
            this.coname = event.detail.value;
        }
        if (event.target.name === this.genericmessages.City_label) {
            this.city = event.detail.value;
        }
        if (event.target.name === this.genericmessages.Street_1) {
            this.street1 = event.detail.value;
        }
        if (event.target.name === this.genericmessages.State_label) {
            this.state = event.detail.value;
        }
        if (event.target.name === this.genericmessages.Street_2) {
            this.street2 = event.detail.value;
        }
        if (event.target.name === this.genericmessages.Zip_postal_code) {
            this.zip = event.detail.value;
            this.validateZip();
        }
        if (event.target.name === this.genericmessages.Country_label) {
            this.country = event.detail.value;
        }
    }
