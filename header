    //Masking Changes - Samuel
    async _processMasking(records,contactId) {

    this.soldToProfileMaskMap.clear();
    this.shipToProfileMaskMapUsingSoldTo.clear();

    this.soldToProfileMaskMap = await records?.reduce((map, rec) => {
      const isUserProfile = rec.Contact__c === contactId;
      const isCustomerProfile = rec.Contact__c == undefined;
      const createMask = (isUserProfile || isCustomerProfile) && rec.Sold_To_CMF__c && rec.Ship_To_CMF__c == undefined && rec.Sold_To_Profile_View_Mask__c == true;
      if (map[rec.Sold_To_CMF__c] === false || !map[rec.Sold_To_CMF__c]) {
        map[rec.Sold_To_CMF__c] = createMask ? true : false;
      }
      return map;
    }, {});

    this.shipToProfileMaskMapUsingSoldTo = await records?.reduce((map, rec) => {
      const isUserProfile = rec.Contact__c === contactId;
      const isCustomerProfile = rec.Contact__c == undefined;
      const createMask = (isUserProfile || isCustomerProfile) && rec.Sold_To_CMF__c && rec.Ship_To_CMF__c && rec.Ship_To_Profile_View_Mask__c == true;
      if ( !map[rec.Sold_To_CMF__c] || map[rec.Sold_To_CMF__c].includes(rec.Ship_To_CMF__c) === false) {
        if (!map[rec.Sold_To_CMF__c]) {
          map[rec.Sold_To_CMF__c] = [];
        }
        if (createMask) {
          map[rec.Sold_To_CMF__c].push(rec.Ship_To_CMF__c);
        }
      }
      return map;
    }, {});

    console.log('this.soldToProfileMaskMap-- ', this.soldToProfileMaskMap);
    console.log('this.shipToProfileMaskMapUsingSoldTo-- ', this.shipToProfileMaskMapUsingSoldTo);
  }

