  //event handle to trigger collection details
  handleReturnReason(event) {
    let shippingResponseData = event.detail.shippingDetails;
    this.returnreasonText = shippingResponseData?.salesIssueReturnReason;
    this.issueRequestRec = event.detail.headerRec;
    this.caseType = setCaseTypeDetails(this.remedyValue, this.servicetyperec.Name, this.returnreasonText);
    if (shippingResponseData.Sales_Issue_Return_Reason__c /*&& !this.caseType.isTechnicalNPRCredit()*/) { //NPR Changes - Samuel
      this.template.querySelector("c-r4c_-a-g_-collection-details").clear();
      if (
        shippingResponseData.Sales_Issue_Remedy_Type__c &&
        shippingResponseData.Sales_Issue_Return_Reason__c &&
        shippingResponseData.Sales_Issue_Sales_Organization__c
      ) {
        this.template
          .querySelector("c-r4c_-a-g_-collection-details")
          .fetchCollectionData(shippingResponseData, this.servicetyperec.Id);
      }
    }
    this.showPOsearch = false;
    let pocmp;
    pocmp = this.template.querySelector("c-r4c_-a-g_-p-o-search");
    if (pocmp) {
      pocmp.handleReset();
    }
    this.hidecancelButton = true;
    this.hideNextButton = true;
    this.disableNextButton = true;
  }

