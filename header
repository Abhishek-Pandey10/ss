    }
    
    //json to Wrapper convoter
    public static List<R4C_API_MatricesGenericWrapper.RequestMatrixItem> getRequestParsedWrapper(Map<String, Object> baseResponse) {
        List<R4C_API_MatricesGenericWrapper.RequestMatrixItem> matrixList = new List<R4C_API_MatricesGenericWrapper.RequestMatrixItem>();
        //TWC4621-4824 - IAO Request Payload changes SaiRam.
        List<String> supportedMatrixKeys = new List<String>{
            'RequiredFieldMatrixResponse', 'ReturnLocMatrixResponse', 
                'FreightDeterminationMatrixResponse', 'NPRMatrixResponse', 
                'InCoMatrixResponse', 'ApprMatrixResponse', 
                'MRBMatrixResponse', 'CSRTMatrixResponse', 
                'PendingMatrixResponse','ILMApprMatrixResponse'
            }; //Samuel - added ILM
        if (Boolean.valueOf(isIAOFlag) || baseResponse.containsKey('MatrixName') && supportedMatrixKeys.contains(String.valueOf(baseResponse.get('MatrixName')))) {
            matrixList =(List<R4C_API_MatricesGenericWrapper.RequestMatrixItem>) JSON.deserialize(JSON.serialize(baseResponse.get('Output')), List<R4C_API_MatricesGenericWrapper.RequestMatrixItem>.class);
        }else {
            // Define a list of supported matrix keys
            // Iterate over supported keys to find and process the first match
            for (String key : supportedMatrixKeys) {
                if (baseResponse.containsKey(key)) {
                    Map<String, Object> matrixResponse = (Map<String, Object>) baseResponse.get(key);
                    matrixList =(List<R4C_API_MatricesGenericWrapper.RequestMatrixItem>) JSON.deserialize(JSON.serialize(matrixResponse.get('Output')), List<R4C_API_MatricesGenericWrapper.RequestMatrixItem>.class);
                    break; 
                }
            }
        }
        //TWC4621-4824 - IAO Request Payload changes SaiRam.

        if (matrixList.isEmpty()) {
            throw new R4C_API_MatricUpdateInbound.BusinessRulesProcessException('Matrix Type not supported');
        }
        
        return matrixList;
    }
