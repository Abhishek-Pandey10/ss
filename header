    // Deletes address record using recordId from event.target.value and updates addressList
    // Modifies deleteAddressIds, addressList and dispatches mycustomevent with delete mode
    handleDelete(event) {
        let recordId = event.target.value;
        this.deleteAddressIds.push(recordId);//TWC4621-1009 -- Manohar -- feb 21st 2023 -- adding delete record ids to array
        deleteAddress({ recordId: recordId })
            .then(() => {
                this.showToast(this.labels.Delete_Success, this.labels.Address_del_success, 'success');
                this.addressList = this.addressList.filter(item => item.Id !== recordId);
                const selectEvent = new CustomEvent('mycustomevent', {
                    detail: {
                        mode: 'delete',
                        addType: this.addType,
                        updatedAddressCollection: this.addressList,
                    }
                });
                this.dispatchEvent(selectEvent);

                // Prashant -- Removed Country and State Required Field Validation.
                this.recordId = undefined;
                this.coname = '';
                this.country = '';
                this.state = '';
                this.street1 = '';
                this.street2 = '';
                this.city = '';
                this.zip = '';
            })
    }
