    // Initializes getadddata with datawrapper parameters and sets up modal state
    // Modifies cmfid, addType, addressList, isModalOpen and clears form fields
    @api
    getadddata(datawrapper) {
        this.rtcGeoValue = datawrapper?.rtcGeoValue;
        this.deleteAddressIds = [];//TWC4621-1009 --- Manohar -- 21stfeb 2023 -- clearing the address ids
        this.cmfid = datawrapper.cmfid;
        this.addType = datawrapper.addtype;
        if (this.addType === this.genericmessages.Sales_Issue_Cst_Collection_Address__c) {
            this.saveaddType = this.genericmessages.Collection;
            this.CollectionAddrsValue = datawrapper.previousvalue;//TWC4621-1009 --- Manohar -- 21stfeb 2023 -- storing the collection address value to retain if the user clicks cancel
        }
        else if (this.addType === this.genericmessages.Sales_Issue_Return_To_Cst_Address__c) {
            this.saveaddType = this.genericmessages.Return_To_Customer;
            this.returnToCustAddrsValue = datawrapper.previousvalue;//TWC4621-1009 --- Manohar -- 21stfeb 2023 -- storing the RTC address value to retain if the user clicks cancel
        }
        this.addressList = datawrapper.addresslist !== undefined ? datawrapper.addresslist : [];
        this.getCountries();
        this.getStateFromApex();

        this.isModalOpen = true;
        // Prashant -- Removed Country and State Required Field Validation.
        this.recordId = undefined;
        this.coname = '';
        this.country = '';
        this.state = '';
        this.street1 = '';
        this.street2 = '';
        this.city = '';
        this.zip = '';
        this.focusOnOpen();
    }

    // Sets focus to closeFocus element after modal opens
