    _processNotFoundNumber(listByCaseNumber, parameters) {
        let notFoundList = [];
        if (parameters.rmaNumber) {
            let resultValues = listByCaseNumber.map(i => i.ReturnOrder);
            parameters.rmaNumber.split(',').forEach(searchKey => {
                const paddedSearchKey = searchKey.padStart(8, '0');
                if (resultValues.indexOf(paddedSearchKey.toUpperCase().trim()) == -1) {
                                    notFoundList.push(searchKey);
                }
            });
        }

        return notFoundList;
    }

