    async processUploadedFile(file) {
        let SUCESSHEADER = [labels.COD_RMA_Number, labels.SN_VisID, labels.Label_for_Product, labels.Contact_Email];
        let ERROREADER = [labels.COD_RMA_Number, labels.SN_VisID, labels.Label_for_Product, labels.Contact_Email, 'Error'];
        const result = await this.load(file);
        let csv = result.trim();
        const lines = [];
        let addUpto;
        let tempLines = csv.split(/\r\n|\n/);
        let tempLinesLength = tempLines.length;
        for (let i = (tempLinesLength - 1); i >= 0; i--) {
            let array = (tempLines[i].split(','));
            if (array.every(element => element.length === 0) !== true) {
                addUpto = i;
                break;
            }
        }
        for (let j = 0; j <= addUpto; j++) {
            lines.push(tempLines[j]);
        }
        //checking if file in empty or not
        if (lines.length < 2) {
            this.showToast(this.customlabels.Error_Title, this.customlabels.Empty_File, 'error');
        } else {
            //checking if template is matching
            if (!(lines[0] == SUCESSHEADER.join() || lines[0] == ERROREADER.join())) {
                this.showToast(this.customlabels.Error_Title, this.customlabels.Wrong_File_Format, 'error');
                return;
            }
            lines.forEach((line, i) => {
                if (i === 0) return;

                let data = line.split(',');
                if (!data[0]?.trim() && !data[1]?.trim() && !data[2]?.trim() && !data[3]?.trim()) return;
                let caseNumber = '';
                if (data[0]) {
                    caseNumber = data[0]?.trim();
                    if (caseNumber.length < 8) {
                        let repeatCount = 8 - caseNumber.length;
                        caseNumber = '0'.repeat(repeatCount) + caseNumber;
                    }
                }
                if (data[3]?.trim() && !this.validateEmail(data[3]?.trim())) {
                    this.fileVariables.errorLines.push({
                        rowNum: i,
                        rmaNumber: caseNumber,
                        ult: data[1]?.trim(),
                        product: data[2]?.trim(),
                        email: data[3]?.trim(),
                        error: labels.Invalid_Email
                    })
                }
                else if (data[1]?.trim() && data[1]?.trim() < 6) {
                    this.fileVariables.errorLines.push({
                        rowNum: i,
                        rmaNumber: caseNumber,
                        ult: data[1]?.trim(),
                        product: data[2]?.trim(),
                        email: data[3]?.trim(),
                        error: labels.Please_enter_more_then_3_characters
                    })
                }
                else if (data[1]?.trim() && data[1]?.trim() > 40) {
                    this.fileVariables.errorLines.push({
                        rowNum: i,
                        rmaNumber: caseNumber,
                        ult: data[1]?.trim(),
                        product: data[2]?.trim(),
                        email: data[3]?.trim(),
                        error: labels.ULT_max_length_Toast_msg
                    })
                }
                else {

                    this.fileVariables.successLines.push({
                        rmaNumber: caseNumber,
                        ult: data[1]?.trim(),
                        product: data[2]?.trim(),
                        email: data[3]?.trim(),
                        error: '',
                    })
                }

            });
            this.fileVariables.isShowError = this.fileVariables.errorLines.length > 0;

        }

    }

    async load(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = function () {
                resolve(reader.result);
            };
            reader.onerror = function () {
                reject(reader.error);
            };
            reader.readAsText(file);
        });
    }
