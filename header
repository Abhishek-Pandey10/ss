    public static String getSalesforceMatrixTypeName(Map<String, Object> baseResponse,Boolean isRecordTypeName) {
        // Use a Map for faster lookup
        Map<String, String> matrixRecordTypeNameMap = new Map<String, String>{
            'RequiredFieldMatrixResponse' => 'Required Field Matrix',
            'ReturnLocMatrixResponse' => 'Sales Issue Return Location Matrix',
            'FreightDeterminationMatrixResponse' => 'Sales Issue Freight Determination Matrix',
            'NPRMatrixResponse' => 'No Product Return Rule Matrix',
            'InCoMatrixResponse' => 'Sales Issue InCo Term Determination Matrix',
            'ApprMatrixResponse' => 'Approval Matrix',
            'MRBMatrixResponse' => 'MRB Matrix',
            'CSRTMatrixResponse' => 'Sales Issue Geography To Queue Map',
            'PendingMatrixResponse' => 'Pending Matrix',
            'NCNRRMatrixResponse' => 'NCNR Matrix',
            'ILMApprMatrixResponse' => 'ILM Approval Matrix' //Samuel
        };
        String requestMatrixType = '';
        //TWC4621-4824 - IAO Request Payload changes SaiRam.
        if(Boolean.valueOf(isIAOFlag) || baseResponse.containsKey('MatrixName')) {
            requestMatrixType = String.valueOf(baseResponse.get('MatrixName'));
        }else {
            requestMatrixType=baseResponse.keySet().iterator().next();
        }
        if(!isRecordTypeName){
            return requestMatrixType;
        }
        return matrixRecordTypeNameMap.containsKey(requestMatrixType) ? matrixRecordTypeNameMap.get(requestMatrixType) : '';
