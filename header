* @author   Manohar

*/
     public static List<Sales_Issue_Matrix__c> filterILMRecsBasedonOPID(List<Sales_Issue_Matrix__c> approvalMatrixlst, String opid) {
         List<Sales_Issue_Matrix__c> filteredOPIDlst  = new List<Sales_Issue_Matrix__c>();
         List<Sales_Issue_Matrix__c> emptyOPIDlst  = new List<Sales_Issue_Matrix__c>();
            for(Sales_Issue_Matrix__c matrixRec : approvalMatrixlst) {
                 if(matrixRec.Sales_Issue_Operation_Business_Unit_Code__c == opid) {
                     filteredOPIDlst.add(matrixRec);
                 } else if(String.isBlank(matrixRec.Sales_Issue_Operation_Business_Unit_Code__c)) {
                      emptyOPIDlst.add(matrixRec);
                 }
             }
            if(filteredOPIDlst.isEmpty()) {
              filteredOPIDlst = emptyOPIDlst;
            }
          return filteredOPIDlst;
     }
    
