 */
  closetab() {
    this.invokeWorkspaceAPI('getFocusedTabInfo').then(focusedTab => {
      if (focusedTab.tabId) {
        this.invokeWorkspaceAPI('closeTab', {
          tabId: focusedTab.tabId
        })
      }
    })
  }

