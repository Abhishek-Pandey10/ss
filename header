    /**
    * ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
    * Method to submit a case from agent UI
    * User-Story : TWC4621-55 -- 26-08-2022
    * ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    * DESCRIPTION : calling from Agent UI on click of save button
    * @author   Manohar
    * @param    submitCaseWrapper,caseStatus  (wrapper record of type R4C_AG_ViewSummaryUtil.submitCaseWrapper) 
    * @return   Case
    * ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
    */
    @AuraEnabled
    public Static caseWrapper submitCase(R4C_ViewSummaryUtil.submitCaseWrapper submitCaseWrapper, String caseStatus) {
        caseWrapper caseWrap = new caseWrapper();
        try {
            
            if(checkForSalesServiceTypeAndPortal(submitCaseWrapper)) {
                   R4C_ViewSummaryUtil.updateCaseHeaderForPortalValue(submitCaseWrapper.caseRec.Id,submitCaseWrapper.returnreqdetails.Sales_Issue_Header_Error_Messages__c);
            }
            
            if(submitCaseWrapper.stockAlwncList!=null && !submitCaseWrapper.stockAlwncList.isEmpty()) {
                R4C_ViewSummaryUtil.submitR4CStockRotationAllowanceUtil(submitCaseWrapper.stockAlwncList);
            }
            Map<String,String> r4cCustomSettingsMap = R4C_AG_CaseHeader_Controller.getErrorMessages();
            System.debug('@@@ caseStatus: ' + caseStatus);
            System.debug('@@@ Sales Org: ' + submitCaseWrapper.returnreqdetails.Sales_Issue_Sales_Organization__c);
            System.debug('@@@ SoldTo: ' + submitCaseWrapper.returnreqdetails.Sales_Issue_SoldTo_Customer__c);
            System.debug('@@@ r4cCustomSettingsMap: ' + r4cCustomSettingsMap);
            System.debug('@@@ checking caseStatus...');
            // Start - TWC4621-904 - Samuel - Setting default agent owner if RMA authorized and case from portalSales_Issue_Approver_Email__c
            if(checkForCaseStatus(caseStatus, r4cCustomSettingsMap, submitCaseWrapper)) {
                submitCaseWrapper.caseRec.OwnerId = R4C_CaseAssignmentEngine.assignAgentOwner(caseStatus,submitCaseWrapper.returnreqdetails.Sales_Issue_Sales_Organization__c,submitCaseWrapper.returnreqdetails.Sales_Issue_SoldTo_Customer__c);//'0058J000000WZoBQAW';
            }
            // End - TWC4621-904 - Samuel - Setting default agent owner if RMA authorized and case from portal
            caseWrap.returnCase =  R4C_ViewSummaryUtil.submitR4CCaseUtil(submitCaseWrapper.caseRec, caseStatus);
            submitCaseHelper(caseStatus,submitCaseWrapper);//Added helper method below for cyclomatic complexity
            caseWrap.returnCase = [Select Id, Status from Case where Id =:submitCaseWrapper.caseRec.Id]; // added this line for performance testing for line status updation from Case - Pravallika
            List<Customer_Sales_Issue_Request_Line__c> customerReturnRequestLineList = new List<Customer_Sales_Issue_Request_Line__c>();
            R4C_ViewSummaryUtil.updateCustomerReturnRequestLine(new List<Case>{caseWrap.returnCase},customerReturnRequestLineList,true);
        }
        catch (Exception e) {
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_AG_ViewSummaryController.submitCase',e.getMessage(),e,True);
            caseWrap.errorMessage = 'R4C_AG_ViewSummaryController.submitCase'+e.getMessage();
            //throw new AuraHandledException('R4C_AG_ViewSummaryController : ' + e.getMessage() + e.getStackTraceString());
        } 
        return caseWrap;
    }

