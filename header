import { generateWarrantyRequestBody, splitArrayIntoChunks, getDateString } from "c/r4c_AG_LineItemsResultTableUtill";
import { processWarrantyResponse } from "c/r4c_AG_TechinalIntakeHelper";
import { StringFormatter } from 'c/r4c_stringFormatter';
import getWarrantyCheck from "@salesforce/apexContinuation/R4C_EntAPI_GetWarrentyConsumingClass.invokeInitialRequest";
import { gql, graphql } from "lightning/uiGraphQLApi";

const RECORDS_PER_PAGE = 10;
export default class R4c_AG_ExchangeWarrantyCheck extends LightningModal {

    @api set lineItems(value) {
        this.poSearchData = value.map(obj => {
            let i = { ...obj };
            i.selected = true;
            i.productStatus = true;
            i.boxConditionDisabled = false;

            i.successText = '';
            i.errorText = '';
            i.Error = false;
            i.isSoftStop = undefined;
            i.warrantyCheck = undefined;

            i.isULTSoftStop = undefined;
            i.poValidated = undefined;
            i.isPoHistoryValid = undefined;
            i.warrentyValidated = undefined;

            i.isCPNChange = false;//CPN replacement changes
            i.CPN ='CPN-566-878'
            i.existingCPN = i.CPN;
            i.newCPN = '';
            return i;
        });
    }
    @api isPortal = false;
    @api casemode = 'Create';
    @api genericMessages;
    @api caserec;
    @api set requestdetails(value) {
        this.exchangeRequestdetails = { ...value }
    }

    @api set caseType(value) {
        let obj = { ...value }
        obj.remedy = 'Exchange';
        obj.serviceType = 'Technical';
        this.caseTypeFunctions = setCaseTypeDetails(obj.remedy, obj.serviceType, obj.returnReason)
    }
    @api receiptConditions;

    isLoading = true;
    PAGE_COORDINATES = r4c_CustomLabels.PAGE_COUNTER;
    labels = r4c_CustomLabels.labels;
    caseTypeFunctions;
    returnResonValue;
    technicalIntakeTable = {
        warrentyCheck: true
    }
    allselectedcheckbox = true;
    selectedInvoiceNum = [];
    valueTrue = true;

    @track poSearchData = [];
    @track returnReasonOptions = [];
    @track exchangeRequestdetails;
    @track pagination = {

        currentPage: 1,
        uiIndStart: 1,
        totalPages: 0,
        indStart: 0,
        indEnd: 0,
        totalRecords: 0,
        get isFirstPage() {
            return this.currentPage == 1
        },
        get isLastPage() {
            return this.currentPage == this.totalPages;
        }
    }

    get poSearchDataX() {
        this._processPaginationVariables();

        return this.poSearchData
            ?.map((item, index) => {
                let itemIndex = index + 1;
                item.page = this.PAGE_COORDINATES[itemIndex];
                item.itemNumber = itemIndex;
                return item;
            })
            ?.slice(this.pagination.indStart, this.pagination.indEnd) || []
    }
    get requestdetails() {
        return this.exchangeRequestdetails;
    }
    get lineItems() {
        return this.poSearchData;
    }
    get caseType() {
        return this.caseTypeFunctions;
    }
    get paginationNumberCss() {
        return (this.isPortal == true || this.isPortal == 'true') ? 'font-size: .6em' : 'line-height: 2em;';
    }
    get paginationHeaderCss() {
        return (this.isPortal == true || this.isPortal == 'true') ? 'font-size: .7em' : '';
    }
    get headerFontSize() {
        return (this.isPortal == true || this.isPortal == 'true') ? 'font-size: 1em' : '';
    }
    get isValidateDisabled() {
        const recordSelected = this.poSearchData.some(i => i.selected);
        return recordSelected == false || this.returnResonValue == undefined || this.isLoading;
    }
    get legendTextStyle() {
        if (this.isPortal) {
            return 'vertical-align: middle; font-size: .6em;';
        }
        return 'vertical-align: middle;'
    }

    get iconZoomlevel() {
        if (this.isPortal) {
            return 'zoom: 64%;padding-top: 4px;padding-left: 1%;padding-right: 1%;';
        }
        return 'zoom: 73%;'

    }
    @wire(graphql, {
        query: gql`
        query getReturnReasonsConditions($serviceTypeCode: String,$remedyTypeCode: String){
            uiapi {
                  query {
                    Sales_Issue_Customer_Return_Reason__c(
                    where: { 
                                Sales_Issue_Service_Type__r :{ Sales_Issue_Service_Type_Code__c :{ eq: $serviceTypeCode }},
                                 Sales_Issue_Remedy_Type__r :{ Sales_Issue_Remedy_Type_Code__c  :{ eq: $remedyTypeCode }},
                                Sales_Issue_Active_Indicator__c  : {eq : true} 
                            }
                        ){
                            edges {
                                node {
                                Id
                                Name {
                                    value
                                }
                                Sales_Issue_Return_Reason_Code__c{
                                    value
                                }
                                Sales_Issue_Service_Type__r {
                                    Id
                                    Name{
                                        value
                                    }
                                    Sales_Issue_Service_Type_Code__c{
                                        value
                                    }
                                }
                                 
                                Sales_Issue_Remedy_Type__r{
                                    Id
                                    Name{
                                        value
                                    }
                                    Sales_Issue_Remedy_Type_Code__c{
                                        value
                                    }
                                }
                            }
                        }
                    }
                  }
                }
              }
            `,
        variables: "$graphQlVariables"
    })
    wiredReturnReasonsConditions(result) {

        if (result.data) {
            let data = result.data?.uiapi?.query?.Sales_Issue_Customer_Return_Reason__c?.edges;
            if (data.length === 0) {
                return;
            }
            let oneRecord = data[0];

            let remedyDetails = {
                Sales_Issue_Remedy_Type_Code__c: oneRecord.node.Sales_Issue_Remedy_Type__r.Sales_Issue_Remedy_Type_Code__c.value,
                Name: oneRecord.node.Sales_Issue_Remedy_Type__r.Name.value,
                Id: oneRecord.node.Sales_Issue_Remedy_Type__r.Id,
            }
            this.exchangeRequestdetails.remedyDetails = remedyDetails;
            this.exchangeRequestdetails.remedyText = remedyDetails.Name;
            this.exchangeRequestdetails.Sales_Issue_Remedy_Type__c = remedyDetails.Id;
            this.exchangeRequestdetails.Sales_Issue_Service_Type__c = oneRecord.node.Sales_Issue_Service_Type__r.Id
            this.returnReasonOptions = data.map(i => {
                return {
                    label: i.node.Name.value,
                    value: i.node.Id,
                    code: i.node.Sales_Issue_Return_Reason_Code__c.value
                }
            });

        } else if (result.errors) {
            console.error('error ', result?.errors)
        }
        this.isLoading = false;
    }
    get graphQlVariables() {
        return {
            serviceTypeCode: '801',
            remedyTypeCode: 'EC'

        };
    }

    handleClose() {
        this.close(false)
    }
    handleReturnReason(event) {
        let selectedOption = this.returnReasonOptions.find(i => i.value == event.detail?.value);
        if (!selectedOption) {
            return
        }
        this.returnResonValue = selectedOption.value;

        this.exchangeRequestdetails.Sales_Issue_Return_Reason__c = selectedOption.value;
        this.exchangeRequestdetails.salesIssueReturnReason = selectedOption.label;
        this.exchangeRequestdetails.salesIssueReturnReasonCode = selectedOption.code;

    }
    handleWarrantyCheck() {

        if (!this.returnResonValue) {

            return;
        }
        let request = generateWarrantyRequestBody(this.poSearchData, this.exchangeRequestdetails, this.caseTypeFunctions, this.casemode, [], this.isPortal,caserec);

        let ultRequestList = [];
        //Syed - start - Optimization of code to support more then 600 requests - splitting request list into parts of 1000
        let splitCount = +this.genericMessages.Warranty_JS_Chunk_Size || 600;
        if (request.length > splitCount) {
            let spitRequestList = splitArrayIntoChunks(request, splitCount);
            ultRequestList = [];
            for (let i = 0; i < spitRequestList.length; i++) {
                ultRequestList.push(getWarrantyCheck({
                    reqString: JSON.stringify(spitRequestList[i])
                }));
            }
        }
        else {
            ultRequestList.push(getWarrantyCheck({
                reqString: JSON.stringify(request)
            }));
        }

        let acceptedWarrentyProductTypes = this.genericMessages?.valid_warranty_status_code?.split(',') || ['ACT'];
        let notAcceptedVizStatusTypes = this.genericMessages?.invalid_warrenty_viz_types?.split(',') || ['CAN', 'MCN', 'ECN'];
        let notAcceptingVizStatusCode = this.genericMessages?.invalid_warrenty_viz_code?.split(',') || ['PC', 'CME', 'INV', 'PIN', 'SIN'];
        let ComponentTypeCodeValue = 'S';
        this.isLoading = true;
        Promise.all(ultRequestList)

            .then(async (response) => {
                let { ultResponse, wihtoutUltResponse } = processWarrantyResponse(response, ultRequestList, []);

                //Syed - end - Optimization of code to support more then 1500 requests

                let todaysDate = new Date();

                let ewLines = [];

                this.poSearchData.filter(i => i.parentLineId == undefined).forEach((item) => {
                    if (item.selected && !item.warrentyValidated) {
                        if (!item.Soldto) item.Soldto = this.exchangeRequestdetails.selectedsoldToCMF;
                        //get response for ult
                        let itemWarrentyWithUniqueId = ultResponse.find(
                            (resp) => resp.ProdUniqueId && item.ult && resp.ProdUniqueId == item.ult && (resp.WarrantyTypeCode == 1 || resp.WarrantyTypeCode == '')
                        );
                        //get any extended items
                        ewLines = ultResponse.filter(
                            (resp) =>
                                resp.ProdUniqueId && item.ult && resp.ExtendedWarrantyStartDate && resp.ExtendedWarrantyEndDate
                                && resp.WarrantyTypeCode == 2 && resp.ProdUniqueId == item.ult
                        );
                        //prepare init object
                        item.warrantyCheck = {};
                        item.warrantyCheck.warrentyCheckDate = new Date();
                        if (this.casemode == "Edit" && item.warrantyResult.warrentyCheckDate) {
                            item.warrantyCheck.warrentyCheckDate = item.warrantyResult.warrentyCheckDate;
                        }
                        item.warrantyCheck.isCEPDaysValidValue = false;
                        item.warrantyCheck.isUnderWarrenty = false;
                        item.warrantyCheck.isUnderCEPDays = false;
                        item.warrantyCheck.isMMChange = false;
                        item.warrantyCheck.isCPNChange = false; // added for cpn Replacement logic
                        item.warrantyCheck.oldCPN = ''; // added for cpn Replacement logic
                        item.warrantyCheck.newCPN = ''; // added for cpn Replacement logic
                        item.warrantyCheck.isError = true;
                        item.warrantyCheck.isUltCorrect = false;
                        item.warrantyCheck.isExchangeValid = false;
                        item.warrantyCheck.isMRBQANValid = false;
                        item.warrantyCheck.isGRLExceptionValid = false;
                        item.warrantyCheck.creditElgiblityEndDate = "";
                        item.warrantyCheck.iSOutOfWarrenty = false;
                        item.warrantyCheck.isCanceled = false;
                        item.isSoftStop = false;
                        item.isULTSoftStop = false;
                        item.isInWarrenty = false;
                        item.productStatus = false;
                        item.selected = false;
                        item.Error = true;
                        item.errorText = r4c_CustomLabels.labels.TI_Warrenty_Invalid;
                        item.successText = 'success';
                        item.poValidated = false
                        item.isPoHistoryValid = false;
                        if (item.poHistoryData) delete item.poHistoryData;
                        let warrantyEndDate = '';
                        //process response
                        if (itemWarrentyWithUniqueId) {
                            //Temp
                            let cepCount = itemWarrentyWithUniqueId.CreditPeriodCount || 0;
                            if (typeof cepCount === 'string') cepCount = +cepCount;
                            let wepCount = itemWarrentyWithUniqueId.WarrantyPeriodCount || 0;
                            if (typeof wepCount === 'string') wepCount = +wepCount;
                            const isULTReponseError = itemWarrentyWithUniqueId.ErrorCode !== 0 || itemWarrentyWithUniqueId?.ComponentTypeCode === ComponentTypeCodeValue;
                            warrantyEndDate = new Date(itemWarrentyWithUniqueId.BaseWarrantyEndDate);
                            item.warrantyResult = itemWarrentyWithUniqueId;
                            //setting defaults
                            item.warrantyCheck.isUltCorrect = true;
                            item.ultDisabled = true;
                            item.warrantyCheck.isError = isULTReponseError || notAcceptedVizStatusTypes.includes(itemWarrentyWithUniqueId?.SourceSystemName?.trim());
                            item.warrantyCheck.isUltValid = acceptedWarrentyProductTypes.includes(itemWarrentyWithUniqueId?.ProdUniqueIdStatusCode?.trim());
                            item.warrantyCheck.isCEPDaysValidValue = cepCount != 0;
                            item.warrantyCheck.isCanceled = itemWarrentyWithUniqueId.ProdUniqueIdStatusCode != 'ACT';

                            //SYED - TWC4621-2141- checking ig ult type is VISID and part of same bag  
                            if (itemWarrentyWithUniqueId.ProdUniqueIdTypeCode === 'VISID') {
                                const { bagList } = this.exchangeRequestdetails;
                                const cmfList = JSON.parse(bagList);
                                let cmfIdsSet = new Set(cmfList.map(i => {
                                   // const bagAndCmf = i.split('-');
                                   const bagAndCmf = i.split('+000_');
                                    return bagAndCmf[1];
                                }));
                                cmfIdsSet.add(`${this.exchangeRequestdetails?.sales_Area__c?.Customer_Sales_Organization__r?.Customer_Sales_Organization_Code__c}_${this.exchangeRequestdetails?.sales_Area__c?.Customer_Disti_Channel__r?.Customer_Distribution_Channel_Code__c}_${this.exchangeRequestdetails?.selectedsoldToCMF}`);
                                if (!cmfIdsSet.has(`${itemWarrentyWithUniqueId?.SalesOrganizationCode}_${itemWarrentyWithUniqueId?.DistributionChannelCode}_${itemWarrentyWithUniqueId?.EnttlSoldToPartyId?.padStart(10, "0")}`)) {
                                    item.VisIdbagError = true;
                                    item.warrantyCheck.isError = true;
                                    item.lineitemStatus = this.genericMessages?.CPU_POH_Rejection; //TWC4621-2886

                                }
                            }
                            //Warrenty Check Logic

                            //calcuate cep 
                            item.warrantyCheck.creditElgiblityEndDate = new Date(itemWarrentyWithUniqueId.BaseWarrantyStartDate);
                            item.warrantyCheck.creditElgiblityEndDate.setDate(item.warrantyCheck.creditElgiblityEndDate.getDate() + cepCount);
                            item.warrantyCheck.isWarrentyCEPDaysValid = todaysDate <= item.warrantyCheck.creditElgiblityEndDate;
                            item.warrantyCheck.iSOutOfWarrenty = todaysDate >= item.warrantyCheck.creditElgiblityEndDate;
                            //calcuate wep
                            item.warrantyCheck.warrentyElgiblityEndDate = new Date(itemWarrentyWithUniqueId.BaseWarrantyStartDate);
                            item.warrantyCheck.warrentyElgiblityEndDate.setDate(item.warrantyCheck.warrentyElgiblityEndDate.getDate() + wepCount);
                            //FURQAN 1- In warrenty Status
                            //Check Warrenty Status - for exchange check warrenty and for other check cep

                            item.warrantyCheck.isUnderWarrenty = todaysDate <= warrantyEndDate && item.warrantyCheck.isCanceled == false && (ewLines.length > 0 ? true : wepCount != 0);
                            warrantyEndDate = getDateString(warrantyEndDate);
                            item.warrantyCheck.isExchangeValid = item.warrantyCheck.isUnderWarrenty;
                            if (item.warrantyResult && item.warrantyResult?.status) {
                                item.warrantyResult.status = (item.warrantyCheck.isUnderWarrenty) ? r4c_CustomLabels.labels.TI_Exchange_ValidUlt : r4c_CustomLabels.labels.TI_Exchange_INValidUlt;
                            }


                            //SOFT stop
                            if (notAcceptingVizStatusCode.includes(itemWarrentyWithUniqueId?.VizIdStatusCode?.toUpperCase())) {
                                item.isSoftStop = true;
                            }
                        }

                        item.isInWarrenty = item.warrantyCheck.isError == false &&
                            (((item.warrantyCheck.isWarrentyCEPDaysValid == true && item.warrantyCheck.isUltValid == true) ||
                                item.warrantyCheck.isUnderCEPDays == true) && item.warrantyCheck.isCEPDaysValidValue);

                        item.isInWarrenty = item.warrantyCheck.isExchangeValid;
                        item.warrantyCheck.isUnderWarrenty = item.warrantyCheck.isExchangeValid;
                        item.productStatus = item.isInWarrenty;
                        item.selected = item.isInWarrenty;
                        item.Error = !item.isInWarrenty;

                        //Bug Fix- for mm chaned warrenty valid only after user accepts
                        item.warrentyValidated = true;
                        if(item.isCPNChange === true){
                            item.warrentyValidated = false;
                        }
                        //Getting respective Error Msgs and Success Texts
                        item = this.getErrorMessages(item, itemWarrentyWithUniqueId, warrantyEndDate, ComponentTypeCodeValue, notAcceptedVizStatusTypes, notAcceptingVizStatusCode);
                        if (item.isInWarrenty) {
                            if (item.successText && item.successText != 'success' && item.successText != r4c_CustomLabels.labels.TI_Warranty_WTBD) {
                                //if succes text is set dont overrride
                            }
                            else if (item.warrantyCheck.isUnderCEPDays) {

                                item.isSoftStop = true;
                            }
                            else if (!item.warrantyCheck.creditElgiblityEndDate && item.isInWarrenty && itemWarrentyWithUniqueId) {

                                item.isSoftStop = true;
                            }
                        }
                    }
                });

            })
            .catch((error) => {
                console.error('error', error)
                this.showToast(r4c_CustomLabels.labels.Error_Title, r4c_CustomLabels.labels.Warranty_check_failed, "error")
            })
            .finally(() => {
                let childObj = this.template.querySelectorAll(
                    "c-r4c_-a-g_-line-items-result-row"
                );
                if (childObj) {
                    childObj.forEach((item) => {
                        item.refreshPopupFields();
                    });
                }
                this.isLoading = false;
            });
    }

    getErrorMessages(item, warrantyResponse, warrentyEndDate, componentTypeCodeValue, notAcceptedVizStatusTypes, notAcceptingVizStatusCode) {
        let agentErrMsgsLst = [];
        let portalErrMsgsLst = [];

        //Common Validations for all ULTs
        if (warrantyResponse?.ComponentTypeCode == componentTypeCodeValue) {
            agentErrMsgsLst.push(r4c_CustomLabels.labels.ULT_Component_Type_Code_ErrorMsg);
            portalErrMsgsLst.push(r4c_CustomLabels.labels.ULT_Component_Type_Code_ErrorMsg);
        }
        if (item.isCPNChange === true && !item.newCPN) {
            agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_CPN_Requried);
            portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_CPN_Requried);
            item.Error = true;
        }
        //VisID Validations
        if (warrantyResponse?.ProdUniqueIdTypeCode == 'VISID') { //All are Soft Stops
            if (item?.VisIdbagError == true) { //Setting new param to check for visId Bag error
                agentErrMsgsLst.push(r4c_CustomLabels.labels.VisIdULT_NotValidInBag_ErrMsg);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.VisIdULT_NotValidInBag_ErrMsg);
            }
            if (warrantyResponse.VizIdStatusCode == 'SIN') { //Visual Id status shd store SIN
                agentErrMsgsLst.push(r4c_CustomLabels.labels.VisIdULT_SIN_ErrMsg);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_WarrentyInvalid_VizId_ErrorMsg);
            }
            if (warrantyResponse.VizIdStatusCode == 'PIN') { //Visual Id status shd store PIN
                agentErrMsgsLst.push(r4c_CustomLabels.labels.VisIdULT_PIN_ErrMsg);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_WarrentyInvalid_VizId_ErrorMsg);
            }
            if (warrantyResponse.VizIdStatusCode == 'CME') { //Mostly not valid scenario, added code just in case
                agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_WarrentyInvalid_VizId_ErrorMsg);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_WarrentyInvalid_VizId_ErrorMsg);
            }
        }
        //Serial Number Validations
        if (warrantyResponse?.ProdUniqueIdTypeCode == 'SN') { //All are Hard Stops for agent/cust
            if (warrantyResponse.ProdUniqueIdStatusCode == 'IRC') { // Shd check warranty type code =0 (as said in document) but confirmed from EH team, we won't get code = 0 if ULT found in system
                agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_Warrenty_StatusCodeI_RCErrorMsg);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_IBASE_IRC_ErrorMsg);
            }
            else if (notAcceptedVizStatusTypes.includes(warrantyResponse?.ProdUniqueIdStatusCode?.toUpperCase())) { //Error Msg if status = CAN or ECN or MCN
                agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_Warrenty_SourceSystem_InvlaidErrorMsg);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_Warrenty_SourceSystem_InvlaidErrorMsg);
            }
        }
        //SOFT
        if (notAcceptingVizStatusCode.includes(warrantyResponse?.VizIdStatusCode?.toUpperCase())) {
            item.successText = (this.isPortal == true || this.isPortal == "true") ? r4c_CustomLabels.labels.TI_WarrentyInvalid_VizId_ErrorMsg : agentErrMsgsLst.join(';');
        }

        item.successText = (item.warrantyCheck.isExchangeValid) ? r4c_CustomLabels.labels.TI_Exchange_ValidUlt : r4c_CustomLabels.labels.TI_Exchange_INValidUlt;
        item.errorText = (item.warrantyCheck.isExchangeValid) ? r4c_CustomLabels.labels.TI_Exchange_ValidUlt : r4c_CustomLabels.labels.TI_Exchange_INValidUlt; // same message for portal and agent

        if (item.isInWarrenty) {
            if (item.successText && item.successText != 'success') {
                //if success text is set dont override
            }
            else if (item.warrantyCheck.isUnderCEPDays) { // under warranty end date + CEP days //Soft Stop
                item.successText = r4c_CustomLabels.labels.TI_Warranty_WTBD; // Need to update - Unable to determine warranty. Please ship the unit to the depot and warranty and entitlement will be determined upon receipt.
            }
            else if (!item.warrantyCheck.creditElgiblityEndDate && item.isInWarrenty && warrantyResponse) {
                item.successText = r4c_CustomLabels.TI_Inwarrenty_cepexpired; //Soft Stop //ULT is given and CEP date is empty
            }
            else if (item.isInWarrenty) {
                item.successText = StringFormatter.format(r4c_CustomLabels.labels.Warrenty_valid_till, warrentyEndDate);
            }
        }
        else if (!warrantyResponse) {
            agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_No_Warranty_Response);
            portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_No_Warranty_Response);
        }
        else if (item.Error) {
            if (agentErrMsgsLst.size > 0 && portalErrMsgsLst.size > 0) {//(item.errorText && item.errorText != tiMsgs.warrentyInvalid) {
                //if error text is set dont overrride
            }
            // else if (warrantyResponse?.ErrorCode == 16) {//(item.warrantyCheck.isError) {
            //     agentErrMsgsLst.push(r4c_CustomLabels.labels.Warranty_check_failed); // Not found or Warranty API down 
            //     portalErrMsgsLst.push(r4c_CustomLabels.labels.Warranty_check_failed);
            // }
            //SaiRam To handle EH API Error codes- TWC4621-5155 Start 
            else if (warrantyResponse?.ErrorCode == 1) {
                agentErrMsgsLst.push(r4c_CustomLabels.labels.R4C_API_Service_Unavailable); //One of Our API is down 
                portalErrMsgsLst.push(r4c_CustomLabels.labels.R4C_API_Service_Unavailable);
            }
            else if (warrantyResponse?.ErrorCode == 16) {
                agentErrMsgsLst.push(r4c_CustomLabels.labels.ULT_not_Found); // ULT Not found error.
                portalErrMsgsLst.push(r4c_CustomLabels.labels.ULT_not_Found);
            }
            //SaiRam To handle EH API Error codes- TWC4621-5155 End 
            else if (!item.warrantyCheck.isUnderWarrenty && warrantyResponse) {
                agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_Exchange_OW_ErrMsg);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_Exchange_OW_ErrMsg);
            }
            else if (!item.warrantyCheck.isUltValid && warrantyResponse) {
                agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_Warrenty_ULT_Invalid);
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_Warrenty_ULT_Invalid);
            }
            else if (!item.warrantyCheck.isCEPDaysValidValue) {
                agentErrMsgsLst.push(r4c_CustomLabels.labels.TI_CEP_Experied); // CEP date expired
                portalErrMsgsLst.push(r4c_CustomLabels.labels.TI_CEP_Experied);
            }
        }
        item.errorText = ((this.isPortal == true || this.isPortal == "true") && agentErrMsgsLst.length > 0 && portalErrMsgsLst.length > 0) ? [...new Set(portalErrMsgsLst)].join(';') : [...new Set(agentErrMsgsLst)].join(';');
        return item;
    }

    showToast(title, msg, err) {
        const selectEvent = new CustomEvent('toast', {
            detail: { title, msg, err }
        });
        this.dispatchEvent(selectEvent);
    }

    //Checkbox select handler Start
    handleSelectedList(event, isBulk, bulkSelectStatus) {
        this.enableSearchPONextBTN = false;
        //if bulk list is passed getting value for selected invoice in bulk
        let invoiceList = [];
        if (isBulk) {
            invoiceList = event;
            event = {};
            event.detail = {};
            event.detail.isChecked = bulkSelectStatus;
            this.selectedInvoiceNum = [];
            if (bulkSelectStatus) {
                this.selectedInvoiceNum = invoiceList;
            }
        }
        else {
            let isSelectedInvoiceNum = this.selectedInvoiceNum.includes(event.detail.invoiceNumber);
            if (!isSelectedInvoiceNum && event.detail.isChecked) {
                this.selectedInvoiceNum.push(event.detail.invoiceNumber);
            } else if (isSelectedInvoiceNum && event.detail.isChecked === false) {
                this.selectedInvoiceNum = this.selectedInvoiceNum.filter((item) => {
                    return item !== event.detail.invoiceNumber;
                });
            }
        }
        if (event.detail.isChecked == false) {
            this.allselectedcheckbox = false;
        }
        this.poSearchData = this.poSearchData.map((item) => {
            if (item.InvoiceNumber && (item.InvoiceNumber === event.detail?.invoiceNumber || invoiceList.includes(item.InvoiceNumber))) {
                item.selected = event.detail.isChecked;

            }
            return item;
        });


        if (this.poSearchData.length == this.poSearchData.filter(i => i.selected).length) {
            this.allselectedcheckbox = true;
        }

    }
    allSelectedHandler(event) {
        if (event.target.checked == true) {
            this.allselectedcheckbox = true;
        }
        if (event.target.checked == false) {
            this.allselectedcheckbox = false;
        }
        let invoiceList = this.poSearchData.map((item) => item.InvoiceNumber);
        this.handleSelectedList(invoiceList, true, event.target.checked);
    }
    //Checkbox select handler end
    //Pagination Start

    _processPaginationVariables() {
        // start - for pagination - CS
        let totalItems = this.poSearchData.filter(item => item.display == true)?.length || 0;
        if (totalItems != this.pagination.totalRecords) {
            this.pagination.totalRecords = totalItems;
            this.showSpinner = true;
            setTimeout(() => {
                this.showSpinner = false;
            }, 100);
        }
        this.pagination.totalPages = Math.ceil(this.pagination.totalRecords / RECORDS_PER_PAGE);
        this.pagination.indStart = (this.pagination.currentPage - 1) * RECORDS_PER_PAGE;
        this.pagination.uiIndStart = this.pagination.indStart + 1;
        this.pagination.indEnd = this.pagination.indStart + RECORDS_PER_PAGE;
        if (this.pagination.indEnd > this.pagination.totalRecords) {
            this.pagination.indEnd = this.pagination.totalRecords;
        }
        //end - for pagination - CS
    }
    goToNextPage() {
        this.showSpinner = true;
        if (this.pagination.currentPage < this.pagination.totalPages) {
            this.pagination.currentPage += 1;
        }

        setTimeout(() => {
            this._processPaginationVariables();
            this.showSpinner = false;
        }, 1000);
    }
    goToPreviousPage() {
        this.showSpinner = true;
        if (this.pagination.currentPage > 1) {
            this.pagination.currentPage -= 1;
        }

        setTimeout(() => {
            this._processPaginationVariables();
            this.showSpinner = false;
        }, 1000);
    }
    //Pagination End
}
