   /* ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    * @Description : Updates Line Item Status against a custom setting value for 'Pending Approval' based on the case status or another custom setting value for 'RMA Authorized'.
    * @param       : List<Customer_Sales_Issue_Request_Line__c> submitCaseLineItems, string caseStatus, Map<String,String> r4cCustomSettingsMap
    * @return      : void
    * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    */  
    private static void updateLineItemStatuses(List<Customer_Sales_Issue_Request_Line__c>  submitCaseLineItems, String caseStatus,Map<String,String> r4cCustomSettingsMap){
        for(Customer_Sales_Issue_Request_Line__c line:submitCaseLineItems){
            
            if(caseStatus == r4cCustomSettingsMap.get('Pending_Approval') ){
                line.Sales_Issue_Line_Item_Status__c = caseStatus;
            }
            else{
                line.Sales_Issue_Line_Item_Status__c = r4cCustomSettingsMap.get('Case_Status_RMA_Authorized');
            }
        }
        if (!submitCaseLineItems.isEmpty()) {
            R4C_DML_UtilClass.updateasUser(submitCaseLineItems);
        }
    }
