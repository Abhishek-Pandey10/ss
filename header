    private static R4C_API_MatricesGenericWrapper.CombinationsProcessIntermentResponse generateCombinations(List<List<String>> containerList,Map<integer,string> tupleIndex,Integer startingIndex,Integer totalCombinations) {
        R4C_API_MatricesGenericWrapper.CombinationsProcessIntermentResponse response=new R4C_API_MatricesGenericWrapper.CombinationsProcessIntermentResponse();
        List<R4C_API_MatricesGenericWrapper.BusinessRulesRequest> combinations = new List<R4C_API_MatricesGenericWrapper.BusinessRulesRequest>();
        
        if (containerList.isEmpty()) {
            //this will return back empty single combination as there was no multivalue request key present in request
            R4C_API_MatricesGenericWrapper.BusinessRulesRequest request=new R4C_API_MatricesGenericWrapper.BusinessRulesRequest();
            combinations.add(request);
            response.combinations=combinations;
            response.stopedIndex=1;
            return response;
        }
        R4C_API_MatricesGenericWrapper.BusinessRulesRequest obj=null;
        // Generate combinations
        for (Integer i = startingIndex; i < totalCombinations; i++) {
            response.stopedIndex=i;
            if(LIMITS.getCpuTime()<=MAX_CPU_TIME_LIMIT   && LIMITS.getHeapSize()<=MAX_HEAP_LIMIT ){
                obj=new R4C_API_MatricesGenericWrapper.BusinessRulesRequest();
                Integer quotient = i;
                for (integer j=0;j<containerList.size();j++) {
                    List<String> tupleList=containerList.get(j);
                    Integer tupleSize = tupleList.size(); 
                    Integer index =Math.mod( quotient,tupleSize);   
                    quotient /= tupleSize; 
                    mapMatrixBusinessRulesRequest(obj,tupleList,index,j,tupleIndex);
                } 
                
                combinations.add(obj);
                obj=null;
            }else{
                totalCombinations=i;
                break;
            }
        }
        response.combinations=combinations;
        return response;
    }
