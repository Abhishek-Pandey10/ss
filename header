  /*To save the case */
  async saveCase(recordTypeName) {
    let updatedLineItems = [];
    this.headerDataHandler();
    let caseStatus = (this.caseData?.Status == 'Draft' && this?.caseData?.Origin === 'ILM') ? 'RMA Authorized' : this.caserec.Status;
    if (this?.caseType?.isTechnicalExchange() && this.isSubmitted && this.collectionShippingDetails?.External_Case_ID__c && this.isPortal == false) {
      caseStatus = this.genericMessages.Case_Status_Closed;
    }

    if (this.refs.headerLineItems) {
      let changedLineItems = await this.refs?.headerLineItems?.retriveChangedLineItems();
      if (changedLineItems?.some(item => item?.disableSave == true)) { // TWC4621-4742,TWC4621-4789 -- if there are any validtion errors at line level, throwing an error
        this.showToast('Validation Errors', 'Please fix errors before submitting', 'error');
        return;
      }
      // Start -- Price change validation & processing
      const priceChangedItems = changedLineItems?.filter(item => item?.isCreditPriceInput && (item?.creditpricevalue === 0 || item?.creditpricevalue === '0'));
      if (priceChangedItems?.length > 0) {
        const missingReason = priceChangedItems?.some(item => !item?.reasonForChange?.trim());
        if (missingReason) {
          this.showToast(this.labels.Error_Title, 'Please update reason for change on all items', 'error');
          return;
        }
        // price change records
        const distiChannel = this.returnshippingdetails?.sales_Area__c?.Customer_Disti_Channel__r?.Customer_Distribution_Channel_Code__c || '';
        const priceChangeRecords = priceChangedItems?.map(item => {
          return {
            lineItemRecId: item?.Id,
            creditPrice: item?.creditpricevalue,
            RFPriceChange: item?.reasonForChange,
            YMS2Price: item?.creditpricevalue
          };
        });
        if (priceChangeRecords?.length > 0) {
          updatedLineItems = priceChangeRecords;
          caseStatus = this.caserec.Status;
        }
      }
      //End -- Price change validation & processing
      //Start -- Manohar -- TWC4621-3197 -- check if atleast one line item status changed to Cancel --  Manual Line Closure - Cancelled line items validation & processing After RMA Case Edit
      const cancelledItems = changedLineItems?.filter(item => item?.isLineStatusInput && item?.linestatus === 'Cancelled');
      if (cancelledItems?.length > 0) {
        const missingCancelInfo = cancelledItems?.some(item => !item?.linecancelreason?.trim() || !item?.linecanceljustification?.trim());
        if (missingCancelInfo) {
          this.showToast(this.labels.Error_Title, 'Please update reason for change on all items', 'error');
          return;
        }

        const hasUpdatedLineItems = Array.isArray(updatedLineItems) && updatedLineItems?.length > 0;
        const updatedItemsMap = hasUpdatedLineItems
