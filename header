        wrap.RemedyTypeCode=getListToStringValue(item.idRemedyTypeCodeList);
        wrap.CustomerId=getListToStringValue(item.idCustomerIdList);
        wrap.SalesOrganizationCode=getListToStringValue(item.idSalesOrganizationCodeList);
        wrap.DistributionChannelCode=getListToStringValue(item.idDistributionChannelCodeList);
        
        return wrap;
    }
    
    static string getListToStringValue(List<String> listToString) {
        
        String strValue = '';
        if (listToString.isEmpty()) {
            strValue = '';
        }
        else {
            strValue = String.join(listToString,';');
        }
        
        return strValue;
    }
    
    
    //Error Log
    public static void createErrorLog(Exception ex,String requestBody) {
        R4C_ErrorRecordServiceWrapperClass recordData = new R4C_ErrorRecordServiceWrapperClass();
        recordData.source = 'Business Rules API';
        recordData.exce = ex;
        recordData.origin = 'Mule';
        recordData.type = 'Integration/API error';
        recordData.erroredObjectName='Sales_Issue_Matrix__c';
        recordData.request=(requestBody.length()>131071)?requestBody.substring(0, 131071):requestBody;
        recordData.insertAsync=false;
        R4C_ErrorRecordService records = new R4C_ErrorRecordService();
        records.insertErrorRecord(recordData);
    }
    //Message Log	
    private static void createMessageLog(Integer statusCode,String requestBody, String responseBody,String matrixtype) {
        
        Sales_Issue_API_Message_Log__c messageLog = new Sales_Issue_API_Message_Log__c(); 
        messageLog.Sales_Issue_Status__c =statusCode==200? 'Success':'Failure';
        messageLog.Sales_Issue_Status_Code__c = String.valueOf(statusCode);
        messageLog.Sales_Issue_Source_API_Name__c = 'BusinessRules: '+matrixtype;
        messageLog.Sales_Issue_Request_Body__c=requestBody;
        messageLog.Sales_Issue_Response_Body__c=responseBody;
        insert as USER messageLog;
        
        //Insert Attachments
        String parentId = messageLog.id;    
        List<Attachment> Attachments = new List<Attachment>();
        Attachment requestAttachment = new Attachment();
        requestAttachment.ParentId = parentId;
        requestAttachment.Name = 'RequestBody-'+datetime.now();
        requestAttachment.Body = blob.valueOf(requestBody);
        requestAttachment.Description = '/' + 'RequestBody-'+datetime.now()+'.txt';
        Attachments.add(requestAttachment);
        
        Attachment responseAttachment = new Attachment();
        responseAttachment.ParentId = parentId;
        responseAttachment.Name = 'ResponseBody-'+datetime.now();
        responseAttachment.Body = blob.valueOf(responseBody);
        responseAttachment.Description = '/' + 'ResponseBody-'+datetime.now()+'.txt';
        Attachments.add(responseAttachment);
        
        insert Attachments;
        
        
    } 
    
