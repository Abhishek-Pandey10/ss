export default class R4c_AG_CaseHeaderLineItems extends NavigationMixin(LightningElement) {
  /*0$ price override */
  ECC_LINEITEM_STATUS_VALUE = ['Discrepant'];
  PIRCEOVERRIDE_VALID_STATUS = ['Discrepant'];
  VALID_PRIECE_OVERRIDE = r4c_CustomLabels.VALID_PRICE_OVERRIDE;
  PAGE_COORDINATES = r4c_CustomLabels.PAGE_COUNTER;
  @api isPriceOverrideEdit = false; //0$ price override
  @api isUserPriceMasked = false;
  isPriceMasked = false;
  @api isPortal = false; //Furqan
  @api caseType; //Furqan
  @api recordId;
  @api caseRecord;
  @api custompage = false;
  @api isShipmentTrackingPage = false;
  @api hideValidateEccLineItemsButton = false;
  @track showDuplicateMM = false;
  @api isECCLineItemEdit = false;
  @api isShowCN = false; // FOR CN SERACH
  @api isPriceMask = false; // FOR CN SEARCH
  @track genericmessages
  //TWC4621-3197 - Manohar -- Manual Line item closure After RMA Case Edit
  Manual_LineClousre_VALID_STATUS = ['Pickup Requested'];
  allowManualLineClosure = false;

  source = 'ViewSummary';
  lineItemsData = [];
  lineItemsLength;
  showcaselineitems = false;
  sortDirection = "asc";
  sortedBy = "name";
  sortOrder = "Asc";
  sortdirectionicon = true;
  sorticon = false;
  isLoading = true;
  records = [];
  shipto;
  channel;
  salesorg;
  caseNumber = '';
  labels = r4c_CustomLabels.labels; //Assigning custom labels to variable
  isULT = false;
  displayLineItems = "slds-section slds-is-open";
  @api isSubmitted = false;  //To indicate an order is submitted to ECC/is in Pending Approval status
  caserec;
  caseRecordType;
  salesIssueRequestRecord;//header record
  refreshContainerID;
  internalCustomerFlow = false;

  lineItemSummary = [];
  @api hideCancelOpenQtyButton = false;//Manohar -- TWC4621-3470 -- Subline Closure
  Subline_Closure_Status_Value = ['Reject RTC'];
  isPsgCase = false; //PSG Changes - Samuel

  get isShowSummary() {
    return this.lineItemSummary.length > 0;

  }

  rendered = false;
  renderedCallback() {
    if (this.rendered) return;
    this.applyStyle();

  }
  get legendTextStyle() {
    if (this.isPortal) {
      return 'vertical-align: middle; font-size: .6em;';
    }
    return 'vertical-align: middle;'
  }

  get iconZoomlevel() {
    if (this.isPortal) {
      return 'zoom: 64%;padding-top: 4px;padding-left: 0;padding-right: 0; width: 36px; height: 36px; text-align: center;';
    }

    return 'zoom: 73%;'

  }

  get showValidateECCItemsButton() {
    return !this.isPortal && !this.hideValidateEccLineItemsButton && this.arrayoflineitemsandpopupdata?.filter(i => this.ECC_LINEITEM_STATUS_VALUE.includes(i.linerowdata.linestatus) && +i.linerowdata.lineNumber >= 5000).length > 0 && !this.isPriceOverrideEdit;
  }
  get showCancelOpenQtyButton() {//Manohar -- TWC4621-3470 -- Subline Closure -- Hide and Show the cancel open quantity button
    return !this.isPortal && !this.hideCancelOpenQtyButton && this.arrayoflineitemsandpopupdata?.filter(i => !this.Subline_Closure_Status_Value.includes(i.linerowdata.linestatus) && +i.linerowdata.sumOfSubLineReceivedQty > 0 && +i.linerowdata.sumOfSubLineReceivedQty != i.linerowdata.returnquantity && +i.linerowdata.sumOfSubLineReceivedQty < i.linerowdata.returnquantity).length > 0 && this?.genericmessages?.Cancel_Open_Quantity;
  }

  applyStyle() {
    const style = document.createElement('style');
    style.innerText = `
      .design.orange-icon svg{
      fill:#fe9339;
      }
      .design.my-icon svg{
      fill:#0176D3
      }
      `;
    //applying styles dynamically to shadow dom elements
    let inputs = this.template.querySelectorAll('span.inputDesign');

    for (let div of inputs) {
      div.appendChild(style);
      this.rendered = true;
    }

  }


  // TWC4621-40 - 16-08-22 - Manohar Reddy - Call method to get Line item records based on case record Id
  async connectedCallback() {


    this.refreshContainerID = registerRefreshContainer(
      this.template.host,
      this.refreshContainer.bind(this),
    );
    await this.genericMsgs();
    this.CaseLineItems();

    if (this.isSubmitted) {
      this.displayLineItems = "slds-section slds-is-close";
    }
  }

  refreshContainer(refreshPromise) {
    return refreshPromise.then((status) => {
      if (status === REFRESH_COMPLETE) {
        this.arrayoflineitemsandpopupdata = [];
        console.log("Refresh without issues");
        this.CaseLineItems();
      } else if (status === REFRESH_COMPLETE_WITH_ERRORS) {
        console.warn("Refresh done, with issues refreshing some components");
      } else if (status === REFRESH_ERROR) {
        console.error("Major error with refresh.");
      }
    });
  }

  disconnectedCallback() {
    unregisterRefreshContainer(this.refreshContainerID);
  }

  //Exchange Remedy - Technical Intake
  get isTechnicalExchange() {
    return this?.caseRecordType?.isTechnicalExchange() || this?.caseRecordType?.remedy == 'Return Only';
  }
  get displayCPN() {
    return this?.caseRecordType?.isTechnicalExchange() || this.internalCustomerFlow;
  }
  get isMiscellaneousReturnOnly() { //TWC4621-2030  --Manohar
    return this?.caseRecordType?.remedy == 'Return Only' ? true : false;
  }


  /*get isInternalCustomerFlow() {
    return this?.caseRecordType
  }*/

  get creditPriceColumnName() { //Manohar
    return this.caseRecordType?.isExceptionRepair() ? this.labels.Sales_Price : this.labels.Credit_Price;
  }
  get netCreditValueColumnName() {
    return this.caseRecordType?.isExceptionRepair() ? this.labels.Net_Value : this.labels.Net_Credit_Value;
  }
  toggleSection(event) {
    if (event.currentTarget.dataset.id === 'lineItemsSection') {
      if (this.displayLineItems === "slds-section slds-is-close") {
        this.displayLineItems = "slds-section slds-is-open";
      } else {
        this.displayLineItems = "slds-section slds-is-close";
      }
    }
  }
  @track arrayoflineitemsandpopupdata = [];
  // Start TWC4621-40 - 16-08-22 - Manohar Reddy - Method to get Line item records based on case record Id
  CaseLineItems() {
    getCaseLineItems({
      caseId: this.recordId
    })
      .then(async (data) => {
        this.arrayoflineitemsandpopupdata = [];
        console.log('Lines data length-- ', data.length);// Delete this later
        if (data.length > 0) {
          data = data.filter(item => item.Sales_Issue_Line_Item_Status__c != 'Reject-CPU POH');
          // START - CN Search
          if (this.isShowCN === true) {
            data = data.filter(item => item.Customer_Sales_Issue_Request_Sublines__r);
          }
          // END - CN Search


          //BUG Fix - Undefined Value
          this.caserec = { CaseNumber: data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_CaseNumber__r?.CaseNumber };
          if (data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_SoldTo_Customer__r?.Customer_CPN_Support__c && data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_CaseNumber__r?.Origin === 'ILM' && data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_CaseNumber__r?.Status === 'Draft') {
            await this.fetchCPN(data);
          }
          //to determine internal customer flow
          this.internalCustomerFlow = (data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_CaseNumber__r?.Contact?.Name) ? false : true;
          //this.caseRecordType = { serviceType: data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Service_Type__r?.Name };
          this.caseRecordType = setCaseTypeDetails(data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Remedy_Type__r?.Name, data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Service_Type__r?.Name, data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Return_Reason__r?.Name);
          this.salesIssueRequestRecord = data[0]?.Sales_Issue_Cst_Return_Request_Number__r;
          this.isULT = this?.caseRecordType?.isTechnicalService() || this?.caseRecordType?.isQualityService() || (this.caseRecordType?.isExceptionService() && (this.caseRecordType?.isExceptionRepair() || this.caseRecordType?.returnReason === 'GRL Exception')) || this.caseRecordType?.returnReason === 'Free of Charge Sample' ? true : false; //For Showing ULT Template 
          //|| data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Service_Type__r?.Name === "Quality" || (this.caseRecordType?.isExceptionService() && (this.caseRecordType?.isExceptionRepair() || this.caseRecordType?.returnReason === 'GRL Exception'))
          let isIMF = data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Freight_Payment_Type__r?.Name === "Intel Managed Freight" ? true : false; //Changes to View Line Item Status - TWC4621-1133 - N Sandeep - 21/03/2023
          let caseObject = {};
          let isUnexpectedECCLineItem = false;
          let notAcceptingVizStatusCode = this.genericmessages?.invalid_warrenty_viz_code?.split(',') || ['PC', 'CME', 'INV', 'PIN', 'SIN'];

          //Masking Changes - Samuel
          this.isPriceMasked = false;
          if (this.isPortal == true || this.isPortal == 'true') {
            //const shipToMask = data[i].Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_SoldTo_Customer__r?.Customer_Ship_To_Price_Mask__c || false;
            //const soldToMask = data[i].Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_SoldTo_Customer__r?.Customer_Sold_To_Price_Mask__c || false;
            //this.isPriceMasked = this.isUserPriceMasked || shipToMask || soldToMask;

            let cmfMask = await this._fetchAndProcessMaskingData(data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_CaseNumber__r?.ContactId,
              data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_SoldTo_Customer__c,
              data[0]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_ShipTo_Customer__c);
            this.isPriceMasked = this.isUserPriceMasked || cmfMask;
          }
          //Masking Changes - Samuel - End

          for (let i = 0; i < data.length; i++) {

            caseObject = data[i].Sales_Issue_Cst_Return_Request_Number__r.Sales_Issue_CaseNumber__r;

            let sublines = data[i]?.Customer_Sales_Issue_Request_Sublines__r;

            let linerowdata = {
              isSubLinesOpen: false,
              isCreditPriceInput: false,
              successMessage: 'success',
              Id: data[i]?.Id,
              returnponumber: data[i]?.Sales_Issue_Cst_Return_PO_Number__c,
              lineNumber: data[i]?.Name, // Start TWC4621-987,TWC4621-987 - 13-02-23 - Samuel - Code for showing specific details for SR & Technical Intake in UI
              lineurl: "/" + data[i]?.Id,
              productcode: data[i]?.Sales_Issue_Item__r?.Item_Product_Code__c,
              returnquantity: data[i]?.Sales_Issue_Return_Quantity__c,
              serialnumber: data[i]?.Sales_Issue_Item_Serial_Number__c,
              sonumber: data[i]?.Sales_Issue_Sales_Order_Number__c,
              solinenumber: data[i]?.Sales_Issue_Sales_Order_Line_Number__c,
              loedate: getDateString(data[i]?.Sales_Issue_Last_Order_Entry_Date__c),
              EstimatedArrivalDate: getDateString(data[i]?.Sales_Issue_Estimated_Arrival_Date__c),
              confirmedPickupDate: getDateString(data[i]?.Sales_Issue_Confirmed_Pickup_Date__c),
              billingQuantity: data[i]?.Billing_Quantity__c,
              CPN: data[i]?.Sales_Issue_Customer_Part_Number__c,
              ULT: data[i]?.Sales_Issue_Prd_Unique_Id__c,
              //TWC4621-1093 - Agent/Portal UI-Shipment/Tracking APIs: Shipment information View in the case (Backend Logic) - Sandeep N
              billOfLading: data[i].Sales_Issue_Bill_of_Lading_Number__c,
              //TWC4621-1093 - Agent/Portal UI-Shipment/Tracking APIs: Shipment information View in the case (Backend Logic) - Sandeep N
              // TWC4621-687 - For line item level shipment tracking
              linestatus: data[i]?.Sales_Issue_Line_Item_Status__c,
              // CN Search
              invoiceNumber: data[i]?.Sales_Issue_Invoice_Number__c,
              showShipment: false,
              // Start TWC4621-738 - 13-12-22 - Samuel Nishant - To get line-item error messsages from Customer Sales issue line record
              error: false,
              errorMsg: data[i]?.Line_item_error_messages__c,
              //TWC4621-3197 - Manohar -- Manual Line item closure After RMA Case Edit
              isLineStatusInput: false,
              isShowReasonForLineStatus: false,
              originalLineStatus: data[i]?.Sales_Issue_Line_Item_Status__c,
              sumOfSubLineReceivedQty: data[i]?.Sales_Issue_Total_Subline_Received_Qty__c,//Manohar -- TWC4621-3470 -- Subline Closure
              oldMM: data[i]?.PSG_Old_MM__c, //PSG Changes - Samuel
              linecancelreason: data[i]?.Line_Cancellation_Reason__c || '', //SaiRam -- to display cancellation reason and justification for cancelled subline
              linecanceljustification: data[i].Line_Cancellation_Justification__c || '' //SaiRam -- to display cancellation reason and justification for cancelled subline
            };
            //Start - TWC4621-3197 - Manohar -- Manual Line item closure After RMA Case Edit
            if (!this.isPortal && this.custompage && this.Manual_LineClousre_VALID_STATUS?.includes(data[i]?.Sales_Issue_Line_Item_Status__c)) {
              linerowdata["isLineStatusInput"] = true;
              linerowdata["isShowReasonForLineStatus"] = true;
              linerowdata["SRallowanceId"] = data[i]?.Sales_Issue_Allowance_Matrix_Id__c;
              //linerowdata["receiptConditionId"] = data[i]?.Sales_Issue_Cst_Return_Receipt_Cnd__c;
              //linerowdata["receiptConditionRec"] = data[i]?.Sales_Issue_Cst_Return_Receipt_Cnd__r;
              this.allowManualLineClosure = true;
            }
            //End - TWC4621-3197 - Manohar -- Manual Line item closure After RMA Case Edit
            if (data[i]?.Line_item_error_messages__c != undefined && data[i]?.Line_item_error_messages__c.startsWith('Pending Reason:')) {
              linerowdata['isSoftStop'] = true;
              linerowdata['softMessage'] = data[i]?.Line_item_error_messages__c;
            }
            else if (data[i]?.Line_item_error_messages__c != undefined) {
              linerowdata["error"] = true;
              linerowdata["successMessage"] = data[i]?.Line_item_error_messages__c;
            }
            if (data[i]?.Sales_Issue_Line_Item_Status__c && data[i]?.Sales_Issue_Line_Item_Status__c === 'Deleted') {
              linerowdata["error"] = true;
              linerowdata["errorMsg"] = 'Deleted';
            }
            // End TWC4621-738 - 13-12-22 - Samuel Nishant - To get line-item error messsages from Customer Sales issue line record
            this.isPsgCase = this.isPsgCase || (data[i]?.PSG_Old_MM__c?.length > 1);//PSG Changes - Samuel
            // TWC4621-687 - For line item level shipment tracking
            //Changes to View Line Item Status - TWC4621-1133 - N Sandeep - 21/03/2023
            linerowdata["showShipment"] = (this?.isShipmentTrackingPage || this.isPortal) && isIMF === true && (linerowdata.linestatus === "In Transit" || linerowdata.linestatus === "Delivered");
            linerowdata["productcondition"] = (data[i]?.Sales_Issue_Cst_Return_Receipt_Cnd__c !== undefined) ? data[i]?.Sales_Issue_Cst_Return_Receipt_Cnd__r?.Name : '';

            if (this.isPriceMasked) {
              linerowdata["creditPrice"] = PRICE_MASK_STRING;
              linerowdata["netvalue"] = PRICE_MASK_STRING;
              linerowdata["unitprice"] = PRICE_MASK_STRING;
            }
            else {
              linerowdata["creditPrice"] = (data[i]?.Sales_Issue_Credit_Price__c) ? "$" + parseFloat(data[i]?.Sales_Issue_Credit_Price__c)?.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "$0";
              linerowdata["creditOriginalPrice"] = data[i]?.Sales_Issue_Credit_Price__c;//Sales_Issue_Disti_Price__c
              linerowdata["netvalue"] = (data[i]?.Sales_Issue_Net_Credit_Value__c != undefined) ? "$" + parseFloat(data[i]?.Sales_Issue_Net_Credit_Value__c)?.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "$0";
              linerowdata["netOriginalValue"] = data[i]?.Sales_Issue_Net_Credit_Value__c;
              linerowdata["unitprice"] = (data[i]?.Sales_Issue_PO_Price__c) ? "$" + parseFloat(data[i]?.Sales_Issue_PO_Price__c)?.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "$0";
              linerowdata['reasonForChange'] = data[i]?.Reason_for_Price_Change__c || '';
            }
            //Syed - EW adding padding for child elements
            linerowdata['isExtended'] = (data[i].Parent_Sales_Issue_Request_Line__c) ? true : false;
            linerowdata['parentId'] = data[i]?.Parent_Sales_Issue_Request_Line__c || '';
            if (data[i]?.Sales_Issue_Disti_Price__c == 0 && !(this.salesIssueRequestRecord?.Sales_Issue_Remedy_Type__r?.Name == 'Return Only')) { //TWC4621-2030 added Sales_Issue_Remedy_Type__r condition , for remedy "Return Only" always the price is zero 
              linerowdata['isSoftStop'] = true;
              let priceMsg = this.labels.YMS2Price_not_found;
              if (this?.caseRecordType.isAdminService() || data[i]?.Reason_for_Price_Change__c) {
                priceMsg = 'Price has been set to Zero';
              }
              linerowdata['softMessage'] = priceMsg;
            }

            if (data[i]?.Sales_Issue_Item__c !== undefined) {
              linerowdata["mmid"] = data[i]?.Sales_Issue_Item__r?.Name;
              linerowdata["mmRecordId"] = data[i]?.Sales_Issue_Item__c;//Manohar -- TWC4621-3470 -- Subline Closure
              linerowdata["productdescription"] =
                data[i]?.Sales_Issue_Item__r?.Item_Product_Description__c;
            } else {
              linerowdata["mmid"] = "";
              linerowdata["mmRecordId"] = "";
              linerowdata["productdescription"] = "";
            }

            if (data[i]?.Sales_Issue_Cst_Return_Request_Number__c !== undefined) {
              if (data[i]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_ShipTo_Customer__c !== undefined) {
                this.shipto = data[i]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_ShipTo_Customer__r?.Customer_Name__c; //TWC4621-1123 && TWC4621-1124 -- Accellor -- 17/03/2023 -- replaced NAme --> Customer_Name__c as part of data model changes
              } else {
                this.shipto = "";
              }
              if (data[i]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Sales_Organization__c !== undefined) {
                this.salesorg = data[i]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Sales_Organization__r?.Customer_Sales_Organization_Code__c;
              } else {
                this.salesorg = "";
              }
              if (data[i]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Distribution_Channel__c !== undefined) {
                this.channel = data[i]?.Sales_Issue_Cst_Return_Request_Number__r?.Sales_Issue_Distribution_Channel__r?.Customer_Distribution_Channel_Code__c;
              } else {
                this.channel = "";
              }
            } else {
              this.shipto = "";
              this.salesorg = "";
              this.channel = "";
            }
            let eachrecordpopupdata = !this.caseRecordType?.isTechnicalExchange() && !this.isMiscellaneousReturnOnly ? [
              {
                fieldlabel: this.labels.R4C_Invoice_Number,
                fieldvalue: data[i]?.Sales_Issue_Invoice_Number__c
              },
              {
                fieldlabel: this.labels.Customer_PO_Number,
                fieldvalue: data[i]?.Sales_Issue_Cst_PO_Number__c
              },
              {
                fieldlabel: this.labels.Debit_Reference_Number,
                fieldvalue: data[i]?.Sales_Issue_Debit_Reference_Nbr__c
              }
            ] : [];
            /*let opnField = [
              {
                fieldlabel: this.labels.OPN,
                fieldvalue: data[i]?.Sales_Issue_Order_Part_Number__c
              }
            ]
            eachrecordpopupdata = eachrecordpopupdata.concat(opnField);*/
            // Start TWC4621-987,TWC4621-987 - 13-02-23 - Samuel - Code for showing specific details for SR & Technical Intake in UI
            let srarr = [];
            if (this.caseRecordType?.isTechnicalService() || (this.caseRecordType?.isQualityService() && this.caseRecordType?.returnReason === 'FAC')) {


              let warrantyStatus = data[i]?.Sales_Issue_Warranty_Status__c;
              if (notAcceptingVizStatusCode.includes(data[i]?.Sales_Issue_Visual_Id_Status__c?.toUpperCase()) && (this.isPortal == true || this.isPortal == 'true')) {
                warrantyStatus = this.labels.TI_Warranty_WTBD;
              }

              //Adding ult type code in more info
              //For Technical case
              srarr = [
                {
                  fieldlabel: this.labels.R4C_Warranty_Status,
                  fieldvalue: warrantyStatus //data[i]?.Sales_Issue_Warranty_Status__c
                },
                {
                  fieldlabel: this.labels.R4C_Entitlement_Check_Date,
                  fieldvalue: getDateString(data[i]?.Sales_Issue_Warranty_Check_Date__c)
                },
                {
                  fieldlabel: this.labels.TI_ULT_Type_Code,
                  fieldvalue: data[i]?.Sales_Issue_Prod_Unique_Id_Status_Cd__c || ''
                }

              ];

              //TWC4621-2404 - Syed - adding view change on more info for warranty logic
              if (this.caseRecordType.isTechnicalExchange()) {
                srarr.push({
                  fieldlabel: this.labels.R4C_Warranty_End_date,
                  fieldvalue: getDateString(data[i]?.Sales_Issue_Warranty_EndDate__c)
                })
                linerowdata['successMessage'] = StringFormatter.format(this.labels.Warrenty_valid_till, getDateString(data[i].Sales_Issue_Warranty_EndDate__c));

              }
              else {
                srarr.push({
                  fieldlabel: this.labels.R4C_Credit_Eligibility_End_Date,
                  fieldvalue: warrantyStatus == 'Warranty to be Decided' ? '' : getDateString(data[i]?.Sales_Issue_Credit_Eligibility_End_Date__c)
                })
                linerowdata['successMessage'] = StringFormatter.format(this.labels.Warrenty_valid_till, getDateString(data[i].Sales_Issue_Credit_Eligibility_End_Date__c));
              }
            }
            //Bug fix - Samuel - Show WTBD for portal case edit based on VisId status
            //do not change warrenty to be decided to label as that will be translated and we store only english value in status field
            if (data[i]?.Sales_Issue_Warranty_Status__c?.toLowerCase() == 'Warranty to be Decided'.toLowerCase() || (notAcceptingVizStatusCode.includes(data[i]?.Sales_Issue_Visual_Id_Status__c?.toUpperCase()))) {
              //linerowdata['softMessage'] = data[i]?.Sales_Issue_Warranty_Status__c;
              linerowdata['softMessage'] = (this.isPortal == true || this.isPortal == 'true') ? this.labels.TI_Warranty_WTBD : linerowdata['successMessage'];
              linerowdata['isSoftStop'] = true;
            }

            eachrecordpopupdata = eachrecordpopupdata.concat(srarr);
