      ...this.collectionShippingDetails,
      ...this.collectionDetails
    };
    this.salesarea = this.collectionShippingDetails.sales_Area__c;

    let caseExtraDetails = {
      Sales_Issue_Service_Type__c: this.servicetyperec.Id
    };
    this.collectionShippingDetails = {
      ...this.collectionShippingDetails,
      ...caseExtraDetails
    };
    //TWC4621-811 -- Furqan
    this.caseType = setCaseTypeDetails(this.collectremedyText, this.servicetyperec.Name, this.collectionShippingDetails?.salesIssueReturnReason);
  }
