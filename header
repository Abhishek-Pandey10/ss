public with sharing class R4C_API_AsmblyCmpnntWrnty_ConsumingClass {
    
    /* ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    * @Description : Provides assembly warranty details API Response  
    * @param       : String serialNumber
    * @return      : String response body
    * ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    */
    
    @AuraEnabled
    public static String getAssemblyWarrantyDetails(String serialNumber) {
        String body='';
        try {
            String isIAOFlag = R4C_Generic_Configurations__c.getValues('isIaoFlag').Value__c; //IAO Changes - Samuel
            String iaoNCEndpoint = R4C_Generic_Configuration__c.getValues('NC_EH_Component_Assembly_IAO');
            R4C_APIGEE_Settings__mdt integrationSetting = R4C_APIGEE_Settings__mdt.getInstance('R4C_EH_CheckAssemblyComponent');
            String endPoint = Boolean.valueOf(isIAOFlag) ? iaoNCEndpoint : integrationSetting.Consuming_Class_Name__c; //IAO Changes - Samuel
            Http http = new Http();
            HttpRequest req = new HttpRequest();
            req.setMethod('GET');
            req.setEndpoint(endPoint+'?'+'serialNumber='+serialNumber);
            req.setHeader('Accept','application/Json');
            req.setHeader('Content-Type', 'application/json');
            HttpResponse res = http.send(req);
            body=res.getbody();
            //code added for storing API request and response details - start
            String transactionId = R4C_API_MessageLogAndAttachment.generateTransactionId();

            R4C_API_MessageLogAndAttachment.MessageLogWrapper msgLogWrpr = new R4C_API_MessageLogAndAttachment.MessageLogWrapper();
            msgLogWrpr.SourceAPIName = 'EH Component Assembly API';
            msgLogWrpr.StatusCode = String.valueOf(res.getStatusCode());
            msgLogWrpr.transactionId = transactionId;
            msgLogWrpr.requestBody = integrationSetting.Consuming_Class_Name__c+'?'+'serialNumber='+serialNumber;
            msgLogWrpr.responseBody = body;
            R4C_API_MessageLogAndAttachment.CreateMessageLogRecord(msgLogWrpr);
            //code added for storing API request and response details - end
            if (String.isEmpty(body)) {
                throw new AuraHandledException('API Failure Exception');
            }   
        }
        catch(exception ex){
            body = 'Error';
            final R4C_ErrorRecordServiceWrapperClass recordData = new R4C_ErrorRecordServiceWrapperClass();
            recordData.source = 'R4C_API_AsmblyCmpnntWrnty_ConsumingClass.getAssemblyWarrantyDetails';
            recordData.origin = 'Agent/Portal';
            recordData.request = 'serialNumber='+serialNumber;
            recordData.type = 'Integration/API error';
            recordData.errorMessage = 'EH Component Assembly API Error';
            final R4C_ErrorRecordService records = new R4C_ErrorRecordService();
            records.insertErrorRecord(recordData);    
        }
        return body;
    }
}
