    /*Start--TWC4621-60,TWC4621-61--Tulika--Functionality for Cancel button and close the popup*/
    // Closes modal and dispatches cancel event with previous address values
    // Modifies stateList, isModalOpen, zipError, zipClass and dispatches mycustomevent
    handleCancel() {
        this.stateList = [];
        this.isModalOpen = false;
        this.zipError = '';
        this.zipClass = '';
        //Start -- TWC4621-1009 -- Manohar -- 21st feb 2023 -- to retain the previous selected value if the user clicks cancel
        let previousValue = '';
        if (this.addType === this.genericmessages.Sales_Issue_Cst_Collection_Address__c) {
            previousValue = this.deleteAddressIds.includes(this.CollectionAddrsValue) ? '' : this.CollectionAddrsValue
        }
        else if (this.addType === this.genericmessages.Sales_Issue_Return_To_Cst_Address__c) {
            previousValue = this.deleteAddressIds.includes(this.returnToCustAddrsValue) ? '' : this.returnToCustAddrsValue
        }
        const selectEvent = new CustomEvent('mycustomevent', {
            detail: {
                mode: 'cancel',
                addType: this.addType,
                previousvalue: previousValue
            }
        });
        this.dispatchEvent(selectEvent);
        //End -- TWC4621-1009 -- Manohar -- 21st feb 2023 -- to retain the previous selected value if the user clicks cancel
    }
