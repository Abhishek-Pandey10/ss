  //Tushar Garg---TWC4621-19 -- Store Values of returnRequestDetails(shipping details)
  handleReturnRequest(event) {
    this.returnRequestDetails = event.detail;
    this.collectionShippingDetails = event.detail;    
    if (
      this.returnRequestDetails &&
      JSON.stringify(this.returnRequestDetails) !== "{}" &&
      ((this.collectionDetails &&
        JSON.stringify(this.collectionDetails) !== "{}") || this.returnRequestDetails.remedyText == this.genericMessages.Credit_NPR)
    ) {
      this.disableNextButton = false;      
    } else {
      this.showPOsearch = false;
      let pocmp;
      pocmp = this.template.querySelector("c-r4c_-a-g_-p-o-search");
      if (pocmp) {
        pocmp.handleReset();
      }
      this.hidecancelButton = true;
      this.hideNextButton = true;
      this.disableNextButton = true;
    }
    // TWC4621-1395 - Furqan - refreshing value of case type on remedy change
    this.caseType = setCaseTypeDetails(this.remedyValue, this.servicetyperec.Name, this.returnreasonText);
    this.collectremedyText = this.collectionShippingDetails.remedyText;
  }

