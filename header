    // Normalizes special characters in str by removing diacritical marks
    // Returns string with NFD normalization and diacritical marks removed using regex
    normalizeSpecialCharacters(str) {
        const normalized = str.normalize('NFD');
        const result = normalized.replace(/[\u0300-\u036f]/g, '');        
        return result;
    }

    // Debounces Google API search calls using setTimeout with 350ms delay
    // Clears existing debounceTimeout and sets new timeout to call calloutAutoCompleteAPI
    debounceGoogleSearch() {
        if (this.debounceTimeout) {
            clearTimeout(this.debounceTimeout);
        }
        this.debounceTimeout = setTimeout(() => {
          this.calloutAutoCompleteAPI();
        }, 350);
    }

    // Calls Google autocomplete API with street1, sessionKey, selectedCountrycode parameters
    // Modifies predictions, showPredictionList and sets input validation based on API response
    calloutAutoCompleteAPI() {
        const inputField = this.template.querySelector('.addressInput');
        inputField.setCustomValidity('');
        inputField.reportValidity();
        if (this.street1.trim().length > 0 && this.street1.trim().length > 2) {
