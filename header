    //TWC4621-4823 Google API call on change of street
    // Handles street1 input change and triggers Google API autocomplete with debouncing
    // Modifies street1, sessionKey and calls debounceGoogleSearch or calloutAutoCompleteAPI based on debounceGoogleAPIToggle
    handleStreet1Change(event) {
        this.street1 = event.detail.value;
        if (this.sessionKey === undefined || this.sessionKey === null) {
            this.sessionKey = this.generateRandomString();
        }
        // SaiRam TWC4621-5799 - Optimization for google API
        if (this.debounceGoogleAPIToggle) {
            this.debounceGoogleSearch();
        }else {
            this.calloutAutoCompleteAPI();
        }
    }

    // Handles address selection from Google predictions and fetches complete address details
    // Modifies street1, state, city, zip, street2 with parsed Google API address components
    handleSelectedAddress(event) {
