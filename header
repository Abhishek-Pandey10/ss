    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Method to insert case,crr,crr line items
* User-Story : TWC4621-54 & TWC4621-72 -- 26-08-2022
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* @author   Manohar
* @param    returnReqDetails,caseStatus  (wrapper record of type R4C_AG_ViewSummaryUtil.returnReqDetailsWrapper)
* @return   case, DESCRIPTION : inserting case,crr,crr line items
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/
    public static RecordInsertionWrapper insertR4CCaseUtil(returnReqDetailsWrapper returnReqDetails, String caseStatus) {
        Savepoint sp = Database.setSavepoint();

        try {
            recordTypeId = Schema.SObjectType.Case.getRecordTypeInfosByName().get(returnReqDetails.caserecTypeName).getRecordTypeId();
            List<Case> caseList = new List<Case>();
            List<Customer_Sales_Issue_Request__c> customerReturnRequestList = new List<Customer_Sales_Issue_Request__c>();
            List<Customer_Sales_Issue_Request_Line__c> customerReturnRequestLineList = new List<Customer_Sales_Issue_Request_Line__c>();
            List<Customer_Sales_Issue_Request_Line__c> customerReturnRequestLineListInserted = new List<Customer_Sales_Issue_Request_Line__c>();
            Boolean isNpr = false; 
            isQualityFAC = false;  
            checkIfisManualLineClouser(returnReqDetails);
            if (!String.isEmpty(recordTypeId) && returnReqDetails.CustomerReturnRequest != null ) {
                if(returnReqDetails.remedyDetails.Name == genericmsgs.get('Credit_NPR')) {
                    isNpr = true;
                    //final String incotermId = getIncoterm(returnReqDetails.CustomerReturnRequest);
                    // if(String.isNotEmpty(incotermId)) {
                    //     returnReqDetails.CustomerReturnRequest.Sales_Issue_InCo_Term__c = incotermId;
                    // }
                } 
                if(returnReqDetails?.caserecTypeName == genericmsgs.get('Quality_Intake') && returnReqDetails?.caseRec?.Origin == 'CQNR') {
                    isQualityFAC = true;    
                }
                caseList = R4C_ViewSummaryUtil.getCaseList(returnReqDetails,caseStatus);
                insertedcaseList = R4C_ViewSummaryUtil.insertCase(caseList);

                customerReturnRequestList = R4C_ViewSummaryUtil.getCustomerReturnRequest(returnReqDetails.CustomerReturnRequest,isNpr);
                setSubmitedDate(  returnReqDetails,  customerReturnRequestList,caseStatus);
                insertedcustomerReturnRequestList = R4C_ViewSummaryUtil.insertCustomerReturnRequest(customerReturnRequestList);

                customerReturnRequestLineListInserted = handleHeaderUpdate(  returnReqDetails,  customerReturnRequestLineList,  customerReturnRequestLineListInserted);
                 
                processRecordsForUI(  customerReturnRequestLineListInserted);
                updateAllowanceRecord(  returnReqDetails,  customerReturnRequestLineListInserted);
            }
        } 
       catch (DmlException e) {
            Database.rollback(sp);
            Database.releaseSavepoint(sp);
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_ViewSummaryUtil.insertR4CCaseUtil',e.getMessage(),e,true);
            recordsToBeInsertedInUI.errorMessageOfDmlOperation = recordsToBeInsertedInUI.errorMessageOfDmlOperation + ' + ' + e.getMessage() + e.getDmlFieldNames(0);
            //throw new AuraHandledException('R4C_AG_ViewSummaryUtil : ' + e.getMessage());

        }
        catch (Exception e) {
            Database.rollback(sp);
            Database.releaseSavepoint(sp);
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_ViewSummaryUtil.insertR4CCaseUtil', e.getMessage(), e,true);
            recordsToBeInsertedInUI.errorMessageOfDmlOperation = recordsToBeInsertedInUI.errorMessageOfDmlOperation + ' + ' + e.getMessage();
            //throw new AuraHandledException('R4C_AG_ViewSummaryUtil : ' + e.getMessage());

        }
        return recordsToBeInsertedInUI;
    }
    
    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Method preparing case data and returning caseList
* User-Story : TWC4621-54 & TWC4621-72
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* @author   Manohar
* @param    returnReqDetails,caseStatus  (wrapper record of type R4C_AG_ViewSummaryUtil.returnReqDetailsWrapper)
* @return   List<Case>, DESCRIPTION : preparing case data and returning caseList
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/
    public static List<Case> getCaseList(returnReqDetailsWrapper returnReqDetails,String caseStatus) {
        List<Case> caseList = new List<Case>();
        Case objCase = new Case();
        String caseOrigin = '';
        if (returnReqDetails.caseRec == null) {
            R4C_ViewSummaryUtilHelper.getCaseListPart1(  objCase,  returnReqDetails,  caseStatus,  RecordTypeId,  caseOrigin);
            R4C_ViewSummaryUtilHelper.getCaseListPart2(  objCase,  returnReqDetails,  caseStatus,  RecordTypeId,  caseOrigin);
            R4C_ViewSummaryUtilHelper.getCaseListPart3(  objCase,  returnReqDetails,  caseStatus,  RecordTypeId,  caseOrigin);
            R4C_ViewSummaryUtilHelper.getCaseListPart4(  objCase,  returnReqDetails,  caseStatus,  RecordTypeId,  caseOrigin);
            R4C_ViewSummaryUtilHelper.getCaseListPart5(  objCase,  returnReqDetails,  caseStatus,  RecordTypeId,  caseOrigin);
        } 
        else {
            objCase = returnReqDetails.caseRec;
            objCase.status = caseStatus;
            R4C_ViewSummaryUtilHelper.getCaseListPart5(  objCase,  returnReqDetails,  caseStatus,  RecordTypeId,  caseOrigin);
            //Manohar
            if (!String.isEmpty(returnReqDetails.comments) ) {
                objCase.Description = returnReqDetails.comments;
            }
            //Case Feed Tracking Notes
            R4C_FeedItem_Controller.FeedItemWrapper feedTrackingWrapper = new R4C_FeedItem_Controller.FeedItemWrapper();
        	feedTrackingWrapper.newValue = returnReqDetails?.comments;
        	feedTrackingWrapper.recordId = returnReqDetails?.caseRec?.Id;
        	//R4C_FeedItem_Controller.InsertOldCaseFeedItem(feedTrackingWrapper); //Commented due to errors
        }
        caseList.add(objCase);
        return caseList;
    }
    
    
