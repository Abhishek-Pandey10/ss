-->
<template>
    <!-- Start---TWC4621-979,990---Tushar Garg---02-02-2023--Reusable Component for lookupFilter -->
    <div>
        <lightning-spinner if:true={isLoading} alternative-text={labels.R4C_Loading} variant="brand" size="medium">
        </lightning-spinner>
        <div class={formElementClass}>
            <label if:false={isLabelHidden} class="slds-form-element__label" for="selectedInput">
                <abbr aria-required="true" if:true={isRequired} class="slds-required" title="required">*</abbr>
                {label}
            </label>
            <div class="slds-form-element__control">
                <div class="slds-combobox_container">

                    <div id="box" class={boxClass} role="combobox">
                        <div class="slds-combobox__form-element slds-input-has-icon slds-input-has-icon_right"
                            role="none">
                            <template if:true={isValueSelected}>
                                <div class="slds-pill-container lookupPill">
                                    <div class="slds-grid-custom cPill">
                                        <div class="cIcon slds-grid-custom" style="overflow:hidden">
                                            <lightning-icon icon-name={iconName} alternative-text={selectedName}
                                                size="small"></lightning-icon>
                                            <!-- added slds-truncate ,style,title as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address -->
                                            <div class="slds-p-left_small slds-truncate"
                                                title={selectedName}>
                                                {selectedName}
                                            </div>
                                        </div>
                                        <div class="closeIcon">
                                            <lightning-button-icon tabindex="0" icon-name="utility:close"
                                                alternative-text={selectedName} aria-label={selectedName}
                                                onclick={handleRemovePill} size="small" variant="bare">
                                            </lightning-button-icon>
                                        </div>
                                    </div>
                                </div>
                            </template>
                            <template if:false={isValueSelected}>
                                <div class="slds-p-top_none">
                                    <lightning-input aria-haspopup="listbox" aria-required={isRequired}
                                        aria-expanded={ifDisplayOptions} tabindex="0" label={label} combobox
                                        class={inputClass} type="Text" id="selectedInput" value={searchTerm}
                                        onclick={handleClick} onkeyup={handleInputEvent} onblur={onBlur}
                                        onchange={onChange} variant="label-hidden" autocomplete="off"
                                        placeholder={labels.R4C_Select_one} disabled={disabled}>
                                    </lightning-input>
                                    <lightning-icon tabindex="-1" aria-describedby="selectedInput"
                                        icon-name="utility:search" alternative-text="Utility search" title="search"
                                        class="icon-style" size="xx-small" onclick={getCMFRecords}></lightning-icon>
                                </div>
                            </template>
                        </div>
                        <div class="slds-dropdown slds-dropdown_length-with-icon-7 slds-dropdown_fluid">
                            <ul class="slds-listbox slds-listbox_vertical" role="listbox">
                                <template if:true={ifDisplayOptions}>
                                    <template for:each={displayOptions} for:item="record">
                                        <li key={record.value} onmouseleave={onRecordleave} onmouseover={onRecordHover}
                                            onclick={onSelect} data-id={record.value} role="option" title={record.label}
                                            data-name={record.label}>
                                            <span class={record.class} title={record.label}>
                                                <lightning-icon class="slds-icon slds-icon--small" icon-name={iconName}
                                                    alternative-text={objName} size="small"></lightning-icon>
                                                <span title={record.label} class="slds-truncate">{record.label}</span>
                                            </span>
                                        </li>
                                    </template>
                                </template>
                                <template if:false={ifDisplayOptions}>
                                    <span class="slds-lookup__item-action slds-lookup__item-action--label"
                                        role="option">

                                    </span>
                                </template>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End---TWC4621-979,990---Tushar Garg---02-02-2023--Reusable Component for lookupFilter -->
</template>
