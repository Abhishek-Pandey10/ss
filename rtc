    // TWC4621-1395 - Furqan - checking if exchange // Modifying to add Collection address for NPR - Samuel
    get isExchngOrNPRView() {
        return (((this?.caseType?.serviceType == 'Technical' || this?.caseType?.serviceType == 'Technical Intake') && this?.caseType?.remedy == 'Exchange') || (this?.caseType.isTechnicalNPRCredit !== undefined && this?.caseType.isTechnicalNPRCredit()));
    }
    get showFullView() {
        if (this?.isExchngOrNPRView) { //NPR Changes & Exchange Intake - Samuel
                return false;
        }
        else if (this?.caseType?.serviceType == this.genericMessages.Quality) {
            if (this.isEdit && this?.caseType?.remedy == this.genericMessages.Credit && this?.caseDetails?.Sales_Issue_Return_Reason__r?.Name == this.genericMessages.FAC) {
                return false;
            }
        }
        return true;
    }
    get qualityFACView() {
        return (this.isEdit && this?.caseType?.serviceType == this.genericMessages.Quality && this?.caseDetails?.Sales_Issue_Return_Reason__r?.Name == this.genericMessages.FAC);
    }
    get isRepairRemedy() {
        return this?.caseType?.serviceType == this.genericMessages.Exception && this.caseType?.isExceptionRepair();
    }

    get isExcpDRRView() {
        return this?.caseType?.serviceType == this.genericMessages.Exception && this.caseType?.isExceptionRepair() && this.caseType.returnReason == 'Direct Return Repair';
