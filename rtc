    //Direct and INdirect Return Reason
    async fetchEmailId(event) {
        let wwid = event.detail.value;
        let fieldName = event?.target?.dataset?.name;
        if (event?.target?.dataset?.name === 'Sales_Issue_Approved_WWID__c') {
            this.Sales_Issue_Approved_WWID__c = wwid;
            this.Sales_Issue_Approval_Email_Address__c = '';
        } else if (event?.target?.dataset?.name === 'Sales_Issue_BU_Technical_Contact_WWID__c') {
            this.Sales_Issue_BU_Technical_Contact_WWID__c = wwid;
            this.Sales_Issue_BU_Technical_Contact_Email__c = '';
        }
        if (wwid.length >= 8) {
            this.isLoading = true;
            await getEmailIdWorkerApi({ approverIds: wwid })
                .then((workerResult) => {
                    console.log('getEmailIdWorkerApi Result', workerResult);
                    this.isLoading = false;
                    if (workerResult.responseData != undefined && workerResult.responseData.elements.length >= 1) {
                        workerResult?.responseData?.elements.map((item) => {

                            if (item?.CorporateEmailTxt != null) {
                                fieldName == 'Sales_Issue_Approved_WWID__c' ? this.Sales_Issue_Approval_Email_Address__c = item?.CorporateEmailTxt : this.Sales_Issue_BU_Technical_Contact_Email__c = item?.CorporateEmailTxt
                            } else {
                                this.showToast(this.genericMessages.Error_Title, this.genericMessages.Invalid_WWID, 'error', 'dismissable');
                            }

                        })
                    } else if (workerResult.responseData != undefined && workerResult.responseData.elements.length == 0) {
                        this.showToast(this.genericMessages.Error_Title, this.genericMessages.Invalid_WWID, 'error', 'dismissable');
                    }
                    else if (workerResult?.isSuccess === false) {
                        this.showToast(this.genericMessages?.Error_Title, this.genericMessages?.Worker_API_ErrorMsg, 'error', 'dismissable')
                    }

                })
                .catch(e => {
                    this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error", "dismissable"); //Added as part of Failure Handling - TWC4621-3040
                })
        }
        this.validate();
    }

    setFreightTypeOptionsForRepair() {
        this.freightTypeGeoMap = new Map();

        if (this.freightypesMap !== undefined) {
            let options = [];
            if (this.caseType?.isQualityService() && this.qualityFACView) {//TWC4621-2460

                const MNBoption = {
                    'label': this.genericMessages.Manual_Booking_By_Agent,
                    'value': this.freightypesMap.get(this.genericMessages.Manual_Booking_By_Agent)
                }
                options.push(MNBoption);
                this.freightTypeGeoMap.set(MNBoption.value, this.genericMessages.Manual_Booking_By_Agent);
            }
            if (this.caseType.isExceptionRepair()) {
                const IMFoption = {
                    'label': this.genericMessages.Intel_Managed_Freight,
                    'value': this.freightypesMap.get(this.genericMessages.Intel_Managed_Freight)
                }
                options.push(IMFoption);
                this.freightTypeGeoMap.set(IMFoption.value, this.genericMessages.Intel_Managed_Freight);
            }
            const CRFoption = {
                'label': this.genericMessages.Customer_Routed_Freight,
                'value': this.freightypesMap.get(this.genericMessages.Customer_Routed_Freight)
            }
            options.push(CRFoption);
            this.freightTypeGeoMap.set(CRFoption.value, this.genericMessages.Customer_Routed_Freight);
            this.freightTypeOptions = options;

            if (this.freightTypeOptions.length === 1 || (this.isEdit && this.returnRequest.Sales_Issue_Freight_Payment_Type__c && !event) || this.issueRequestRec != undefined) {
                if (this.isEdit) {
                    this.freightTypeValue = !event ? this.returnRequest.Sales_Issue_Freight_Payment_Type__c : this.freightTypeOptions[0].value;
                } else if (!this.isEdit) {
                    if (this.issueRequestRec?.Sales_Issue_Freight_Payment_Type__c && this.freightTypeGeoMap.get(this.issueRequestRec.Sales_Issue_Freight_Payment_Type__c) && !event) {
                        this.freightTypeValue = this.issueRequestRec?.Sales_Issue_Freight_Payment_Type__c;
                    }
                    if (this.freightTypeOptions.length === 1) {
                        this.freightTypeValue = this.freightTypeOptions[0].value;
                    }
                }
                let freightTypeName = this.freightTypeGeoMap.get(this.freightTypeValue);

                if (this.isEdit && !event) {
                    this.handleFreightvalues(freightTypeName)
                } else {
                    this.handleFreightTypeChange(event);
                }
            } else if (this.freightTypeOptions.length === 0) {
                this.showToast(this.labels.Error_Title, this.labels.No_Freight_Type_Found, 'error', 'dismissable');
            }
        } else {
            this.showToast(this.labels.Error_Title, this.labels.No_Freight_Type_Found, 'error', 'dismissable');
        }
    }
    //Start -- RepairSite -- TWC4621-1944
    setRepairSiteAddrsOptions() {

        if (this?.collectionDetailsData?.returnLocation?.Sales_Issue_Return_Location_Plant__c) {

            this.returnLocation = this?.collectionDetailsData?.Sales_Issue_Return_Location_Plant__r?.Name;
            this.returnlocationId = this?.collectionDetailsData?.returnLocation?.Sales_Issue_Return_Location_Plant__c;
        }
        let repairSiteAddrsData = this?.collectionDetailsData?.repairSitelst;
        this.repairSiteMap = new Map();
        if (repairSiteAddrsData !== undefined) {
            let options = [];
            repairSiteAddrsData.map(rec => {
                let repairSiteAddrs = rec?.Service_Site_Name__c;//this.getAddressRecord(rec);
                let option = {
                    'label': repairSiteAddrs,
                    'value': rec.Id
                }
                options.push(option);
                this.repairSiteMap.set(rec.Id, rec);
            })
            this.repairSiteOptions = options;
            if (this.repairSiteOptions.length === 1 || (this.isEdit && this.returnRequest?.Sales_Issue_Repair_Site__c && !event) || this.issueRequestRec != undefined) {
                if (this.isEdit && !event) {
                    this.repairSiteValue = this.returnRequest?.Sales_Issue_Repair_Site__c;
                } else if (!this.isEdit) {
                    if (this.issueRequestRec?.Sales_Issue_Repair_Site__c && this.repairSiteMap.get(this.issueRequestRec?.Sales_Issue_Repair_Site__c) && !event) {
                        this.repairSiteValue = this.issueRequestRec?.Sales_Issue_Repair_Site__c;
                    }
                }
                if (this.repairSiteOptions.length === 1) {
                    this.repairSiteValue = this.repairSiteOptions[0].value;
                }
                if (this.repairSiteValue) {
                    this.handleRepairSite(event);
                    this.template.querySelector('c-r4c_-a-g_-reusable-lookup')?.repairSiteOptions(this.repairSiteValue, this.repairSiteOptions);
                }
            }
            if (this.repairSiteOptions.length === 0) {
                this.showToast(this.labels.Error_Title, 'No Repair Site Found', 'error', 'dismissable');
            }
        } else {
            this.showToast(this.labels.Error_Title, 'No Repair Site Found', 'error', 'dismissable');
        }
    }
    handleRepairSite(event) {
        if (event && event?.target?.dataset?.name === this.genericMessages.Sales_Issue_Repair_Site_Add__c) {
            this.repairSiteValue = event.detail;//event.detail.value;
            this.repairSiteConOptions = [];
            this.plant_Repair_QSC_Contact = '';
        }
        let repairSiteConData;
        if (this.repairSiteValue) {
            repairSiteConData = this.collectionDetailsData.addressConMap[this.repairSiteValue];
        }
        if (repairSiteConData) {
            let options = [];
            let repairSiteConMap = new Map();
            repairSiteConData.map(rec => {
                if (rec.Name) {
                    const option = {
                        'label': rec.Name,
                        'value': rec.Id
                    }
                    options.push(option);
                    repairSiteConMap.set(rec.Id, rec);
                }
            })
            this.repairSiteConOptions = options;
            if (this.repairSiteConOptions.length === 1 || (this.isEdit && this.returnRequest.Plant_or_QSC_or_Repair_Site_Contact__c && !event) || this.issueRequestRec != undefined) {
                if (this.isEdit) {
                    this.plant_Repair_QSC_Contact = !event ? this.returnRequest.Plant_or_QSC_or_Repair_Site_Contact__c : this.repairSiteConOptions[0].value;
                } else if (!this.isEdit) {
                    if (this.issueRequestRec?.Plant_or_QSC_or_Repair_Site_Contact__c && repairSiteConMap.get(this.issueRequestRec.Plant_or_QSC_or_Repair_Site_Contact__c) && !event) {
                        this.plant_Repair_QSC_Contact = this.issueRequestRec?.Plant_or_QSC_or_Repair_Site_Contact__c;
                    }
                    if (this.repairSiteConOptions.length === 1) {
                        this.plant_Repair_QSC_Contact = this.repairSiteConOptions[0].value;
                        this.handlerepairSiteContact();
                    }
                }
            } else if (this.repairSiteConOptions.length === 0) {
                this.showToast(this.labels.Error_Title, this.genericMessages?.No_Repair_Site_Contact, 'error', 'dismissable');
            }
        } else if (this.repairSiteValue) {
            this.showToast(this.labels.Error_Title, this.genericMessages?.No_Repair_Site_Contact, 'error', 'dismissable');
        }
        this.validate();
    }
    handlerepairSiteContact(event) {
        if (event && event?.target?.dataset?.name == this.genericMessages.Sales_Issue_Repair_Site_Contact__c) {
            this.plant_Repair_QSC_Contact = event?.target?.value;
        }
        this.validate();
        if (this.plant_Repair_QSC_Contact) {
            this.hideErrorMessages(this.genericMessages.Sales_Issue_Repair_Site_Contact__c, this.plant_Repair_QSC_Contact);
        }
    }
