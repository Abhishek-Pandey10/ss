    /*start -- this method will be invoked from parent component once return reason has the value to get collecton data*/
    @api
    fetchCollectionData(ShippingDetailsData, servicetype) {
        this.ShippingDetails = ShippingDetailsData;//shipping details data
        this.collectionWrapper.remedy = ShippingDetailsData.Sales_Issue_Remedy_Type__c;//collection wrapper is used as parameter to get the data from apex
        this.collectionWrapper.returnreason = ShippingDetailsData.Sales_Issue_Return_Reason__c;
        this.collectionWrapper.serviceType = servicetype;
        this.collectionWrapper.cmfid = ShippingDetailsData.Sales_Issue_SoldTo_Customer__c;
        this.collectionWrapper.salesarea = ShippingDetailsData.Sales_Issue_Sales_Organization__c;
        this.collectionWrapper.returnReasonName = ShippingDetailsData?.salesIssueReturnReason;
        //apex calling
        getCollectionData({ CollectionReqWrapper: this.collectionWrapper })
            .then((data) => {
                console.log('fetchCollectionData', data);
                 if (data?.errorMessage) {
                     throw new Error(data.errorMessage);
                }
                this.collectionDetailsData = data;
                //TWC4621-1395 - Furqan - for exchange only address is needed
                if (this?.isExchngOrNPRView) { //NPR Changes - Samuel
                    this.isCollectionAddressTrue = true;
                    this.setCollectionAddrsOptions()
                } else if (this.caseType.isQualityService() && this.qualityFACView) {
                    getFreightTypes({})
                        .then((data) => {
                            if (data) { //all freighttypes irrespective of GEO
                                data.forEach((element) => {
                                    this.freightypesMap.set(element.Name, element.Id);
                                });
                            }
                            this.setFreightTypeOptionsForRepair();
                        })
                        .catch(e => {
                            this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error", "dismissable"); //Added as part of Failure Handling - TWC4621-3040
                        })
                }
                else {
                    this.setReturnToCustAddrsOptions();  //TWC4621-1009 -- Accellor -- -- 23rdfeb 2023 -- method for preparing RTC Address options
                }
                if (this?.caseType?.returnReason == 'Direct Return Repair') {  //TWC4621-1944 -- Repair Site
                    this.setRepairSiteAddrsOptions();
                }
            })
            .catch(e => {
                this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error", "dismissable"); //Added as part of Failure Handling - TWC4621-3040
            })
    }
    /*End -- this method will be invoked from parent component once return reason has the value to get collecton data*/

    /*Start -- preparing the options of RTC address to show in the UI*/
    setReturnToCustAddrsOptions(event) {
        let ReturnToCustAddrsdata = this.collectionDetailsData.RTCAddrs;
        if (ReturnToCustAddrsdata !== undefined) {
            let options = [];
            ReturnToCustAddrsdata.map(rec => {
                let RTCAddrs = this.getAddressRecord(rec);
                if (RTCAddrs && rec.Customer_Country__r.Name) {
                    let option = {
                        'label': RTCAddrs,
                        'value': rec.Id
                    }
                    options.push(option);
                    this.RTCAddrsMap.set(rec.Id, rec);//added by manohar on 8th feb 2023 regarding embargo country code
                }
            })
            this.returnToCustAddressOptions = options;
            if (this.returnToCustAddressOptions.length === 1 || (this.isEdit && this.returnRequest?.Sales_Issue_Return_To_Cst_Address__c /* && !event*/) || this.issueRequestRec != undefined) { //Commented !event for Bug fix RTC contact
                if (this.isEdit && !event) {//Bindhu
                    this.returnToCustAddrsValue = this.returnRequest?.Sales_Issue_Return_To_Cst_Address__c;
                } else if (!this.isEdit) {
                    if (this.issueRequestRec?.Sales_Issue_Return_To_Cst_Address__c && this.RTCAddrsMap.get(this.issueRequestRec?.Sales_Issue_Return_To_Cst_Address__c) && !event) {
                        this.returnToCustAddrsValue = this.issueRequestRec?.Sales_Issue_Return_To_Cst_Address__c;
                    }
                    if (this.returnToCustAddressOptions.length === 1) {
                        this.returnToCustAddrsValue = this.returnToCustAddressOptions[0].value;
                    }
                }
            } else if (this.returnToCustAddressOptions.length === 0) {
                this.showToast(this.labels.Error_Title, this.labels.Return_To_Customer_Address_Not_Found, 'error', 'dismissable');
            }
            if (this.returnToCustAddrsValue) {
                this.handleReturnToCustAddress(event);//added event TWC4621-1009 to cover edit scenario
            }
        } else {
            this.showToast(this.labels.Error_Title, this.labels.Return_To_Customer_Address_Not_Found, 'error', 'dismissable');
        }
        let addnewoption = {
            label: this.labels.add_edit_delete_address_combobox_option,
            value: "addnewaddress"
        };
        this.returnToCustAddressOptions.push(addnewoption);
        //this.template.querySelector('c-r4c_-a-g_-reusable-lookup[data-name="Sales_Issue_Return_To_Cst_Address__c"]').options = this.returnToCustAddressOptions;
        this.template.querySelector('c-r4c_-a-g_-reusable-lookup[data-name="Sales_Issue_Return_To_Cst_Address__c"]')?.physicalAddressOptions(this.returnToCustAddrsValue, this.returnToCustAddressOptions, 'Sales_Issue_Return_To_Cst_Address__c', this.isCollectionAddressTrue);//TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address
        //E2C
        if (this.returnRequest && !this.returnRequest.Sales_Issue_Freight_Payment_Type__c && this.returnRequest?.Sales_Issue_Cst_Collection_Address__c) {
            this.setCollectionAddrsOptions(event);
        }
        if (this.returnRequest && !this.returnRequest.Sales_Issue_Freight_Payment_Type__c && this.returnRequest.Sales_Issue_Collection_Date__c) {
            this.template.querySelector('c-r4c_-a-g_-collection-date').renderCollectionDate(this.selectedDate);
        }
        //E2C
    }
