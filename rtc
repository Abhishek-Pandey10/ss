public with sharing class R4C_CollectionDetails_Util {
    
    
    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* this method is used for getting Geo Location based on the salesorg ids
*@Story: TWC4621-50
*@Modified Date: 28/08/2022
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
*@param: String : serviceType
* @return: List of Sales_Issue_SalesOrg_To_Geo_Map__c records
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/   
    public static List<Sales_Issue_SalesOrg_To_Geo_Map__c> getGeoLocationBySalesOrgId(List<String> saleOrgId) {
        List<Sales_Issue_SalesOrg_To_Geo_Map__c> salesOrgGeoList = new List<Sales_Issue_SalesOrg_To_Geo_Map__c>();
        if(saleOrgId!=null && !saleOrgId.isEmpty()) {
            String query = 'SELECT Id , Location_Geography__c , Location_Geography__r.Name ,'+
                ' Sales_Issue_Sales_Organization__c , Sales_Issue_Sales_Organization__r.Name '+
                ' From Sales_Issue_SalesOrg_To_Geo_Map__c';
            query += ' Where Sales_Issue_Sales_Organization__c IN :saleOrgId WITH USER_MODE';
            salesOrgGeoList = Database.query(query);
        }     
        return salesOrgGeoList;
    }
    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Method for Freight Type Determination from Matrix Object
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* Param 1 - Remedy as String from Shipping Details LWC
* Param 2 - Return Reason as String from Shipping Details LWC
* Param 3 - Service Type as String from Case Creation LWC
* Param 4 - Gealocation as String Shipping Details Controller
* @return: List of Sales_Issue_Matrix__c records
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/  
    public static List<Sales_Issue_Matrix__c> freightTypeBasedonGeo(CollectionDetailsWrapper colReqWrapper, Id rTCAddrsCountryId, String searchGeo) {
        List<Sales_Issue_Matrix__c> filteredFrieghts = new List<Sales_Issue_Matrix__c>();
        try {
            if(String.isNotBlank(colReqWrapper.remedy)  && String.isNotBlank(colReqWrapper.servicetype) && String.isNotBlank(searchGeo)) {
                //TWC4621-1683 - adding support for Sales Issue Freight Determination Matrix	
                String ruleRequest='{';
                ruleRequest+='"Sales_Issue_Remedy_Type__c":"'+colReqWrapper.remedy+'",';
                ruleRequest+='"Sales_Issue_Service_Type__c":"'+colReqWrapper.servicetype+'",';
                ruleRequest+='"Location_Geography__c":"'+searchGeo+'",';
                ruleRequest+='"Sales_Issue_Customer_Return_Reason__c":"'+colReqWrapper.returnreason+'",';
                ruleRequest+='"Location_Country__c":"'+rTCAddrsCountryId+'"';
                ruleRequest+='}';
                filteredFrieghts = R4C_BusinessRule_Service.getRule('Sales_Issue_Freight_Determination_Matrix',ruleRequest);
            }
        }
        catch(DmlException e) {
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_CollectionDetails_Util.fetchFreightType',e.getMessage(),e,True);
        }   
        return filteredFrieghts ;
    }
    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Method to filter the sales issue Matrix records on certain conditions
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
*Param 1 - countryid as id , sales issue matrix records as list ,CollectionDetailsWrapper
* @return: List of Sales_Issue_Matrix__c records
* 23/02/2023 -- Accellor -- TWC4621-1009 & TWC4621-1015
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/  
    public static List<Sales_Issue_Matrix__c> filterMatrixRecords(List<Sales_Issue_Matrix__c> salesIssueMatrix,CollectionDetailsWrapper colReqWrapper, Id countryId) {
        List<Sales_Issue_Matrix__c> filteredMatrixlst = new List<Sales_Issue_Matrix__c>();
        for(Sales_Issue_Matrix__c matrixRec : salesIssueMatrix) { //salesIssueMatrix contains matrix records based on the filter remedy , servicetype and Geo
            if(matrixRec.Location_Country__c == countryId && matrixRec.Sales_Issue_Customer_Return_Reason__c == colReqWrapper.returnreason) {  //checking additional filter(return reason and country)
                filteredMatrixlst.add(matrixRec);
            }
        }
        if(filteredMatrixlst.isEmpty()) { // If no records found in above scenario excluding country field
            filteredMatrixlst = filterMatrixRecordsHelper(salesIssueMatrix,colReqWrapper.returnreason,'');//splitting the logic into another method due to cyclometic issues
        }
        if(filteredMatrixlst.isEmpty()) {
            filteredMatrixlst = filterMatrixRecordsHelper(salesIssueMatrix,'',countryId);//splitting the logic into another method due to cyclometic issues
        }
        if(filteredMatrixlst.isEmpty()) {
            filteredMatrixlst = salesIssueMatrix;//salesIssueMatrix contains matrix records based on the filter remedy , servicetype and Geo
        }
        return filteredMatrixlst;
    }
    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* helper Method to filter the sales issue Matrix records on certain conditions
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
*Param 1 - countryid as id , sales issue matrix records as list ,CollectionDetailsWrapper
* @return: List of Sales_Issue_Matrix__c records
* 23/02/2023 -- Accellor -- TWC4621-1009 & TWC4621-1015
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/  
    public static List<Sales_Issue_Matrix__c> filterMatrixRecordsHelper(List<Sales_Issue_Matrix__c> salesIssueMatrix,String returnReason , String countryId) {
        final List<Sales_Issue_Matrix__c> filteredMatrixlst = new List<Sales_Issue_Matrix__c>();
        if(String.isEmpty(returnReason)) {
            for(Sales_Issue_Matrix__c matrixRec : salesIssueMatrix) {
                if(matrixRec.Sales_Issue_Customer_Return_Reason__c == returnReason && matrixRec.Location_Country__c==null) { //checking additional filter (return reason)
                    filteredMatrixlst.add(matrixRec);
                }
            }
        }
        else {
            for(Sales_Issue_Matrix__c matrixRec : salesIssueMatrix) {  //salesIssueMatrix contains matrix records based on the filter remedy , servicetype and Geo
                if(matrixRec.Location_Country__c == countryId) { //checking additional filter (country)
                    filteredMatrixlst.add(matrixRec);
                }
            }
        }
        return filteredMatrixlst;
    }
    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Method to fetching Collection/Return To Customer Address from Customer Physical Address
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
*Param 1 - Customer CMF ID(Sold To) as String name change for Searchkey
* @return: List of Customer_Physical_Address__c records
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/  
    public static List<Customer_Physical_Address__c> getCollectionAddress(string searchKey) { 
        List<Customer_Physical_Address__c> addlist = new List<Customer_Physical_Address__c>(); 
        try {
            if(String.isNotBlank(searchKey)) {            
                final Set<String> collectionAddress = new Set<String>{'Collection','Return To Customer'};
                    
                    String query = 'SELECT  Id, Name , Address_Type__c, Customer_Physical_Address_Line1__c, Customer_Physical_Address_Line2__c , Customer_City_Name__c, Customer_Postal_Code__c,Customer_Physical_Address_State__c,';
                query+=' Customer_Price_Mask__c,Customer_Physical_Address_State__r.Name,Customer_Physical_Address_State__r.Time_Zone_Name__c,Customer_Physical_Address_State__r.Time_Zone_Code__c, Customer_Country__r.Time_Zone_Name__c,Customer_Country__r.Time_Zone_Code__c,Customer_Country__r.Name, Customer_Country__r.Location_Two_Digit_Country_Code__c, Customer_Country__r.Location_Geography__c, Customer_Country__r.Location_Geography__r.Name';
                query+=' FROM Customer_Physical_Address__c';
                query+=' WHERE Customer_CMF__c =: searchKey';
                query+=' AND Address_Type__c IN : collectionAddress';
                query+=' AND Customer_Active_Indicator__c= true';
                query+=' WITH USER_MODE';
                addlist = Database.query(query);
            }
        }
        catch(DMLException e) {
            R4C_AG_ErrorRecordHandler.errorRecord_Method('R4C_CollectionDetails_Util.getCollectionAddress',e.getMessage(),e,True);
        }        
        return addlist;
    }
    /*   Pravallika - method to get china country */
    
    @AuraEnabled(cacheable=true)
    public static String getCountryForAddress(Id addressId) {
        Customer_Physical_Address__c address = [SELECT Customer_Country__r.Name FROM Customer_Physical_Address__c WHERE Id = :addressId LIMIT 1];
