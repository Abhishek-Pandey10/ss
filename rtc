    /*Start -- handler method on change of RTC address value*/
    handleReturnToCustAddress(event, isAddEditOption) {
        if (event && event.detail === "addnewaddress") { //updated event.detail.value to event.detail as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address
            let datawrapper;
            this.openNewAdd = true;
            if (event?.target?.dataset?.name === this.genericMessages.Sales_Issue_Return_To_Cst_Address__c) {
                datawrapper = {
                    cmfid: this.ShippingDetails.Sales_Issue_SoldTo_Customer__c,
                    addresslist: this.collectionDetailsData.RTCAddrs,
                    addtype: event.target.dataset.name,
                    previousvalue: this.returnToCustAddrsValue == undefined ? '' : this.returnToCustAddrsValue,//TWC4621-1009 -- Accellor -- 23rd feb 2023 -- storing the RTC address value to retain if the user clicks cancel
                    rtcGeoValue: undefined //Geo filter changes
                }
            }
            this.template.querySelector('c-r4c_-a-g_-add-edit-delete-address').getadddata(datawrapper);
        } else {
            if (event && event?.target?.dataset?.name === this.genericMessages.Sales_Issue_Return_To_Cst_Address__c) {
                if (!this.isSubmitted) {/*Bindhu--TWC4621-1097,TWC4621-1090--To restrict clearing of the collection details fields based on the RMA status*/
                    this.clear(event);//TWC4621-1009 -- Accellor -- 23rd feb 2023 -- clearing the field and options value once RTC address value has changed
                    this.template.querySelector('c-r4c_-a-g_-reusable-lookup[data-name="Sales_Issue_Cst_Collection_Address__c"]')?.physicalAddressOptions(this.CollectionAddrsValue, [], 'Sales_Issue_Cst_Collection_Address__c', this.isCollectionAddressTrue);//updated options as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address
                }
                /*Start--Bindhu--TWC4621-1097,TWC4621-1090--To clear the RTC contact on change of RTC address based on RMA status*/
                if (this.isSubmitted) {
                    this.RTCAddrsConOptions = [];
                    this.RTCAddrsConValue = '';
                }
                /*End--Bindhu--TWC4621-1097,TWC4621-1090--To clear the RTC contact on change of RTC address based on RMA status*/
                this.returnToCustAddrsValue = event.detail;//updated event.detail.value to event.detail as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address
            }
            let RTCaddrscondata;
            if (this.returnToCustAddrsValue) {
                this.isConsentRequired = this.RTCAddrsMap.get(this.returnToCustAddrsValue)?.Customer_Country__r?.Name == 'China'? true : false;
                
                console.log('########country name'+this.RTCAddrsMap.get(this.returnToCustAddrsValue)?.Customer_Country__r?.Name);
                this.rtcCountryGeo = this.RTCAddrsMap.get(this.returnToCustAddrsValue)?.Customer_Country__r?.Location_Geography__r?.Name; //Geo filter changes
                this.rtcAddressCountryName = this.RTCAddrsMap.get(this.returnToCustAddrsValue)?.Customer_Country__r?.Name;

                RTCaddrscondata = this.collectionDetailsData.addressConMap[this.returnToCustAddrsValue];
            }

            this.RTCAddrsConOptions = [];
            if (RTCaddrscondata !== undefined) {
                let options = [];
                let RTCConMap = new Map();
                RTCaddrscondata.map(rec => {
                    if (rec.Name) {
                        const option = {
                            'label': (rec?.Customer_LastName__c) ? `${rec.Customer_LastName__c}, ${rec.Name}` : `${rec.Name}`,//rec.Email__c,
                            'value': rec.Id
                        }
                        options.push(option);
                        RTCConMap.set(rec.Id, rec);
                    }
                })
                this.RTCAddrsConOptions = options;
                if (this.RTCAddrsConOptions.length === 1 || (this.isEdit && this.returnRequest?.Sales_Issue_Return_To_Cst_Contact__c && !event) || this.issueRequestRec != undefined) {
                    if (this.isEdit) { //Bindhu
                        this.RTCAddrsConValue = !event ? this.returnRequest?.Sales_Issue_Return_To_Cst_Contact__c : this.RTCAddrsConOptions[0]?.value;
                    } else if (!this.isEdit) {
                        if (this.issueRequestRec?.Sales_Issue_Return_To_Cst_Contact__c && RTCConMap.get(this.issueRequestRec?.Sales_Issue_Return_To_Cst_Contact__c) && !event) {
                            this.RTCAddrsConValue = this.issueRequestRec?.Sales_Issue_Return_To_Cst_Contact__c;
                        }
                        if (this.RTCAddrsConOptions.length === 1) {
                            this.RTCAddrsConValue = this.RTCAddrsConOptions[0]?.value;
                        }
                    }
                } else if (this.RTCAddrsConOptions.length === 0) {
                    this.showToast(this.labels.Error_Title, this.labels.No_Return_to_Customer_Contact_Found, 'error', 'dismissable');
                }
                this.handleRTCContact();
            } else if (this.returnToCustAddrsValue) { //added condition as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address

                this.showToast(this.labels.Error_Title, this.labels.No_Return_to_Customer_Contact_Found, 'error', 'dismissable');
            }
            let addnewoption = {
                label: this.labels.add_edit_delete_contact_combobox_option,
                value: "addnewcont"
            };
            if (this.returnToCustAddrsValue) { //added condition as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address
            this.RTCAddrsConOptions.push(addnewoption);
            }

            // Start -- TWC4621-1009 -- Accellor -- 23rd feb 2023 -- based on the selection of RTC Address value fetching freightType data from apex
            if (isAddEditOption === undefined && this.returnToCustAddrsValue) { //added returnToCustAddrsValue condition as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address
                this.isLoading = true;
                let RTCAddrsCountryId = this.RTCAddrsMap.get(this.returnToCustAddrsValue)?.Customer_Country__c;
                getFreightTypeData({ CollectionReqWrapper: this.collectionWrapper, RTCAddrsCountryId: RTCAddrsCountryId })
