// import ActivityNotPerformedLWC from '@salesforce/apex/ActivityNotPerformedLWC.search';
import { api, LightningElement, track } from 'lwc';
import r4c_CustomLabels from 'c/r4c_CustomLabels';// Importing custom labels
import getCustomerCMF from '@salesforce/apex/R4C_SR_Allowance_BulkUploadCtrl.getCustomerCMF';
import { ShowToastEvent } from "lightning/platformShowToastEvent";

export default class R4c_AG_ReusableLookup extends LightningElement {
    hoverClass = 'slds-lookup__item-action:hover';

    @api iconName = 'standard:account';
    @api filter = '';
    @api searchPlaceholder = 'Select One';
    @track selectedName;
    @track records;
    @track isValueSelected;
    @track blurTimeout;
    @api searchTerm;
    @track boxClass = 'slds-combobox slds-dropdown-trigger slds-dropdown-trigger_click slds-has-focus';
    @track inputClass = '';
    @track searchOptions = []
    @track filterOptionsData = [];
    @api disabled;
    @api label;
    @api preloadvalue;
    //adding 2 new attributes to controls label
    @api isNotRequired = false;
    get isRequired() {
        return !this.isNotRequired;
    }
    @api isLabelHidden = false;
    @api isSrAllowanceScreen = false; //SR Allowance Override
    @api srAllowanceSalesAreaFilterCodeList = [];
    get formElementClass() {
        return this.isLabelHidden || (this.label == 'Country/Region' || this.label == 'State/Province') ? 'slds-form-element' : 'slds-form-element slds-form-element_horizontal';
    }
    labels = r4c_CustomLabels.labels;//Assigning custom labels to variable
    //Start -----fetch value from the headers- User Story Number TWC4621-979,990--- Tushar Garg
    @api
    get options() {
        return this.searchOptions;
    }
    set options(value) {
        this.searchOptions = value?.map(i => {
           // i.recordId = i?.recordId || '';//TWC4621-4740 -- Added as part of ILM Approver selection
            let x = { ...i };
            x.class = 'record-list';
            return x;
        });
    }
    //End -----fetch value from the headers- User Story Number TWC4621-979,990--- Tushar Garg
    @api repairSiteOptions(siteValue, siteOptions) {
        if (siteValue && siteOptions) {
            this.searchOptions = siteOptions;
            this.preloadvalue = siteValue;
            this.updateSearchOptions();
        }
    }
    //added new functions for physicalAddress options as part of TWC4621-5005 -- CR - Allow Search Function for RTC & Collection address
    @api physicalAddressOptions(addressValue, addressOptions, addressType, isCollectionAddrsReq) {
        if (addressOptions) {
            this.searchOptions = addressOptions?.map(i => {
                let x = { ...i };
                x.class = 'record-list';
                return x;
            });
        }
        this.preloadvalue = addressValue;
        if (addressType == 'Sales_Issue_Cst_Collection_Address__c') {
            //hardcoded have to make it such that it is 
            this.isNotRequired = !isCollectionAddrsReq;
            if(addressOptions?.length == 0) {
                this.searchTerm = '';
            }
        }
        if (addressValue) {
            this.updateSearchOptions();
        }
        else {
            this.selectedName = '';
            this.isValueSelected = false;
        }
    }
    connectedCallback() {
        this.updateSearchOptions();
    }
    updateSearchOptions() {
        if (this.preloadvalue) {// Sandeep Nagasamudram -- "Ship to" dropdown can produce very long lists. Adding the same functionality as "Sold to" where user can search
            this.searchOptions.forEach(currentItem => {
                if (currentItem.value === this.preloadvalue) {
                    let selectedId = currentItem.value;
                    let selectedName = currentItem.label;
                    this.isValueSelected = this.disabled == true ? false : true;
                    this.selectedName = selectedName;
                    if (this.blurTimeout) {
                        clearTimeout(this.blurTimeout);
                    }
                    this.boxClass = 'slds-combobox slds-dropdown-trigger slds-dropdown-trigger_click slds-has-focus';
                }
            });

        }
    }

    //Start -----Display options based on filters- User Story Number TWC4621-979,990--- Tushar Garg
    get displayOptions() {
        return this.filterOptionsData.length > 0 ? this.filterOptionsData : [];
    }
    //End -----Display options based on filters- User Story Number TWC4621-979,990--- Tushar Garg
    //Start -----Check length of the Search Result- User Story Number TWC4621-979,990--- Tushar Garg
    get ifDisplayOptions() {
        return this.filterOptionsData.length > 0 ? true : false;
    }

    handleInputEvent(event) {
        // Open dropdown on enter or spacebar 
        if (event.keyCode === 13 && this.isSrAllowanceScreen) {
            this.getCMFRecords();
        }
        else if (event.keyCode === 13 && !this.boxClass.includes('slds-is-open')) {
            this.handleClick();
        }
        else if (event.keyCode === 13) {
            const currentIndex = this.filterOptionsData.findIndex(i => i.class.includes('record-selection'));
            if (currentIndex !== -1) {
                const ele = this.filterOptionsData[currentIndex];
                const event = {
                    currentTarget: {
                        dataset: {
                            id: ele.value,
                            name: ele.label
                            
                        }
                    }
                }
                this.onSelect(event);
            }
        }

        // Close on escape
        if (event.keyCode === 27) {
            this.onBlur();
        }

        // Up/down arrows to navigate options
        if (event.keyCode === 40 && this.boxClass.includes('slds-is-open')) {
            this.onArrowSelection(false);
        }
        else if (event.keyCode === 38 && this.boxClass.includes('slds-is-open')) {
            this.onArrowSelection(true);
        }

        //on search if drop down is not open
        if (event.keyCode >= 48 && event.keyCode <= 57 && !this.boxClass.includes('slds-is-open')) {
            this.handleClick();
        }
        if (event.keyCode >= 65 && event.keyCode <= 90 && !this.boxClass.includes('slds-is-open')) {
            this.handleClick();
        }

    }

    //End -----Check length of the Search Result- User Story Number TWC4621-979,990--- Tushar Garg
    //Start -----This Method fire when we click on the input- User Story Number TWC4621-979,990--- Tushar Garg
    handleClick() {
        if (!this.disabled) {
            this.filterOptionsData = this.searchOptions;
            this.searchTerm = '';
            this.inputClass = 'slds-has-focus';
            this.boxClass = 'slds-combobox slds-dropdown-trigger slds-dropdown-trigger_click slds-has-focus slds-is-open';
        }
    }
    //End -----This Method fire when we click on the input- User Story Number TWC4621-979,990--- Tushar Garg
    //Start -----This Method fire when we blur the input-- User Story Number TWC4621-979,990--- Tushar Garg
    onBlur() {
        this.onRecordleave();
        // eslint-disable-next-line @lwc/lwc/no-async-operation
        this.blurTimeout = setTimeout(() => { this.boxClass = 'slds-combobox slds-dropdown-trigger slds-dropdown-trigger_click slds-has-focus' }, 300);
    }
    //End -----This Method fire when we blur the input-- User Story Number TWC4621-979,990--- Tushar Garg
    //Start -----This Method fire when user select any search input--- User Story Number TWC4621-979,990--- Tushar Garg
    onSelect(event) {
        let selectedId = event.currentTarget.dataset.id;
        let selectedName = event.currentTarget.dataset.name;
       
        const valueSelectedEvent = new CustomEvent('lookupselected', { detail: selectedId });
        //adding for more details event
        const valueonSelectedEvent = new CustomEvent('select', {
            detail: {
                value: selectedId,
                label: selectedName,
                fieldLabel: this.label

            }
        });
        this.dispatchEvent(valueonSelectedEvent);

        this.dispatchEvent(valueSelectedEvent);
        this.isValueSelected = true;
        this.selectedName = selectedName;
        if (this.blurTimeout) {
            clearTimeout(this.blurTimeout);
        }
        this.boxClass = 'slds-combobox slds-dropdown-trigger slds-dropdown-trigger_click slds-has-focus';
    }
    //End -----This Method fire when user select any search input--- User Story Number TWC4621-979,990--- Tushar Garg
    //Start -----This Method User for removing the Search Value--- User Story Number TWC4621-979,990--- Tushar Garg
    @api handleRemovePill() {
        this.isValueSelected = false;
        const removeSoldTo = new CustomEvent('lookupselected', { detail: '' });
        const removeSelectedSoldTo = new CustomEvent('select', {
            detail: {
                value: '',
                label: '',
                fieldLabel: this.label
            }
        });
        this.searchTerm = '';
        this.dispatchEvent(removeSoldTo);
        this.dispatchEvent(removeSelectedSoldTo);
        this.dispatchEvent(new CustomEvent('lookupdeselect', { detail: '' }));
    }
    //End -----This Method User for removing the Search Value--- User Story Number TWC4621-979,990--- Tushar Garg
    //Start -----This  method filter out the search Records based on Search--- User Story Number TWC4621-979,990--- Tushar Garg
    onChange(event) {
        this.searchTerm = event.target.value;
        this.filterOptionsData = this.searchOptions.filter((SearchResult) => { return SearchResult.label.toLocaleLowerCase().includes(this.searchTerm.toLocaleLowerCase()) });
    }
    //End -----This  method filter out the search Records based on Search--- User Story Number TWC4621-979,990--- Tushar Garg


    onArrowSelection(isUp) {

        let currentIndex = this.filterOptionsData.findIndex(i => i.class.includes('record-selection'));

        if (currentIndex !== -1) {
            if (isUp && currentIndex >= 1) {
                currentIndex--;
            }
            else if (!isUp && currentIndex + 1 <= this.filterOptionsData.length - 1) {
                currentIndex++;
            }
        }
        else {
            currentIndex = 0;
        }
        const ele = this.filterOptionsData[currentIndex];
        const event = {
            currentTarget: {
                dataset: {
                    id: ele.value,
                    name: ele.label
                }
            }
        }
        this.onRecordHover(event);
    }

    onRecordHover(event) {
        let selectedId = event.currentTarget.dataset.id;
        let selectedName = event.currentTarget.dataset.name;


        for (let i = 0; i < this.filterOptionsData.length; i++) {
            this.filterOptionsData[i].class = 'record-list';
            if (this.filterOptionsData[i].value == selectedId) {
                this.filterOptionsData[i].class = 'record-list record-selection';
            }
        }
    }
    onRecordleave() {

        for (let i = 0; i < this.filterOptionsData.length; i++) {
            if (this.filterOptionsData[i].class.includes('record-selection')) {
                this.filterOptionsData[i].class = 'record-list';
            }

        }
    }

    //SR Allowance Override
    isLoading = false;
    getCMFRecords() {
        let soldTos = [];
        if (this.isSrAllowanceScreen && this.searchTerm?.trim()?.length > 2) {
            this.isLoading = true;
            getCustomerCMF({ searchText: this.searchTerm })
                .then((result) => {
                     if (result?.errorMessage) {
                        throw new Error(result.errorMessage);
                    }
                    result.cmfList.forEach((cmf) => {
                        let salesArea = cmf?.Customer_Sales_Areas__r;
                        let filteredSalesArea = salesArea?.filter(i => this.srAllowanceSalesAreaFilterCodeList.includes(i?.Customer_Disti_Channel__r?.Customer_Distribution_Channel_Code__c));

                        if (filteredSalesArea?.length > 0 || this.srAllowanceSalesAreaFilterCodeList.length == 0) {
                            soldTos.push({
                                label: cmf.Name + ' - ' + cmf.Customer_Name__c,
                                value: cmf.Id,
                                'class': 'record-list'
                            })
                        }
                    })
                    this.searchOptions = soldTos;
                    this.isLoading = false;
                    this.handleClick();
                }).catch((e) => {
                    this.showToast(this?.labels?.Error_Title, this?.labels?.generic_error_msg, "error"); //Added as part of Failure Handling - TWC4621-3040
                });
        }
    }


    //Creating a Toast event to display the error message
    showToast(title, message, variant) {
        const evt = new ShowToastEvent({
            title: title,
            message: message,
            variant: variant
        });
        this.dispatchEvent(evt);
    }
}


