    /**
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
* Method for getting Holiday list from calender API
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
* @param: Country Name as String
* @return:  R4C_CollectionDetails_Util.CalendarHolidayOutput
* ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
*/    
    @AuraEnabled
    public Static R4C_CollectionDetails_Util.CalendarHolidayOutput getHolidayList(String countryCde) {
        R4C_CollectionDetails_Util.CalendarHolidayOutput  r4cwrapcalender = new R4C_CollectionDetails_Util.CalendarHolidayOutput();
        try{
            List<Location_Country__c> countryCodeList = R4C_CollectionDetails_Util.getCountryCode(countryCde);
            R4C_CalendarHoliday_Consuming_Class.CalendarHolidayOutput r4cCalender = new R4C_CalendarHoliday_Consuming_Class.CalendarHolidayOutput();
            list<Date>  newHolidaylist = new list<Date>();
            if(String.isNotBlank(countryCde)) {
                r4cCalender = R4C_CalendarHoliday_Consuming_Class.getHolidays(countryCodeList[0].Location_Two_Digit_Country_Code__c);
                Map<Integer,list<Date>>  dateMap = new Map<Integer,list<Date>>(); 
                if(r4cCalender != null) {
                    dateMap = (Map<Integer,list<Date>>) r4cCalender.responseData;    
                }
                if(dateMap!=null && dateMap.size() > 0) {
                    for(Integer eInt : dateMap.keySet()) {
                        newHolidaylist.addAll(dateMap.get(eInt));
                    }      
                }
                r4cwrapcalender.isSuccess = r4cCalender.isSuccess;
                r4cwrapcalender.errorMessage = r4cCalender.errorMessage;
                r4cwrapcalender.statusCode = r4cCalender.statusCode;
                r4cwrapcalender.responseData = dateMap;
                r4cwrapcalender.holidayList = newHolidaylist;
            }
        }
        catch(Exception ex) {
            r4cwrapcalender.isSuccess = FALSE;
            final R4C_ErrorRecordServiceWrapperClass recordData = new R4C_ErrorRecordServiceWrapperClass();
            recordData.exce = ex;
            recordData.type = 'Integration/API error';
            final R4C_ErrorRecordService records = new R4C_ErrorRecordService();
            records.insertErrorRecord(recordData);
        }
        return r4cwrapcalender;
    }
