                        console.log('getFreightTypeData result ', data);
                        this.isLoading = false;
                        if (data?.errorMessage) {
                            throw new Error(data.errorMessage);
                        }
                        this.freightTypeData = data;
			            //Filter Records from the list to match the criteria
                        if (this.freightTypeData?.geoLocationlst?.length > 0) {
                            this.collectionWrapper.geoLocation = this.freightTypeData?.geoLocationlst[0].Location_Geography__c;
                        }
                        // this.freightTypeData.freightTypeGeolst = this.freightTypeData?.freightTypeGeolst.filter(record =>
                        //     (record?.Sales_Issue_Service_Type__c === this.collectionWrapper.serviceType || record?.Sales_Issue_Service_Type__c === undefined) &&
                        //     (record?.Sales_Issue_Remedy_Type__c === this.collectionWrapper.remedy || record?.Sales_Issue_Remedy_Type__c === undefined) &&
                        //     (record?.Sales_Issue_Customer_Return_Reason__c === this.collectionWrapper.returnreason || record?.Sales_Issue_Customer_Return_Reason__c === undefined) &&
                        //     (record?.Location_Country__c === RTCAddrsCountryId || record?.Location_Country__c === undefined) &&
                        //     (record?.Location_Geography__c === this.collectionWrapper.geoLocation || record?.Location_Geography__c === undefined)
                        // )
                        console.log('freightTypeGeolst ',JSON.stringify(this.freightTypeData.freightTypeGeolst))
                        if (this.freightTypeData.freightTypeslst) {
                            this.freightTypeData.freightTypeslst.forEach((element) => {
                                this.freightypesMap.set(element.Name, element.Id);
                            });
                        }
                        /*Start--Bindhu--TWC4621-1097,TWC4621-1090--restricting the field changes on RTC address changes based on RMA status*/
                        if (!event || (event && !this.isSubmitted)) {
                            if (this.caseType.isExceptionRepair()) {
                                this.setFreightTypeOptionsForRepair(event);
                            } else {
                                this.setFreightTypeOptions(event);
