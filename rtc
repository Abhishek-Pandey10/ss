        }
        return 'Not found'
    }

    /* preparing the option from address record to show in the UI*/
    getAddressRecord(record) {
        let Addressrec = '';
        if (record) {
            if (record.Name !== undefined && record.Name !== '') { //TWC4621-5005 -- added Physical Address Care Of Name to display in the UI
                Addressrec = Addressrec + record.Name + ',';
            }
            if (record.Customer_Physical_Address_Line1__c !== undefined && record.Customer_Physical_Address_Line1__c !== '') {
                Addressrec = Addressrec + record.Customer_Physical_Address_Line1__c + ',';
            }
            if (record.Customer_City_Name__c !== undefined && record.Customer_City_Name__c !== '') {
                Addressrec = Addressrec + record.Customer_City_Name__c + ',';
            }
            if (record.Customer_District_Name__c !== undefined && record.Customer_District_Name__c !== '') {
                Addressrec = Addressrec + record.Customer_District_Name__c + ',';
            }
            if (record.Customer_Physical_Address_State__c !== undefined && record.Customer_Physical_Address_State__c !== '') {
                Addressrec = Addressrec + record.Customer_Physical_Address_State__r?.Name + ',';
            }
            if (record.Customer_Country__r !== undefined) {
                Addressrec = Addressrec + record.Customer_Country__r?.Name + ',';
            }
            if (record.Customer_Postal_Code__c !== undefined && record.Customer_Postal_Code__c !== '') {
                Addressrec = Addressrec + record.Customer_Postal_Code__c + ',';
            }
        }
        if (Addressrec !== '') {
            Addressrec = Addressrec.substring(0, Addressrec.length - 1);
        }
        return Addressrec;
    }
